		width: 15px;
    	height: 15px;
    	padding: 15px;
	}

	.dipi-footer-menu-social-icons a .dipi-icon svg {
		fill: #2c3d49;
		transition: all .4s ease-in-out;
	}

	.dipi-footer-menu-social-icons a .dipi-icon {
		width: 100%;
		height: 100%;
		overflow: hidden;
		display: grid;
	}

	.dipi-footer-menu-social-icons .dipi-social-icon:hover .dipi-icon svg {
