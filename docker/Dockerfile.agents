# boucle agents image
#
# Image for boucle control-plane jobs (dispatch / merger / post-merge /
# catchup / doctor) AND agent jobs (triage / worker / reviewer / e2e)
# that run on docker-based runners (tags: [] fallback like the shared
# Framasoft runner). Pre-bakes the full toolchain so the before_script
# does not download node / glab / jcode / codebase-memory-mcp on every
# run (docker runners persist nothing between runs).
#
# Toolchain mirror of the global before_script in .gitlab-ci.yml:
#   - node 22 (base image)          — build/deploy/preview jobs
#   - python3 (stdlib only)         — ui-ux-pro-max search.py (worker design skill)
#   - curl, jq, git, ca-certificates
#   - glab 1.50.0                   — GitLab CLI (API calls)
#   - jcode v0.73.0                 — agent runtime (Rust binary, replaces opencode/pi)
#   - codebase-memory-mcp           — knowledge-graph MCP server
#   - mermaid + jsdom               — bin/check-mermaid (diagram syntax gate)
#
# NOTE: lib/boucle.sh is sourced from ${CI_PROJECT_DIR} at job runtime,
# it is NOT baked into the image (it ships with each consumer repo).

FROM node:22-slim

# apt: curl, jq, git, python3 (stdlib only — ui-ux-pro-max search.py)
#      chromium — the distribution's own build, used by bin/render-preview for
#      the triage preview and the worker's screenshots. Baking it in is what
#      lets those steps download nothing at job time; the previous
#      @sparticuz/chromium pulled 103 MB from npm and extracted 191 MB into
#      /tmp on every job, for an AWS-Lambda build of a browser Debian already
#      packages.
#      fonts — a Chromium without them renders every glyph as a box, which
#      would silently ruin the screenshot the human approves the spec on.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        python3 \
        chromium \
        fonts-dejavu-core \
        fonts-liberation2 \
        fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# glab — GitLab CLI
ARG GLAB_VERSION=1.50.0
RUN curl -fsSL "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_amd64.tar.gz" -o /tmp/glab.tar.gz \
    && tar -xzf /tmp/glab.tar.gz -C /tmp \
    && cp /tmp/bin/glab /usr/local/bin/glab \
    && chmod +x /usr/local/bin/glab \
    && rm -rf /tmp/glab.tar.gz /tmp/bin

# jcode — agent runtime (standalone Rust binary, no node dependency)
ARG JCODE_VERSION=v0.73.0
RUN curl -fsSL "https://github.com/1jehuang/jcode/releases/download/${JCODE_VERSION}/jcode-linux-x86_64.tar.gz" -o /tmp/jcode.tar.gz \
    && tar -xzf /tmp/jcode.tar.gz -C /tmp \
    && mv /tmp/jcode-linux-x86_64.bin /usr/local/bin/jcode \
    && chmod +x /usr/local/bin/jcode \
    && rm -f /tmp/jcode.tar.gz

# codebase-memory-mcp — knowledge-graph MCP server (installer copies a static binary)
RUN curl -fsSL https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/main/install.sh | bash \
    || echo "codebase-memory-mcp install failed (non-fatal, before_script retries)"

# Fail the build here, not at job time, if the browser is unusable. Debian
# bookworm has published chromium ahead of its libc++/libunwind runtime deps
# before (docker-library/python#991), which apt reports as unmet dependencies;
# `apt-get install` alone would also succeed for a package that cannot start.
# If this ever fires, the mitigations are, in order: rebuild once Debian's
# mirrors catch up, add the missing libc++ packages explicitly, or move the
# base image to node:22-trixie-slim (note: `node:22-slim` is bookworm-slim —
# both tags resolve to the same digest).
RUN chromium --version

# agent-browser — the CLI bin/render-preview drives against the Chromium above.
# Pinned: an unpinned install already bit us once, when @sparticuz/chromium
# moved its exports to ESM in a minor bump and `headless` silently became
# undefined.
ARG AGENT_BROWSER_VERSION=0.34.0
RUN npm install -g "agent-browser@${AGENT_BROWSER_VERSION}" \
    && agent-browser --version

# mermaid + jsdom — the parser bin/check-mermaid runs the spec's `## Diagram`
# section through (the diagram syntax gate). Baked in for the same reason as
# chromium above: without it every triage job that carries a diagram would
# npm-install ~180 MB before it could answer a yes/no question. jsdom is not
# optional — mermaid.parse() sanitizes labels through DOMPurify, which throws
# on every flowchart when there is no DOM, and the gate would then report
# every valid diagram as broken.
# Pinned: mermaid's grammar changes between minors, and an unpinned parser
# means the gate's verdict drifts under the loop without a commit. Keep these
# in sync with the defaults in bin/check-mermaid.
ARG MERMAID_VERSION=11.17.2
ARG JSDOM_VERSION=30.0.1
RUN npm install -g "mermaid@${MERMAID_VERSION}" "jsdom@${JSDOM_VERSION}"

# default env for all boucle jobs
ENV PATH="/usr/local/bin:${PATH}" \
    GLAB_NO_UPDATE_NOTIFIER="true" \
    AGENT_BROWSER_EXECUTABLE_PATH="/usr/bin/chromium" \
    AGENT_BROWSER_ARGS="--no-sandbox,--disable-dev-shm-usage"

WORKDIR /workspace
