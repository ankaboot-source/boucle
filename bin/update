#!/usr/bin/env bash
# shellcheck disable=SC2154,SC2250  # BOUCLE_FORGE, BOUCLE_PIPELINE_SOURCE are env vars set by CI.
# bin/update — boucle self-update: fetch latest from upstream and apply.
# Runs in the before_script of every CI job (after BOUCLE_HOME is resolved,
# before engine files are sourced). Fail-open: any error → warning + exit 0,
# pipeline continues with current version.
# Usage: bin/update [--dry-run]
# Self-update test: this comment exists to bump the engine SHA and verify
# that bin/update propagates the change to consumers automatically.
# Test 2: push auth fix is in place — the auto-update commit should now
# reach the consumer's remote master via BOUCLE_TOKEN.

# No -e: fail-open requires commands to fail individually without aborting the script.
set -uo pipefail

# ── Config ────────────────────────────────────────────────────────────
UPSTREAM_REPO="ankaboot-source/boucle"
UPSTREAM_API="https://api.github.com/repos/$UPSTREAM_REPO"
# Use the API tarball endpoint (redirects to codeload with a signed URL).
# The direct codeload.github.com URL 404s for some repos/branches — the API
# endpoint works for both public and private (with auth) repos.
UPSTREAM_TARBALL="$UPSTREAM_API/tarball"

# ── Engine directory detection ────────────────────────────────────────
# Detect the engine directory from this script's location.
# - Legacy/dogfood: bin/update at repo root → ENGINE_DIR="."
# - .boucle/ install: .boucle/bin/update → ENGINE_DIR=".boucle"
# This auto-detects the install model — no env var needed. The engine
# files (bin/, lib/, .jcode/, .gitlab-ci.yml, LOOP.md) are synced INTO
# ENGINE_DIR, not the consumer repo root.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
# Make ENGINE_DIR relative to CWD for cleaner git operations.
CWD="$(pwd)"
case "$ENGINE_DIR" in
  "$CWD") ENGINE_DIR="." ;;
  "$CWD"/*) ENGINE_DIR="${ENGINE_DIR#"$CWD"/}" ;;
esac

# ── Forge backend ─────────────────────────────────────────────────────
# bin/update runs in the before_script BEFORE lib/boucle-ci.sh sources the
# forge backend, so source it here to get forge_ci_var_set (used to record
# BOUCLE_VERSION in the forge Variable). Fail-open: if the backend is
# missing, forge_ci_var_set is a no-op and the sync still succeeds.
if [ -f "$ENGINE_DIR/bin/forge/common.sh" ]; then
  export BOUCLE_HOME="${BOUCLE_HOME:-$(cd "$ENGINE_DIR" && pwd)}"
  # shellcheck source=forge/common.sh
  . "$ENGINE_DIR/bin/forge/common.sh"
  forge_init 2> /dev/null || true
fi

# ── Submodule detection ───────────────────────────────────────────────
# When the engine is installed as a git submodule (.boucle/ is a gitlink
# in the parent repo), the parent cannot commit individual files inside
# .boucle/ — it can only update the submodule pointer. The tarball-based
# file replacement (download_and_extract) is useless here: the changes
# land inside the submodule working tree but the parent repo ignores them.
#
# Submodule mode: instead of extracting files, we update the submodule
# pointer to the upstream commit SHA and commit THAT in the parent repo.
# The next `git submodule update --recursive` (CI checkout) materializes
# the new engine files at the pinned commit.
is_submodule_install() {
  [ "$ENGINE_DIR" = "." ] && return 1
  # A submodule appears in the parent's index as mode 160000 (gitlink).
  git ls-files --stage "$ENGINE_DIR" 2> /dev/null | grep -q '160000' 2> /dev/null
}
SUBMODULE_MODE=""
if is_submodule_install; then
  SUBMODULE_MODE="1"
fi

# Forge-conditional SYNC_PATHS: sync the CI file that matches the active forge.
# bin/forge/ is always synced (it's under bin/). lib/ is always synced
# (lib/boucle-ci.sh + lib/boucle-ci/ live under lib/).
# .jcode/ is synced as a whole — the engine owns it entirely (agents/,
# skills/, UPSTREAM-FIX-WORKFLOW.md, DESIGN-template.md, prompt-overlay.md).
if [ "${BOUCLE_FORGE:-gitlab}" = "github" ]; then
  SYNC_PATHS="bin lib .jcode .github/workflows/boucle.yml LOOP.md"
else
  SYNC_PATHS="bin lib .jcode .gitlab-ci.yml LOOP.md"
fi

# ── Auth ──────────────────────────────────────────────────────────────
# curl_with_auth: curl wrapper that injects a GitHub token if available.
# The token is optional — public repos work without it. When set, it
# raises the rate limit and grants access to private repos.
curl_with_auth() {
  if [ -n "${GITHUB_TOKEN:-${GH_TOKEN:-}}" ]; then
    curl -fsSL -H "Authorization: Bearer ${GITHUB_TOKEN:-$GH_TOKEN}" "$@"
  else
    curl -fsSL "$@"
  fi
}

# configure_git_push: configure git remote with the bot token so bin/update
# can push the auto-update commit from a CI runner. The runner's default
# token (CI_JOB_TOKEN on GitLab, GITHUB_TOKEN on GitHub) may be pull-only, or
# may be barred from the branch by a protection rule — pushing needs the bot
# PAT (BOUCLE_TOKEN). No-op when BOUCLE_TOKEN is unset (local dev).
#
# The project path is read from BOUCLE_PROJECT_PATH, the forge-agnostic alias
# lib/boucle-ci.sh sets on both forges. Keying on CI_PROJECT_PATH alone made
# this a silent no-op on GitHub Actions, which never sets that GitLab-only
# variable: the push then went out under the workflow's own token instead of
# the configured PAT, and nothing said so. CI_PROJECT_PATH stays as a fallback
# for a GitLab job that runs bin/update without sourcing lib/boucle-ci.sh.
configure_git_push() {
  local project_path="${BOUCLE_PROJECT_PATH:-${CI_PROJECT_PATH:-}}"
  if [ -n "${BOUCLE_TOKEN:-}" ] && [ -n "${BOUCLE_FORGE_HOST:-}" ] && [ -n "$project_path" ]; then
    git remote set-url origin "https://${BOUCLE_BOT_USERNAME:-up-bot}:${BOUCLE_TOKEN}@${BOUCLE_FORGE_HOST}/${project_path}.git" 2> /dev/null
  fi
}

# push_update: push the auto-update commit, reporting why it failed.
#
# The push used to be `git push 2> /dev/null`, which made a consumer stuck one
# commit behind indistinguishable from one that was up to date: the reason was
# discarded, the job still exited 0, and the caller still printed
# "updated to <sha>" — so a repo frozen on an old engine looked healthy.
#
# Failure output is echoed with any embedded credential stripped:
# configure_git_push puts the bot PAT in the remote URL, and git quotes that
# URL back in most of its push errors. Redacting here is what makes surfacing
# the error safe.
#
# A protected default branch is called out separately: it is the one failure
# here that retrying can never clear, so promising a retry would be false.
#
# Returns 0 if the push succeeded, 1 otherwise.
push_update() {
  local out status
  out="$(git push 2>&1)"
  status=$?
  [ "$status" -eq 0 ] && return 0
  case "$out" in
    *"protected branch"* | *"GH006"* | *"must be made through a pull request"* | *"pre-receive hook declined"*)
      echo "[boucle] ERROR: push rejected — ${BOUCLE_DEFAULT_BRANCH:-the default branch} looks protected." >&2
      echo "[boucle]   Self-update pushes straight to the default branch, so a protection" >&2
      echo "[boucle]   rule that requires a pull request blocks it on every run. This will" >&2
      echo "[boucle]   NOT clear by retrying: allow the boucle bot to bypass the rule, or" >&2
      echo "[boucle]   turn self-update off (BOUCLE_UPDATE_DISABLE=true) and bump the" >&2
      echo "[boucle]   engine by hand." >&2
      ;;
    *)
      echo "[boucle] WARN: push failed, will retry next pipeline" >&2
      ;;
  esac
  printf '%s\n' "$out" | sed -e 's#://[^@/]*@#://***@#g' -e 's/^/[boucle]   /' >&2
  return 1
}

# ── Pure functions (testable, no network) ──────────────────────────────

# get_mode: echo the configured update mode (release|dev), default release.
get_mode() {
  echo "${BOUCLE_UPDATE_MODE:-release}"
}

# get_current_version: echo the current engine version, or empty if unknown.
# Resolution order:
#   1. BOUCLE_VERSION env var (forge Variable — primary source in CI)
#   2. Submodule pointer (git submodule status .boucle — for submodule installs)
#   3. Empty (no file fallback — boucle only runs in forge CI)
get_current_version() {
  if [ -n "${BOUCLE_VERSION:-}" ]; then
    echo "$BOUCLE_VERSION"
    return
  fi
  # Submodule pointer: for submodule installs, the gitlink IS the version.
  # `git submodule status` outputs " <sha> .boucle (heads/main)" — field 1 is the SHA.
  local sub_sha
  sub_sha=$(git submodule status .boucle 2> /dev/null | awk '{print $1}' | tr -d ' ')
  if [ -n "$sub_sha" ]; then
    echo "$sub_sha"
    return
  fi
  echo ""
}

# needs_update: return 0 if update needed, 1 if not.
# Update is needed when upstream is non-empty and differs from current.
needs_update() {
  local current="$1" upstream="$2"
  [ -n "$upstream" ] || return 1
  [ "$current" != "$upstream" ] || return 1
  return 0
}

# ── Network functions ──────────────────────────────────────────────────

# get_upstream_version <mode>: echo the latest version identifier from upstream.
# release mode → latest tag name; dev mode → HEAD commit SHA on main.
# Echoes empty string on failure.
get_upstream_version() {
  local mode="$1"
  case "$mode" in
    release)
      # GitHub returns tags newest-first by default; [0] is the latest.
      curl_with_auth "$UPSTREAM_API/tags" 2> /dev/null | jq -r '.[0].name // empty' 2> /dev/null || echo ""
      ;;
    dev)
      curl_with_auth "$UPSTREAM_API/commits/main" 2> /dev/null | jq -r '.sha // empty' 2> /dev/null || echo ""
      ;;
    *)
      echo ""
      ;;
  esac
}

# download_and_extract <mode> <version>: download tarball, extract SYNC_PATHS
# into the engine directory. Returns 0 on success, 1 on failure.
download_and_extract() {
  local mode="$1" version="$2" tarball_url tmpdir topdir

  case "$mode" in
    release) tarball_url="$UPSTREAM_TARBALL/$version" ;;
    dev) tarball_url="$UPSTREAM_TARBALL/main" ;;
    *) return 1 ;;
  esac

  tmpdir=$(mktemp -d) || return 1

  # Download
  if ! curl_with_auth "$tarball_url" -o "$tmpdir/boucle.tar.gz" 2> /dev/null; then
    rm -rf "$tmpdir"
    return 1
  fi

  # Validate tarball (integrity check: valid gzip archive that can be listed)
  if ! tar tzf "$tmpdir/boucle.tar.gz" > /dev/null 2>&1; then
    rm -rf "$tmpdir"
    return 1
  fi

  # Extract
  tar xzf "$tmpdir/boucle.tar.gz" -C "$tmpdir" 2> /dev/null || {
    rm -rf "$tmpdir"
    return 1
  }

  # Find top-level directory (GitHub tarballs have a single top-level dir
  # like ankaboot-source-boucle-<short-sha>/)
  topdir=$(find "$tmpdir" -maxdepth 1 -mindepth 1 -type d | head -1)
  if [ -z "$topdir" ]; then
    rm -rf "$tmpdir"
    return 1
  fi

  # Replace sync paths in the engine directory with upstream versions.
  # Paths are relative to ENGINE_DIR (either "." for legacy or ".boucle"
  # for the new install model).
  for path in $SYNC_PATHS; do
    if [ -e "$topdir/$path" ]; then
      rm -rf "${ENGINE_DIR:?}/$path"
      cp -r "$topdir/$path" "${ENGINE_DIR:?}/$path"
    fi
  done

  rm -rf "$tmpdir"
  return 0
}

# ── Consumer root file propagation ─────────────────────────────────────
# Engine-owned reference docs that agents MUST find at the consumer repo root
# (AGENTS.md §"Reference files"). After bin/update syncs the engine files into
# ENGINE_DIR (.boucle/), these files must also be propagated to the consumer
# root so agents find them there. Consumer-owned docs (README.md, LOOP.md,
# CONTEXT.md, the design charter) are NEVER overwritten — they belong to the
# consumer project.
#
# The root CI file is NEVER propagated on GitLab: the consumer's root
# .gitlab-ci.yml is a shim (include: local .boucle/.gitlab-ci.yml) written
# by bin/setup. Overwriting it with the full engine pipeline recreates the
# stale-copy bug: the self-update syncs .boucle/.gitlab-ci.yml but GitLab
# uses the root file, which drifts and references paths that don't exist
# outside .boucle/ (e.g. $CI_PROJECT_DIR/bin/render-preview instead of
# $BOUCLE_HOME/bin/render-preview — the triage render-preview failure
# class, observed on urgence-palestine.fr #85).
#
# On GitHub, the workflow file MUST be at the repo root — GitHub Actions
# only reads .github/workflows/ at the root, not inside .boucle/. So the
# workflow IS propagated.
# AGENTS.md is consumer-owned (project-specific context); SKILL.md and
# ARCHITECTURE.md are engine-owned. See bin/setup §"Charter docs" for the
# rationale (consumer AGENTS.md overwrite regression during m3llm migration).
CONSUMER_ROOT_DOCS="SKILL.md ARCHITECTURE.md"

# propagate_consumer_root_files
# Copies engine-owned docs + CI from ENGINE_DIR to the consumer root.
# Only runs when ENGINE_DIR != "." (i.e. submodule install model, not dogfood).
# Returns the list of propagated file paths on stdout (for git add).
#
# The root CI file is NEVER propagated on GitLab: the consumer's root
# .gitlab-ci.yml is a shim (include: local .boucle/.gitlab-ci.yml) written
# by bin/setup. Overwriting it with the full engine pipeline recreates the
# stale-copy bug.
#
# On GitHub, the workflow file MUST be at the repo root — GitHub Actions
# only reads .github/workflows/ at the root, not inside .boucle/. So the
# workflow IS propagated.
propagate_consumer_root_files() {
  [ "$ENGINE_DIR" = "." ] && return 0
  local propagated=""
  local ci_file=""
  if [ "${BOUCLE_FORGE:-gitlab}" = "github" ]; then
    ci_file=".github/workflows/boucle.yml"
  fi
  for f in $CONSUMER_ROOT_DOCS $ci_file; do
    [ -z "$f" ] && continue
    # Never overwrite a root .gitlab-ci.yml — it is a shim, not a copy.
    [ "$f" = ".gitlab-ci.yml" ] && continue
    if [ -f "$ENGINE_DIR/$f" ]; then
      mkdir -p "$(dirname "$f")"
      cp "$ENGINE_DIR/$f" "$f"
      propagated="$propagated $f"
    fi
  done

  # ── Migrate the LESSONS.yml symlink away (one-time) ──────────────
  # Consumers installed before the split carry a root LESSONS.yml symlinked
  # into .boucle/. That symlink is what makes the root name the engine's, so
  # it must go before the consumer can own that path. Removing it loses
  # nothing: the target is the engine file, still present under .boucle/ and
  # still injected into every prompt. A REAL file at the root is a consumer
  # lessons file — never touch it. No empty file is seeded in its place: an
  # absent file is the honest state until the loop records a first lesson,
  # and bin/check-lessons would reject an empty one.
  if [ "$ENGINE_DIR" != "." ] && [ -L "LESSONS.yml" ]; then
    local lessons_target
    lessons_target=$(readlink -f "LESSONS.yml" 2> /dev/null || echo "")
    if [ -z "$lessons_target" ] \
      || [ "$lessons_target" = "$(readlink -f "$ENGINE_DIR/LESSONS.yml" 2> /dev/null)" ]; then
      rm -f "LESSONS.yml"
      propagated="$propagated LESSONS.yml"
      echo "[boucle] migrated: removed the root LESSONS.yml symlink into $ENGINE_DIR — that path is now the consumer's own lessons file" >&2
    fi
  fi

  # ── Symlink engine assets that agents must find at the repo root ──
  # .jcode/skills/ and bin/ live under .boucle/ (the engine
  # dir) but agent prompts reference them at the repo root. jcode's
  # `skill` tool resolves `.jcode/skills/` relative to cwd (repo root) and
  # `bin/forge-note` is called as `bin/forge-note` (relative to cwd).
  # Without these symlinks, 0/68 agent runs could load skills or reliably
  # call forge-note (observed on boucle.dev — the files exist under
  # .boucle/ but are invisible at the root). Symlinks (not copies) so they
  # stay in sync with .boucle/ on every bin/update without a re-copy step.
  # Idempotent: replace stale/broken symlinks, never touch a real file.
  #
  # LESSONS.yml is deliberately NOT in this list. At a consumer root that name
  # belongs to the CONSUMER's own lessons — a real, committed, agent-writable
  # file. Symlinking it into the engine made the root file the engine's, which
  # is why no agent could ever record one: the write landed in the .boucle/
  # submodule, `git add` staged nothing but a dirty pointer, and
  # bin/check-boucle-sync rejected it. The engine's lessons still reach every
  # prompt — bin/jc injects both files and MERGES them.
  # shellcheck source=bin/lib/engine-symlink.sh
  . "$ENGINE_DIR/bin/lib/engine-symlink.sh"
  for lt in ".jcode/skills" "bin"; do
    local engine_src="$ENGINE_DIR/$lt"
    [ -e "$engine_src" ] || continue
    # If the root path is already a symlink pointing at the engine, skip.
    if [ -L "$lt" ] && [ "$(readlink -f "$lt")" = "$(readlink -f "$engine_src")" ]; then
      continue
    fi
    # If the root path is a real file/dir (not a symlink), never overwrite
    # it — a consumer may have a custom LESSONS.yml, skills, or bin. Only
    # create the symlink when the root path does not exist.
    if [ -e "$lt" ] && [ ! -L "$lt" ]; then
      echo "[boucle] WARN: $lt exists at repo root (not a symlink) — skipping symlink creation (consumer-owned)" >&2
      continue
    fi
    # The TARGET is not "$engine_src": ln -s resolves a relative target from
    # the directory containing the LINK, not from the repo root, and
    # $ENGINE_DIR is absolute ($(cd .. && pwd)). Passing $engine_src wrote
    # either a link that never resolved (.jcode/skills, missing its "../")
    # or one carrying this machine's checkout path. See
    # bin/lib/engine-symlink.sh.
    local link_target
    link_target=$(engine_symlink_target "$ENGINE_DIR" "$lt" "$PWD") || continue
    # Remove a stale/broken symlink if present.
    [ -L "$lt" ] && rm -f "$lt"
    mkdir -p "$(dirname "$lt")"
    ln -s "$link_target" "$lt"
    # `ln -s` succeeds on a dangling target, so a wrong target is invisible
    # until a skill load fails much later and reads as a model problem.
    if [ ! -e "$lt" ]; then
      echo "[boucle] WARN: $lt → $link_target does not resolve — removing the broken symlink" >&2
      rm -f "$lt"
      continue
    fi
    propagated="$propagated $lt"
  done

  echo "$propagated"
}

# ── Main ──────────────────────────────────────────────────────────────

main() {
  local dry_run=false mode current upstream add_paths

  # Self-update guard: never push from a push-source pipeline. A push
  # triggers a new pipeline on the default branch; if bin/update pushes
  # back from inside that pipeline, it creates a feedback loop (push →
  # pipeline → bin/update → push → pipeline → ...). The loop workflow
  # only runs on trigger-source pipelines (webhooks + chained
  # trigger/pipeline calls), so skipping self-update on push is safe.
  # Forge-agnostic: BOUCLE_PIPELINE_SOURCE is the alias set by
  # lib/boucle-ci.sh (CI_PIPELINE_SOURCE on GitLab, github.event_name on
  # GitHub Actions — where update runs in workflow_dispatch/schedule
  # context, so the check is less critical but still gated the same way).
  if [ "${BOUCLE_PIPELINE_SOURCE:-}" = "push" ]; then
    echo "[boucle] self-update skipped in push pipeline (BOUCLE_PIPELINE_SOURCE=push)"
    return 0
  fi

  [ "${1:-}" = "--dry-run" ] && dry_run=true

  mode=$(get_mode)
  # Validate mode
  case "$mode" in
    release | dev) ;;
    *)
      echo "[boucle] WARN: BOUCLE_UPDATE_MODE='$mode' invalid (expected release|dev), using release" >&2
      mode="release"
      ;;
  esac

  current=$(get_current_version)
  upstream=$(get_upstream_version "$mode")

  # No upstream version available
  if [ -z "$upstream" ]; then
    if [ "$mode" = "release" ]; then
      echo "[boucle] WARN: no releases found upstream, staying on current version" >&2
    else
      echo "[boucle] WARN: could not fetch upstream commit, staying on current version" >&2
    fi
    return 0
  fi

  # First run: no BOUCLE_VERSION env var and no submodule pointer → just
  # record the version in the forge Variable and exit. No file replacement
  # happens on this run — we only record the baseline. The submodule pointer
  # is set by `git submodule add` (done by bin/setup), so the next run
  # derives the version from there.
  if [ -z "$current" ]; then
    # Record the new version in the forge Variable so the next run sees it.
    # This replaces the old .boucle-version file write. The forge Variable
    # persists across CI runs (GitHub Actions Variables, GitLab CI/CD Variables).
    forge_ci_var_set "BOUCLE_VERSION" "$upstream" 2> /dev/null || true
    echo "[boucle] recorded initial version $upstream"
    return 0
  fi

  # Already up to date?
  if ! needs_update "$current" "$upstream"; then
    echo "[boucle] up to date ($mode: $current)"
    return 0
  fi

  echo "[boucle] update available: $current → $upstream ($mode)"

  if [ "$dry_run" = "true" ]; then
    echo "[boucle] DRY RUN — would download and apply $upstream"
    return 0
  fi

  # ── Submodule mode: update the pointer, not the files ──────────────
  # When .boucle is a git submodule, the parent repo tracks it as a
  # gitlink (160000) — individual files inside .boucle/ are invisible to
  # the parent's git add/commit. The tarball extraction would land changes
  # in the submodule working tree that the parent cannot commit, so they
  # are lost on the next `git submodule update` (CI checkout).
  #
  # Instead: update the submodule pointer to the upstream commit SHA and
  # commit THAT in the parent repo. The next CI checkout materializes the
  # new engine files at the pinned commit via `git submodule update`.
  if [ -n "$SUBMODULE_MODE" ]; then
    echo "[boucle] submodule install — updating pointer to $upstream"
    # The upstream version IS the commit SHA (dev mode) or tag (release
    # mode). For release mode, resolve the tag to a commit SHA via the
    # GitHub API so the submodule pointer is a SHA, not a tag name
    # (git submodule pointers must be SHAs).
    local submodule_sha="$upstream"
    if [ "$mode" = "release" ]; then
      submodule_sha=$(curl_with_auth -s \
        "https://api.github.com/repos/${UPSTREAM_REPO}/git/refs/tags/$upstream" \
        2> /dev/null | jq -r '.object.sha // empty' 2> /dev/null) || submodule_sha="$upstream"
      # Annotated tags: the ref points to a tag object, not the commit.
      # Resolve one level: object.type == "tag" → object.url gives the commit.
      if [ -n "$submodule_sha" ]; then
        local obj_type
        obj_type=$(curl_with_auth -s \
          "https://api.github.com/repos/${UPSTREAM_REPO}/git/tags/$submodule_sha" \
          2> /dev/null | jq -r '.object.type // empty' 2> /dev/null) || obj_type=""
        if [ "$obj_type" = "commit" ]; then
          submodule_sha=$(curl_with_auth -s \
            "https://api.github.com/repos/${UPSTREAM_REPO}/git/tags/$submodule_sha" \
            2> /dev/null | jq -r '.object.sha // empty' 2> /dev/null) || submodule_sha="$upstream"
        fi
      fi
    fi
    if [ -z "$submodule_sha" ]; then
      echo "[boucle] WARN: could not resolve upstream SHA, staying on current version" >&2
      return 0
    fi
    # Update the submodule pointer in the parent index.
    git config user.email "${BOUCLE_BOT_EMAIL:-boucle-bot@boucle.local}"
    git config user.name "${BOUCLE_BOT_USERNAME:-up-bot}"
    git update-index --cacheinfo 160000 "$submodule_sha" "$ENGINE_DIR"
    # Record the new version in the forge Variable so the next run sees it.
    # This replaces the old .boucle-version file write. The forge Variable
    # persists across CI runs (GitHub Actions Variables, GitLab CI/CD Variables).
    forge_ci_var_set "BOUCLE_VERSION" "$upstream" 2> /dev/null || true
    # Propagate engine-owned docs to the consumer root (submodule files
    # are not readable by agents at the parent root — AGENTS.md etc. must
    # be copied out). The CI checkout materializes .boucle/ so the docs
    # are available there, but agents read them from the parent root.
    propagated_files=$(propagate_consumer_root_files)
    # shellcheck disable=SC2086
    git add $propagated_files 2> /dev/null || true
    git commit -m "chore(boucle): auto-update submodule to $upstream" > /dev/null 2>&1 || true
    configure_git_push
    if push_update; then
      echo "[boucle] submodule updated to $upstream"
    else
      echo "[boucle] submodule pointer committed locally at $upstream but NOT published — this consumer stays on $current until a later pipeline pushes it" >&2
    fi
    return 0
  fi

  # Download and apply update
  if ! download_and_extract "$mode" "$upstream"; then
    echo "[boucle] WARN: download/extract failed, staying on current version" >&2
    return 0
  fi

  # Propagate engine-owned docs + CI to the consumer root (AGENTS.md,
  # SKILL.md, ARCHITECTURE.md, workflow). Consumer-owned docs (README.md,
  # LOOP.md, CONTEXT.md) are NOT overwritten.
  propagated_files=$(propagate_consumer_root_files)

  # Record the new version in the forge Variable so the next run sees it.
  # This replaces the old .boucle-version file write. The forge Variable
  # persists across CI runs (GitHub Actions Variables, GitLab CI/CD Variables).
  forge_ci_var_set "BOUCLE_VERSION" "$upstream" 2> /dev/null || true

  # Commit and push
  # Force bot identity — NEVER preserve the clone's inherited identity.
  # On a CI runner the clone inherits the human's git config, so a
  # `git config user.email > /dev/null 2>&1 || ...` guard leaves the
  # human's name as the commit author. The self-update commit is the
  # bot's work, not the human's — force the bot identity unconditionally.
  git config user.email "${BOUCLE_BOT_EMAIL:-boucle-bot@boucle.local}"
  git config user.name "${BOUCLE_BOT_USERNAME:-up-bot}"
  # Build add paths: SYNC_PATHS prefixed with ENGINE_DIR + propagated root files.
  add_paths=""
  for path in $SYNC_PATHS; do
    add_paths="$add_paths $ENGINE_DIR/$path"
  done
  # shellcheck disable=SC2086 # word-splitting is intentional: add_paths is a space-separated list.
  git add $add_paths $propagated_files
  git commit -m "chore(boucle): auto-update to $upstream" > /dev/null 2>&1 || true
  configure_git_push
  if push_update; then
    echo "[boucle] updated to $upstream"
  else
    echo "[boucle] update to $upstream committed locally but NOT published — this consumer stays on $current until a later pipeline pushes it" >&2
  fi
  return 0
}

# ── Entry point (only when executed directly, not sourced by tests) ───
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@" || echo "[boucle] WARN: update failed, continuing with current version" >&2
  exit 0
fi
