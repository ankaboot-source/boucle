#!/usr/bin/env bash
# shellcheck shell=bash
# bin/check-boucle-sync — reject unauthorized modifications to .boucle/
#
# .boucle/ is the ENGINE directory, 100% owned by bin/update. Only bot
# commits (messages starting with `chore(boucle):`) are allowed to touch it.
# Any human or agent commit that modifies .boucle/ is a bug: bin/update will
# later overwrite it, silently discarding the change (e.g. a consumer editing
# .boucle/.gitlab-ci.yml to switch deploy mode, then bin/update clobbering it).
#
# Authorized commit subjects (bot, produced by bin/update):
#   chore(boucle): auto-update to <sha>
#   chore(boucle): sync upstream ...
#   chore(boucle): record initial version ...
#   chore(boucle): auto-update ...            (broader fallback)
#
# Remediation channels (what to do instead of editing .boucle/):
#   - Consumer config (deploy mode, build command, review mode, ...) → CI
#     variables (Settings → CI/CD → Variables) or the root .gitlab-ci.yml shim.
#   - Engine bug → fix in the upstream boucle repo, then bin/update syncs it.
#
# ── Commit range: ONE explicit base, two-dot uses ───────────────────────
# `A...B` is the wrong tool for "what did this push introduce":
#   * `git diff A...B` needs a MERGE BASE. A force-push (rebase) orphans the
#     previous head and a shallow CI clone (GIT_DEPTH) never fetched it, so git
#     dies with `fatal: <A>...<B>: no merge base` — a red branch pipeline that
#     has nothing to do with .boucle/ (observed on a consumer).
#   * `git log A...B` is a SYMMETRIC difference: it walks the BEFORE side too,
#     so commits the push never introduced (pre-rebase lane commits, trunk
#     commits) were blamed for .boucle/ edits.
# So the base is resolved once, then `git diff BASE AFTER` (file list) and
# `git log BASE..AFTER` (commit list) are used — they cannot disagree, and
# only newly introduced commits are judged.
#
# Base resolution order (push mode):
#   1. merge base of the before-SHA and the after-SHA — the only correct base;
#   2. the before-SHA is missing/diverged: one bounded, best-effort
#      `git fetch --deepen=200 origin` (no-op on a full clone, tolerant of an
#      offline runner or missing credentials), then one retry;
#   3. trunk-relative: origin/$CI_DEFAULT_BRANCH, else $CI_DEFAULT_BRANCH —
#      the same ref the merge-request path uses. If that ref already IS the
#      pushed head (a push to the trunk whose before-SHA is unreachable), the
#      range degenerates to empty for the wrong reason: step 4 applies;
#   4. no base at all, or a fallback base identical to the pushed head →
#      FAIL CLOSED (exit 1). A guard NEVER turns an unresolvable or degenerate
#      range into a silent pass.
# Merge request: merge base of the target branch and HEAD, falling back to the
# target branch tip. Local/manual: HEAD~1..HEAD.
#
# Exit codes:
#   0 — no .boucle/ change, or every .boucle/ change is an authorized bot commit
#   1 — at least one commit modified .boucle/ without an authorized subject,
#       OR the commit range could not be resolved / degenerated (fail closed)
#
# Idempotent, read-only: the only side effect is the bounded, best-effort
# `git fetch --deepen` above, and only when the base is genuinely missing.
# Passes shellcheck and shfmt.
set -euo pipefail

default_branch="${CI_DEFAULT_BRANCH:-main}"

# ── Authorized bot commit subjects ──────────────────────────────────────
# bin/update produces these. Anything else touching .boucle/ is unauthorized.
is_authorized() {
  local subject="$1"
  case "${subject}" in
    "chore(boucle): auto-update to "* | \
      "chore(boucle): sync upstream"* | \
      "chore(boucle): record initial version"* | \
      "chore(boucle): auto-update"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# ── Base resolution helpers ─────────────────────────────────────────────
# rev_resolves <rev>: the revision names a commit present in this clone.
rev_resolves() {
  [ -n "${1}" ] && git rev-parse --verify --quiet "${1}^{commit}" > /dev/null 2>&1
}

# commit_of <rev>: print the resolved commit id, or nothing when it does not
# resolve. Used to compare two refs by identity.
commit_of() {
  git rev-parse --verify --quiet "${1}^{commit}" 2> /dev/null || true
}

# merge_base_of <a> <b>: print the merge base, or nothing when there is none
# (disjoint histories, unreachable revision) — never fatal.
merge_base_of() {
  git merge-base "${1}" "${2}" 2> /dev/null || true
}

# Best-effort and bounded: only called when the base is genuinely missing.
# A shallow CI clone (GIT_DEPTH: 20) does not contain the orphaned before-SHA
# of a force-push; one 200-commit deepen usually reaches the branch point.
# Every failure is tolerated — offline runner, no credentials, already-full
# clone — and the caller falls through to the trunk-relative base.
deepen_clone_once() {
  git rev-parse --is-shallow-repository 2> /dev/null | grep -qx true || return 0
  git fetch --quiet --deepen=200 origin > /dev/null 2>&1 || return 0
  return 0
}

# The trunk-relative base — the same ref the merge-request path uses.
resolve_trunk_base() {
  if git rev-parse --verify --quiet "origin/${default_branch}^{commit}" > /dev/null 2>&1; then
    printf '%s\n' "origin/${default_branch}"
  elif git rev-parse --verify --quiet "${default_branch}^{commit}" > /dev/null 2>&1; then
    printf '%s\n' "${default_branch}"
  else
    return 1
  fi
}

# resolve_base <before> <after>: set BASE and BASE_SOURCE, return 1 when no
# base at all could be resolved. BASE_SOURCE says where the base came from:
# "merge-base" when it is a real merge base with the before-SHA (or the
# before-SHA itself), "trunk" when only the trunk-relative fallback resolved.
# The caller needs that distinction: a trunk base that already IS the pushed
# head is a degenerate range, not a "no changes" answer.
resolve_base() {
  local before="${1}" after="${2}" mb=""
  base_source="merge-base"
  if rev_resolves "${before}"; then
    mb=$(merge_base_of "${before}" "${after}")
  fi
  if [ -z "${mb}" ]; then
    # Missing base: the before-SHA is unreachable (force-push orphaned it in a
    # shallow clone) or the two histories are disjoint. Deepen once, retry.
    deepen_clone_once
    if rev_resolves "${before}"; then
      mb=$(merge_base_of "${before}" "${after}")
    fi
  fi
  if [ -n "${mb}" ]; then
    base="${mb}"
    return 0
  fi
  base_source="trunk"
  if ! base=$(resolve_trunk_base); then
    base=""
    base_source=""
    return 1
  fi
  return 0
}

# ── Fail closed: an unresolvable range is never a silent pass ───────────
# fail_closed <before> <after> [unresolved|degenerate]
fail_closed() {
  local before="${1}" after_rev="${2}" reason="${3:-unresolved}"
  if [ "${reason}" = "degenerate" ]; then
    cat >&2 << EOF
check-boucle-sync: the push range degenerates to an empty range — FAILING CLOSED.

  before-SHA : ${before:-<unset>}
  after-SHA  : ${after_rev}
  base used  : ${base} (trunk-relative fallback)

The before-SHA is unreachable in this clone (a force-push left it behind and
the clone is shallow), so the trunk-relative fallback is all that is left — and
that ref already points at the pushed head. The empty range says nothing about
what this push introduced, so an unauthorized .boucle/ edit could slip through
it. That is a fail-open, not a "no changes" answer.

Fix: raise GIT_DEPTH for this job (GIT_DEPTH: 0 clones the full history) or
fetch the before-SHA (git fetch origin <sha>), then re-run. If the range is
genuinely empty, inspect the push manually.
EOF
  else
    cat >&2 << EOF
check-boucle-sync: cannot resolve a commit range — FAILING CLOSED.

  before-SHA : ${before:-<unset>}
  after-SHA  : ${after_rev}
  trunk refs : origin/${default_branch}, ${default_branch}

An unverifiable range must never become a pass: an unauthorized .boucle/ edit
could then slip through. The usual causes are:

  * a force-push (rebase) orphaned the before-SHA and this clone is shallow
    (GIT_DEPTH), so no merge base exists;
  * neither origin/${default_branch} nor ${default_branch} exists in this
    clone, so the trunk-relative fallback is unavailable.

Fix: raise GIT_DEPTH for the job (GIT_DEPTH: 0 clones the full history) or
fetch the before-SHA (git fetch origin <sha>), then re-run.
EOF
  fi
  cat >&2 << 'EOF'

Remediation for the .boucle/ rule itself:
  consumer config → CI variables (Settings → CI/CD → Variables) or the root
  .gitlab-ci.yml shim;
  engine bug      → fix in the upstream boucle repo, then bin/update syncs it.
EOF
  echo "check-boucle-sync FAILED — commit range could not be resolved" >&2
  exit 1
}

# ── Resolve the commit range to check ───────────────────────────────────
# Priority: merge request → push to default branch → local/manual run.
base=""
after="HEAD"
if [ -n "${CI_MERGE_REQUEST_TARGET_BRANCH_NAME:-}" ]; then
  # On a merge request: diff against the target branch.
  target_ref="origin/${CI_MERGE_REQUEST_TARGET_BRANCH_NAME}"
  if ! git rev-parse --verify --quiet "${target_ref}^{commit}" > /dev/null 2>&1; then
    target_ref="${CI_MERGE_REQUEST_TARGET_BRANCH_NAME}"
  fi
  base=$(merge_base_of "${target_ref}" "${after}")
  # No merge base (unrelated histories): diff straight against the target tip.
  [ -n "${base}" ] || base="${target_ref}"
elif [ -n "${CI_COMMIT_BEFORE_SHA:-}" ] && [ "${CI_COMMIT_BEFORE_SHA}" != "0000000000000000000000000000000000000000" ]; then
  # On a push to the default branch. Guard: all-zeros / empty before-SHA means
  # the first push of a branch — nothing to diff against, skip.
  after="${CI_COMMIT_SHA:-HEAD}"
  # A clone that does not contain the pushed commit itself cannot be ranged;
  # HEAD is the same commit in a CI checkout, so use it rather than fatal.
  rev_resolves "${after}" || after="HEAD"
  base=""
  base_source=""
  resolve_base "${CI_COMMIT_BEFORE_SHA}" "${after}" ||
    fail_closed "${CI_COMMIT_BEFORE_SHA}" "${after}" unresolved
  # A trunk-relative base that resolves to the pushed head teaches us nothing:
  # the before-SHA is unreachable AND the trunk ref already points at the head,
  # so the empty range is a fail-open, not a "no changes" answer. Only the
  # fallback is rejected here — a real merge base that happens to equal the
  # after-SHA (a push that only removed commits) keeps its existing behaviour.
  if [ "${base_source}" = "trunk" ]; then
    base_sha=$(commit_of "${base}")
    after_sha=$(commit_of "${after}")
    if [ -n "${base_sha}" ] && [ "${base_sha}" = "${after_sha}" ]; then
      fail_closed "${CI_COMMIT_BEFORE_SHA}" "${after}" degenerate
    fi
  fi
else
  # Local/manual run (no CI vars). Guard: only 1 commit in the repo → skip.
  if git rev-parse --verify --quiet 'HEAD~1^{commit}' > /dev/null 2>&1; then
    base=$(merge_base_of 'HEAD~1' "${after}")
    [ -n "${base}" ] || base='HEAD~1'
  else
    echo "check-boucle-sync: no commit range to check (first commit or no CI context) — pass"
    exit 0
  fi
fi

echo "check-boucle-sync: range ${base}..${after}"

# ── Any .boucle/ changes in the range? ──────────────────────────────────
changed_files=$(git diff --name-only "${base}" "${after}")
boucle_files=$(printf '%s\n' "${changed_files}" | grep '^\.boucle/' || true)
if [ -z "${boucle_files}" ]; then
  echo "check-boucle-sync: no changes under .boucle/ — pass"
  exit 0
fi

# ── Check every commit the range introduced ─────────────────────────────
FAIL=0
for sha in $(git log --format=%H "${base}..${after}"); do
  # Only consider commits that actually modified a file under .boucle/.
  # --root: a root commit (the first commit of a repository or of an orphan
  # branch) is invisible to plain `diff-tree`, and an unauthorized .boucle/
  # edit in one would pass silently.
  if ! git diff-tree --root --no-commit-id --name-only -r "${sha}" | grep -q '^\.boucle/'; then
    continue
  fi
  subject=$(git log -1 --format=%s "${sha}")
  if is_authorized "${subject}"; then
    echo "OK: commit ${sha:0:12} (${subject}) — authorized bot update"
  else
    author=$(git log -1 --format='%an <%ae>' "${sha}")
    echo "ERROR: commit ${sha:0:12} (${subject}) by ${author} modified .boucle/ without authorization" >&2
    FAIL=1
  fi
done

if [ "${FAIL}" -eq 1 ]; then
  cat >&2 << 'EOF'

.boucle/ is the ENGINE directory, 100% owned by bin/update. Only bot commits
(chore(boucle): ...) may touch it — bin/update will overwrite any manual edit.

To change CONSUMER config (deploy mode, build command, review mode, ...):
  use CI variables (Settings → CI/CD → Variables) or the root .gitlab-ci.yml
  shim — NEVER .boucle/.gitlab-ci.yml.

To fix an ENGINE bug: fix it in the upstream boucle repo, then bin/update syncs
it to consumers.
EOF
  echo "check-boucle-sync FAILED — unauthorized .boucle/ modification" >&2
  exit 1
fi

echo "check-boucle-sync OK — all .boucle/ changes are authorized bot commits"
exit 0
