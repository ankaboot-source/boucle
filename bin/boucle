#!/usr/bin/env bash
# bin/boucle — interactive harness CLI for boucle issues.
#
# Lets a human take over an issue (pause), work in their agent CLI, and hand
# it back to the loop (resume/restart). Also provides read-only commands
# (status, check, log) for inspecting issue state.
#
# Sources lib/boucle.sh and bin/forge/common.sh — calls existing primitives.
# No new label, no new agent runtime.
#
# Usage:
#   boucle pause <iid>       # human takes over, loop goes silent
#   boucle resume <iid>       # loop resumes the flow
#   boucle restart <iid>      # loop takes the issue from scratch
#   boucle status <iid>       # forge label + state.md + iterations.md
#   boucle check <iid>        # file-gate, deps, siblings
#   boucle log <iid>          # agent-output.log (last run trace)
#   boucle takeover <iid>     # print jcode --resume command for interactive takeover (#54 item 2)

set -euo pipefail

# ── Resolve BOUCLE_HOME ──────────────────────────────────────────────────
BOUCLE_HOME="${BOUCLE_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"

# ── Resolve forge identity for local (non-CI) usage ─────────────────────
# In CI, BOUCLE_PROJECT_ID / BOUCLE_PROJECT_PATH / BOUCLE_FORGE_HOST are
# set by the CI wrapper. Locally (a harness running bin/boucle from the
# consumer repo), they are typically unset — so we auto-detect them from
# the origin git remote, the same way bin/setup does. This lets a harness
# run `bin/boucle status <iid>` without manually exporting forge vars.
_resolve_local_forge_identity() {
  # Only resolve what is missing — never override explicit env vars.
  if [ -n "${BOUCLE_PROJECT_ID:-}" ] && [ -n "${BOUCLE_PROJECT_PATH:-}" ] && [ -n "${BOUCLE_FORGE_HOST:-}" ]; then
    return 0
  fi

  local remote_url
  remote_url="$(git remote get-url origin 2> /dev/null || true)"
  if [ -z "$remote_url" ]; then
    return 0 # no remote — best-effort, forge calls will fail with a clear message
  fi

  local remote_host="" remote_path=""
  case "$remote_url" in
    git@*)
      remote_host="${remote_url#git@}"
      remote_host="${remote_host%%:*}"
      remote_path="${remote_url#*:}"
      ;;
    https://*)
      remote_body="${remote_url#https://}"
      # Strip embedded credentials (user:pass@) — common in OAuth URLs
      # like https://oauth2:glpat-xxx@framagit.org/group/proj.git
      remote_body="${remote_body#*[@]}"
      remote_host="${remote_body%%/*}"
      remote_path="${remote_body#*/}"
      ;;
    ssh://*)
      remote_body="${remote_url#ssh://}"
      # Strip user@ prefix if present (ssh://git@host/...)
      remote_body="${remote_body#*[@]}"
      remote_host="${remote_body%%/*}"
      remote_path="${remote_body#*/}"
      ;;
  esac
  remote_path="${remote_path%.git}"

  [ -z "${BOUCLE_FORGE_HOST:-}" ] && export BOUCLE_FORGE_HOST="$remote_host"
  [ -z "${BOUCLE_PROJECT_PATH:-}" ] && export BOUCLE_PROJECT_PATH="$remote_path"

  # Auto-detect forge from host if not set.
  if [ -z "${BOUCLE_FORGE:-}" ] && [ -n "$remote_host" ]; then
    case "$remote_host" in
      github.com | *.github.com) export BOUCLE_FORGE="github" ;;
      *) export BOUCLE_FORGE="gitlab" ;; # default: GitLab (self-hosted or gitlab.com)
    esac
  fi

  # Resolve numeric project ID for GitLab (glab API needs it).
  if [ -z "${BOUCLE_PROJECT_ID:-}" ] && [ "${BOUCLE_FORGE:-gitlab}" = "gitlab" ] && [ -n "$remote_path" ]; then
    local encoded
    encoded="$(echo "$remote_path" | sed 's/\//%2F/g')"
    local resolved_id
    resolved_id="$(glab api --hostname "$BOUCLE_FORGE_HOST" "/projects/$encoded" 2> /dev/null | jq -r '.id // empty' 2> /dev/null || true)"
    if [ -n "$resolved_id" ]; then
      export BOUCLE_PROJECT_ID="$resolved_id"
    fi
  fi

  # GitHub: project ID is "owner/repo" (same as path).
  if [ -z "${BOUCLE_PROJECT_ID:-}" ] && [ "${BOUCLE_FORGE:-}" = "github" ]; then
    export BOUCLE_PROJECT_ID="$remote_path"
  fi
}
_resolve_local_forge_identity

# ── Source the engine + forge abstraction ────────────────────────────────
# shellcheck disable=SC1091
source "$BOUCLE_HOME/lib/boucle.sh"
# shellcheck disable=SC1091
source "$BOUCLE_HOME/bin/forge/common.sh"
forge_init

# ── Forge identity guard ─────────────────────────────────────────────────
# If we still don't know which project to talk to, fail with a clear message
# instead of letting forge_issue_get return empty and kill the script under
# set -euo pipefail.
_check_forge_identity() {
  if [ -z "${BOUCLE_PROJECT_ID:-}" ]; then
    echo "ERROR: could not resolve the forge project identity." >&2
    echo "       BOUCLE_PROJECT_ID is empty. Either:" >&2
    echo "         - run from a repo with an 'origin' git remote, or" >&2
    echo "         - export BOUCLE_PROJECT_ID, BOUCLE_PROJECT_PATH, BOUCLE_FORGE_HOST" >&2
    echo "       See SKILL.md §'Forge auth in local mode'." >&2
    return 1
  fi
}

# ── Helpers ──────────────────────────────────────────────────────────────

# Print the current boucle detail label for an issue (e.g. "working", "human").
# Empty if no boucle: label is set.
current_label() {
  local iid="$1"
  forge_issue_labels_get "$iid" 2> /dev/null \
    | tr ',' '\n' \
    | grep '^boucle:' \
    | grep -v '^boucle::' \
    | head -1 \
    | sed 's/^boucle://'
}

# Print the current gross label (e.g. "bot", "human"). Empty in mono-user mode.
current_gross() {
  local iid="$1"
  forge_issue_labels_get "$iid" 2> /dev/null \
    | tr ',' '\n' \
    | grep '^boucle::status::' \
    | head -1 \
    | sed 's/^boucle::status:://'
}

# Print "open" or "closed" for an issue.
issue_state() {
  local iid="$1"
  forge_issue_get "$iid" 2> /dev/null | jq -r '.state // "unknown"'
}

# ── pause <iid> ──────────────────────────────────────────────────────────
#
# Human takes over. Sets boucle:human, saves the previous state, posts a
# comment with the interactive marker.
cmd_pause() {
  local iid="${1:?usage: boucle pause <iid>}"

  local state
  state=$(issue_state "$iid")
  if [ "$state" = "closed" ]; then
    echo "ERROR: issue #$iid is closed — cannot take over." >&2
    exit 1
  fi

  local label gross
  label=$(current_label "$iid")
  gross=$(current_gross "$iid")

  if [ "$label" = "human" ]; then
    echo "Issue #$iid is already paused (boucle:human). Nothing to do."
    return 0
  fi

  # Save the previous state for resume to restore.
  mkdir -p ".boucle-state/$iid"
  local saved_at
  saved_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  cat > ".boucle-state/$iid/pre-interactive.json" << EOF
{"label":"$label","gross":"$gross","saved_at":"$saved_at"}
EOF

  # Transition to boucle:human (assigns to the human via set_boucle_label).
  set_boucle_label "$iid" "boucle:human" "boucle::status::human"

  # Post the pause comment with the interactive marker.
  local msg
  msg=$(
    cat << EOF
<!-- boucle:interactive v=1 -->

Issue paused by the human for interactive intervention.

Previous state: \`boucle:$label\`

Run \`boucle resume $iid\` to hand back to the loop, or \`boucle restart $iid\` to start from scratch.
EOF
  )
  forge_issue_note "$iid" "$(stamp_agent_marker "$msg")"

  local branch
  branch=$(boucle_branch_name "$iid")
  echo "✓ Issue #$iid paused (was: boucle:$label)"
  echo "  Branch: $branch"
  echo "  Run \`boucle check $iid\` before coding to verify no file conflicts."
}

# ── resume <iid> ─────────────────────────────────────────────────────────
#
# Loop resumes the flow. If the branch boucle/<iid> has commits ahead of
# origin/$BOUCLE_DEFAULT_BRANCH, sets boucle:review (loop runs reviewer +
# merger on the human's code). Otherwise restores the previous label.
cmd_resume() {
  local iid="${1:?usage: boucle resume <iid>}"

  local pre_file=".boucle-state/$iid/pre-interactive.json"
  if [ ! -f "$pre_file" ]; then
    echo "ERROR: issue #$iid is not in interactive pause (no pre-interactive.json)." >&2
    exit 1
  fi

  local prev_label prev_gross
  prev_label=$(jq -r '.label' "$pre_file")
  prev_gross=$(jq -r '.gross' "$pre_file")

  # Detect commits ahead on the worker branch (prefix match on boucle/<iid>).
  local branch
  branch=$(boucle_branch_name "$iid")
  local default_branch="${BOUCLE_DEFAULT_BRANCH:-master}"
  local commits_ahead=0
  if git rev-parse --verify "$branch" > /dev/null 2>&1; then
    commits_ahead=$(git rev-list --count "origin/$default_branch..$branch" 2> /dev/null || echo 0)
  fi

  local target_label target_msg
  if [ "$commits_ahead" -gt 0 ]; then
    target_label="boucle:review"
    target_msg="Restored state: boucle:review (code detected on branch $branch, $commits_ahead commit(s) ahead)."
  else
    target_label="$prev_label"
    target_msg="Restored state: boucle:$prev_label (no new commits on branch)."
  fi

  # Restore the label + re-assign the bot (BOT_JUST_ASSIGNED path).
  set_boucle_label "$iid" "$target_label" "boucle::status::bot"

  # Post the resume comment.
  local msg
  msg=$(
    cat << EOF
<!-- boucle:interactive v=1 -->

Loop resumed by the human.

$target_msg
EOF
  )
  forge_issue_note "$iid" "$(stamp_agent_marker "$msg")"

  # Clean up the saved state.
  rm -f "$pre_file"

  echo "✓ Issue #$iid resumed → $target_label"
  echo "  The loop will re-route on the next dispatch cycle (BOT_JUST_ASSIGNED)."
}

# ── restart <iid> ────────────────────────────────────────────────────────
#
# Loop takes the issue from scratch. Sets boucle:todo, re-assigns the bot.
# Does NOT restore the previous state — this is a fresh start.
cmd_restart() {
  local iid="${1:?usage: boucle restart <iid>}"

  local state
  state=$(issue_state "$iid")
  if [ "$state" = "closed" ]; then
    echo "ERROR: issue #$iid is closed — cannot restart." >&2
    exit 1
  fi

  set_boucle_label "$iid" "boucle:todo" "boucle::status::bot"

  local msg
  msg=$(
    cat << EOF
<!-- boucle:interactive v=1 -->

Loop restarted from scratch (boucle:todo).
EOF
  )
  forge_issue_note "$iid" "$(stamp_agent_marker "$msg")"

  # Clean up any saved interactive state.
  rm -f ".boucle-state/$iid/pre-interactive.json"

  echo "✓ Issue #$iid restarted → boucle:todo"
  echo "  The loop will triage (or worker if already triaged) on the next dispatch cycle."
}

# ── status <iid> ─────────────────────────────────────────────────────────
#
# Synthetic view: forge label + assignee + MR status + state.md + iterations.md.
# Works even without local .boucle-state/<iid>/ — the forge API is the source
# of truth for label/assignee/MR; local state files are supplementary.
cmd_status() {
  local iid="${1:?usage: boucle status <iid>}"
  _check_forge_identity

  local issue_json label assignee state
  issue_json="$(forge_issue_get "$iid" 2> /dev/null || true)"
  if [ -z "$issue_json" ] || [ "$issue_json" = "null" ]; then
    echo "ERROR: could not fetch issue #$iid from the forge." >&2
    echo "       Check BOUCLE_FORGE_HOST=$BOUCLE_FORGE_HOST and BOUCLE_PROJECT_ID=$BOUCLE_PROJECT_ID" >&2
    echo "       and that glab/gh is authenticated for this host." >&2
    exit 1
  fi

  label="$(current_label "$iid")"
  state="$(echo "$issue_json" | jq -r '.state // "unknown"')"
  assignee="$(echo "$issue_json" | jq -r '.assignees[0].username // .assignee.username // "unassigned"')"
  local title
  title="$(echo "$issue_json" | jq -r '.title // ""')"

  echo "=== Issue #$iid ==="
  [ -n "$title" ] && echo "Title:    $title"
  echo "State:    $state"
  echo "Label:    boucle:$label"
  echo "Assignee: $assignee"

  # Branch URL on the forge (for live diff consultation).
  local branch
  branch=$(boucle_branch_name "$iid")
  local branch_url
  branch_url=$(forge_branch_url "$branch" 2> /dev/null || echo "")
  echo "Branch:   $branch"
  if [ -n "$branch_url" ]; then
    echo "Branch URL: $branch_url"
  fi

  # MR status (if any). Lookup uses the protocol key boucle/<iid> —
  # forge_mr_lookup_by_branch prefix-matches so boucle/<iid>-<slug> is found.
  local mr_iid
  mr_iid=$(forge_mr_lookup_by_branch "boucle/$iid" "opened" 2> /dev/null || echo "")
  if [ -n "$mr_iid" ]; then
    local mr_status
    mr_status=$(forge_mr_merge_status "$mr_iid" 2> /dev/null || echo "unknown")
    echo "MR:       !$mr_iid (status: $mr_status)"
  else
    echo "MR:       (none open)"
  fi

  # Iteration count from iterations.md.
  local iter_file=".boucle-state/$iid/iterations.md"
  if [ -f "$iter_file" ]; then
    local iter_count
    iter_count=$(grep -c '^### Iteration' "$iter_file" 2> /dev/null || echo 0)
    echo "Iterations: $iter_count"
  else
    echo "Iterations: (no iterations.md)"
  fi

  # state.md summary.
  local state_file=".boucle-state/$iid/state.md"
  if [ -f "$state_file" ]; then
    echo ""
    echo "--- state.md ---"
    cat "$state_file"
  else
    echo ""
    echo "--- state.md: (not found) ---"
  fi

  # Last 3 iterations.
  if [ -f "$iter_file" ]; then
    echo ""
    echo "--- iterations.md (last 3) ---"
    grep -A5 '^### Iteration' "$iter_file" | tail -30
  fi
}

# ── check <iid> ──────────────────────────────────────────────────────────
#
# Pre-work gate check: file-gate, deps, siblings. Consultation only —
# informs, does not block.
cmd_check() {
  local iid="${1:?usage: boucle check <iid>}"

  local all_clear=1

  # ── File-gate: check boucle:files marker against in-flight issues ──────
  # Source the gates library if available for the full check_file_gate.
  # Otherwise, do a simple marker-based check.
  local files_marker=""
  local notes_json
  notes_json=$(forge_issue_notes "$iid" 2> /dev/null || echo "[]")
  files_marker=$(echo "$notes_json" \
    | jq -r '[.[] | select(.body | test("<!-- boucle:files v=1"))] | last | .body // ""' \
    | grep -oP '(?<=paths=)[^"]+' | head -1)

  if [ -z "$files_marker" ]; then
    echo "✓ File-gate: no file-impact marker (fail-open — safe to proceed)"
  else
    # Check in-flight issues (working/review/approval/merging) for overlap.
    local in_flight
    in_flight=$(forge_issue_list_by_label "boucle:working,boucle:review,boucle:approval,boucle:merging" "opened" 2> /dev/null || echo "[]")
    local overlap_iids
    overlap_iids=$(echo "$in_flight" \
      | jq -r --arg iid "$iid" --arg paths "$files_marker" '
          [.[] | select(.iid != ($iid | tonumber))]
          | map(.iid as $other | {
              iid: .iid,
              overlap: ($paths | split(",") | map(
                . as $p | $other  # placeholder — full impl needs the other issue files marker
              ))
            } | select(.overlap | length > 0)) | .[].iid' 2> /dev/null || echo "")

    if [ -z "$overlap_iids" ]; then
      echo "✓ File-gate: clear (no overlapping issues)"
    else
      echo "✗ File-gate: OVERLAP with issue(s): $overlap_iids"
      echo "  Files: $files_marker"
      echo "  → Wait for the overlapping issue(s) to merge, or coordinate."
      all_clear=0
    fi
  fi

  # ── Dependency gate: check boucle:depends-on marker ───────────────────
  local deps_marker
  deps_marker=$(echo "$notes_json" \
    | jq -r '[.[] | select(.body | test("<!-- boucle:depends-on"))] | last | .body // ""' \
    | grep -oP '(?<=iids=)[^" ]+' | head -1)

  if [ -z "$deps_marker" ]; then
    echo "✓ Dependencies: clear (no parent deps)"
  else
    local dep_blocked=""
    for dep_iid in $(echo "$deps_marker" | tr ',' ' '); do
      local dep_state
      dep_state=$(issue_state "$dep_iid")
      if [ "$dep_state" != "closed" ]; then
        dep_blocked="$dep_blocked #$dep_iid ($dep_state)"
      fi
    done
    if [ -z "$dep_blocked" ]; then
      echo "✓ Dependencies: clear (all deps closed: $deps_marker)"
    else
      echo "✗ Dependencies: BLOCKED by:$dep_blocked"
      all_clear=0
    fi
  fi

  # ── Sibling gate: check if this is a sub-issue with active siblings ────
  local split_parent
  split_parent=$(echo "$notes_json" \
    | jq -r '[.[] | select(.body | test("<!-- boucle:split-parent"))] | last | .body // ""' \
    | grep -oP '(?<=iids=)[^" ]+' | head -1)

  if [ -z "$split_parent" ]; then
    echo "✓ Siblings: clear (not a sub-issue)"
  else
    echo "ℹ Siblings: this is a sub-issue (siblings: $split_parent)"
    echo "  Check sibling states manually before starting work."
  fi

  echo ""
  if [ "$all_clear" -eq 1 ]; then
    local branch
    branch=$(boucle_branch_name "$iid")
    echo "→ Safe to work on $branch"
  else
    echo "→ NOT safe — resolve the issues above before starting work"
  fi
}

# ── log <iid> ────────────────────────────────────────────────────────────
#
# Print the agent-output.log from the last run. Read-only.
cmd_log() {
  local iid="${1:?usage: boucle log <iid>}"
  local log_file=".boucle-state/$iid/agent-output.log"
  if [ -f "$log_file" ]; then
    cat "$log_file"
  else
    echo "No agent-output.log found for issue #$iid." >&2
    echo "Expected at: $log_file" >&2
    exit 1
  fi
}

# ── takeover <iid> ────────────────────────────────────────────────────────
#
# Interactive takeover (#54 item 2). Prints the exact jcode --resume command
# for the human to run locally, plus how to restore the captured session files
# from the CI artifact. Read-only — does not change labels or post notes.
#
# Prerequisite: bin/jc captured the worker session to
# .boucle-state/<iid>/session-id + session/. If absent (ephemeral runner,
# cleaned ~/.jcode, or non-worker role), prints the fallback path.
cmd_takeover() {
  local iid="${1:?usage: boucle takeover <iid>}"
  local session_id_file=".boucle-state/$iid/session-id"
  local session_dir=".boucle-state/$iid/session"

  if [ ! -f "$session_id_file" ]; then
    echo "No captured jcode session for issue #$iid." >&2
    echo "" >&2
    echo "This happens when:" >&2
    echo "  - the worker ran on an ephemeral runner (session files do not survive)," >&2
    echo "  - ~/.jcode was cleaned between the run and now, or" >&2
    echo "  - the session artifact was not downloaded/extracted yet." >&2
    echo "" >&2
    echo "Fallback: run \`boucle restart $iid\` for a fresh worker run from state.md." >&2
    exit 1
  fi

  local sid
  sid=$(cat "$session_id_file" 2> /dev/null) || sid=""
  if [ -z "$sid" ]; then
    echo "ERROR: session-id file exists but is empty: $session_id_file" >&2
    exit 1
  fi

  echo "=== Interactive takeover — issue #$iid ==="
  echo ""
  echo "Captured jcode session: $sid"
  echo ""
  echo "## Step 1 — restore the session files locally"
  echo ""
  echo "The session was captured to .boucle-state/$iid/session/ on the runner."
  echo "Download the worker artifact from the CI run (boucle-agent-log-worker-*)"
  echo "and extract it to your repo root, then:"
  echo ""
  echo "  mkdir -p ~/.jcode/sessions"
  echo "  cp .boucle-state/$iid/session/session.json ~/.jcode/sessions/${sid}.json"
  echo "  cp .boucle-state/$iid/session/session.journal.jsonl ~/.jcode/sessions/${sid}.journal.jsonl"
  echo ""
  echo "## Step 2 — resume the session"
  echo ""
  echo "Interactive (TUI — you steer the agent with full prior history):"
  echo ""
  echo "  jcode --resume $sid"
  echo ""
  echo "Headless (one new instruction, then exit):"
  echo ""
  echo "  jcode run --resume $sid \"<your instruction>\""
  echo ""
  echo "## Step 3 — hand back to the loop"
  echo ""
  echo "After committing and pushing your changes:"
  echo ""
  echo "  boucle resume $iid   # loop resumes the flow (runs reviewer on your code)"
  echo ""
  echo "Or start fresh if the session approach did not help:"
  echo ""
  echo "  boucle restart $iid  # fresh worker run from state.md"
  echo ""
  echo "Fallback if the session files are unavailable: \`boucle restart $iid\`."
}

# ── list / ls ────────────────────────────────────────────────────────────
#
# List boucle issues from the forge, grouped by state. Read-only.
# Shows open issues with any boucle: label, sorted by boucle state.
# Optional filter: boucle list <state> (e.g. boucle list working).
cmd_list() {
  local filter="${1:-}"
  _check_forge_identity

  # Fetch all open issues with any boucle: label.
  local all_issues
  all_issues="$(forge_issue_list_by_label "boucle:triage,boucle:todo,boucle:spec-review,boucle:working,boucle:review,boucle:approval,boucle:merging,boucle:human,boucle:done,boucle:split" "opened" 2> /dev/null || echo "[]")"

  if [ "$all_issues" = "[]" ] || [ -z "$all_issues" ]; then
    echo "No open boucle issues found."
    return 0
  fi

  # Parse and format. Each issue: iid, title, labels (extract boucle: detail).
  local rows
  rows="$(echo "$all_issues" | jq -r '
    sort_by(.iid)
    | .[]
    | .iid as $iid
    | .title as $title
    | (.labels | map(select(startswith("boucle:")) | select(startswith("boucle::") | not)) | first // "") as $bl
    | ($bl | sub("^boucle:"; "")) as $state
    | [$iid, $state, $title] | @tsv
  ' 2> /dev/null || true)"

  if [ -z "$rows" ]; then
    echo "No open boucle issues found."
    return 0
  fi

  # Filter by state if requested.
  if [ -n "$filter" ]; then
    rows="$(echo "$rows" | awk -F'\t' -v f="$filter" '$2 == f')"
    if [ -z "$rows" ]; then
      echo "No open boucle issues with state '$filter'."
      return 0
    fi
  fi

  # Print table.
  printf "%-6s  %-14s  %s\n" "IID" "STATE" "TITLE"
  printf "%-6s  %-14s  %s\n" "---" "-----" "-----"
  echo "$rows" | while IFS=$'\t' read -r iid state title; do
    # Truncate title to 60 chars for readability.
    title="${title:0:60}"
    [ ${#title} -eq 60 ] && title="${title}…"
    printf "#%-5s  %-14s  %s\n" "$iid" "${state:-(no boucle label)}" "$title"
  done

  local count
  count="$(echo "$rows" | wc -l | tr -d ' ')"
  echo ""
  echo "Total: $count open boucle issue(s)"
}

# ── help ─────────────────────────────────────────────────────────────────
#
# Print usage with a one-line description per command.
cmd_help() {
  cat << 'EOF'
boucle — interactive harness CLI for boucle issues

USAGE
  boucle <command> [args]

COMMANDS
  status <iid>       Forge label + assignee + MR + state.md + iterations
  list [state]       List open boucle issues (alias: ls)
                     Optional filter: list working, list human, list review…
  check <iid>        Pre-work gates: file-gate, dependencies, siblings
  log <iid>          Print the last agent-output.log trace
  takeover <iid>     Print the jcode --resume command for interactive takeover
  pause <iid>        Human takes over (sets boucle:human)
  resume <iid>       Hand back to the loop (restores previous state)
  restart <iid>      Loop takes the issue from scratch (boucle:todo)
  help               Show this help

EXAMPLES
  boucle list                    # all open boucle issues
  boucle list working            # only issues being worked on
  boucle status 105              # detailed view of issue #105
  boucle check 105               # pre-work gates before coding
  boucle takeover 105            # interactive session takeover
  boucle pause 105               # take over issue #105 interactively
  boucle resume 105              # hand #105 back to the loop

FORGE AUTH (local mode)
  The forge identity (project, host, forge type) is auto-detected from the
  'origin' git remote. If auto-detection fails, export:
    BOUCLE_PROJECT_ID, BOUCLE_PROJECT_PATH, BOUCLE_FORGE_HOST, BOUCLE_FORGE
  See SKILL.md §"Forge auth in local mode".

SEE ALSO
  SKILL.md §8 "Interactive mode" — full protocol documentation.
EOF
}

# ── Main dispatch ────────────────────────────────────────────────────────
case "${1:-}" in
  pause)
    shift
    cmd_pause "$@"
    ;;
  resume)
    shift
    cmd_resume "$@"
    ;;
  restart)
    shift
    cmd_restart "$@"
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  check)
    shift
    cmd_check "$@"
    ;;
  log)
    shift
    cmd_log "$@"
    ;;
  takeover)
    shift
    cmd_takeover "$@"
    ;;
  list | ls)
    shift
    cmd_list "$@"
    ;;
  help | -h | --help) cmd_help ;;
  "")
    cmd_help
    exit 0
    ;;
  *)
    echo "Unknown command: '$1'" >&2
    echo "Run 'boucle help' for usage." >&2
    exit 1
    ;;
esac
