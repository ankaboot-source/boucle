#!/usr/bin/env bash
# bin/boucle — interactive harness CLI for boucle issues.
#
# Lets a human take over an issue (pause), work in their agent CLI, and hand
# it back to the loop (resume/restart). Also provides read-only commands
# (status, check, log) for inspecting issue state.
#
# Sources lib/boucle.sh and bin/forge/common.sh — calls existing primitives.
# No new label, no new agent runtime.
#
# Usage:
#   boucle pause <iid>       # human takes over, loop goes silent
#   boucle resume <iid>       # loop resumes the flow
#   boucle restart <iid>      # loop takes the issue from scratch
#   boucle status <iid>       # forge label + state.md + iterations.md
#   boucle check <iid>        # file-gate, deps, siblings
#   boucle log <iid>          # agent-output.log (last run trace)

set -euo pipefail

# ── Resolve BOUCLE_HOME ──────────────────────────────────────────────────
BOUCLE_HOME="${BOUCLE_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"

# ── Source the engine + forge abstraction ────────────────────────────────
# shellcheck disable=SC1091
source "$BOUCLE_HOME/lib/boucle.sh"
# shellcheck disable=SC1091
source "$BOUCLE_HOME/bin/forge/common.sh"
forge_init

# ── Helpers ──────────────────────────────────────────────────────────────

# Print the current boucle detail label for an issue (e.g. "working", "human").
# Empty if no boucle: label is set.
current_label() {
  local iid="$1"
  forge_issue_labels_get "$iid" 2>/dev/null \
    | tr ',' '\n' \
    | grep '^boucle:' \
    | grep -v '^boucle::' \
    | head -1 \
    | sed 's/^boucle://'
}

# Print the current gross label (e.g. "bot", "human"). Empty in mono-user mode.
current_gross() {
  local iid="$1"
  forge_issue_labels_get "$iid" 2>/dev/null \
    | tr ',' '\n' \
    | grep '^boucle::status::' \
    | head -1 \
    | sed 's/^boucle::status:://'
}

# Print "open" or "closed" for an issue.
issue_state() {
  local iid="$1"
  forge_issue_get "$iid" 2>/dev/null | jq -r '.state // "unknown"'
}

# ── pause <iid> ──────────────────────────────────────────────────────────
#
# Human takes over. Sets boucle:human, saves the previous state, posts a
# comment with the interactive marker.
cmd_pause() {
  local iid="${1:?usage: boucle pause <iid>}"

  local state
  state=$(issue_state "$iid")
  if [ "$state" = "closed" ]; then
    echo "ERROR: issue #$iid is closed — cannot take over." >&2
    exit 1
  fi

  local label gross
  label=$(current_label "$iid")
  gross=$(current_gross "$iid")

  if [ "$label" = "human" ]; then
    echo "Issue #$iid is already paused (boucle:human). Nothing to do."
    return 0
  fi

  # Save the previous state for resume to restore.
  mkdir -p ".boucle-state/$iid"
  local saved_at
  saved_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  cat > ".boucle-state/$iid/pre-interactive.json" << EOF
{"label":"$label","gross":"$gross","saved_at":"$saved_at"}
EOF

  # Transition to boucle:human (assigns to the human via set_boucle_label).
  set_boucle_label "$iid" "boucle:human" "boucle::status::human"

  # Post the pause comment with the interactive marker.
  local msg
  msg=$(cat << EOF
<!-- boucle:interactive v=1 -->

Issue paused by the human for interactive intervention.

Previous state: \`boucle:$label\`

Run \`boucle resume $iid\` to hand back to the loop, or \`boucle restart $iid\` to start from scratch.
EOF
)
  forge_issue_note "$iid" "$(stamp_agent_marker "$msg")"

  local branch
  branch=$(boucle_branch_name "$iid")
  echo "✓ Issue #$iid paused (was: boucle:$label)"
  echo "  Branch: $branch"
  echo "  Run \`boucle check $iid\` before coding to verify no file conflicts."
}

# ── resume <iid> ─────────────────────────────────────────────────────────
#
# Loop resumes the flow. If the branch boucle/<iid> has commits ahead of
# origin/$BOUCLE_DEFAULT_BRANCH, sets boucle:review (loop runs reviewer +
# merger on the human's code). Otherwise restores the previous label.
cmd_resume() {
  local iid="${1:?usage: boucle resume <iid>}"

  local pre_file=".boucle-state/$iid/pre-interactive.json"
  if [ ! -f "$pre_file" ]; then
    echo "ERROR: issue #$iid is not in interactive pause (no pre-interactive.json)." >&2
    exit 1
  fi

  local prev_label prev_gross
  prev_label=$(jq -r '.label' "$pre_file")
  prev_gross=$(jq -r '.gross' "$pre_file")

  # Detect commits ahead on the worker branch (prefix match on boucle/<iid>).
  local branch
  branch=$(boucle_branch_name "$iid")
  local default_branch="${BOUCLE_DEFAULT_BRANCH:-master}"
  local commits_ahead=0
  if git rev-parse --verify "$branch" >/dev/null 2>&1; then
    commits_ahead=$(git rev-list --count "origin/$default_branch..$branch" 2>/dev/null || echo 0)
  fi

  local target_label target_msg
  if [ "$commits_ahead" -gt 0 ]; then
    target_label="boucle:review"
    target_msg="Restored state: boucle:review (code detected on branch $branch, $commits_ahead commit(s) ahead)."
  else
    target_label="$prev_label"
    target_msg="Restored state: boucle:$prev_label (no new commits on branch)."
  fi

  # Restore the label + re-assign the bot (BOT_JUST_ASSIGNED path).
  set_boucle_label "$iid" "$target_label" "boucle::status::bot"

  # Post the resume comment.
  local msg
  msg=$(cat << EOF
<!-- boucle:interactive v=1 -->

Loop resumed by the human.

$target_msg
EOF
)
  forge_issue_note "$iid" "$(stamp_agent_marker "$msg")"

  # Clean up the saved state.
  rm -f "$pre_file"

  echo "✓ Issue #$iid resumed → $target_label"
  echo "  The loop will re-route on the next dispatch cycle (BOT_JUST_ASSIGNED)."
}

# ── restart <iid> ────────────────────────────────────────────────────────
#
# Loop takes the issue from scratch. Sets boucle:todo, re-assigns the bot.
# Does NOT restore the previous state — this is a fresh start.
cmd_restart() {
  local iid="${1:?usage: boucle restart <iid>}"

  local state
  state=$(issue_state "$iid")
  if [ "$state" = "closed" ]; then
    echo "ERROR: issue #$iid is closed — cannot restart." >&2
    exit 1
  fi

  set_boucle_label "$iid" "boucle:todo" "boucle::status::bot"

  local msg
  msg=$(cat << EOF
<!-- boucle:interactive v=1 -->

Loop restarted from scratch (boucle:todo).
EOF
)
  forge_issue_note "$iid" "$(stamp_agent_marker "$msg")"

  # Clean up any saved interactive state.
  rm -f ".boucle-state/$iid/pre-interactive.json"

  echo "✓ Issue #$iid restarted → boucle:todo"
  echo "  The loop will triage (or worker if already triaged) on the next dispatch cycle."
}

# ── status <iid> ─────────────────────────────────────────────────────────
#
# Synthetic view: forge label + assignee + MR status + state.md + iterations.md.
cmd_status() {
  local iid="${1:?usage: boucle status <iid>}"

  local issue_json label assignee state
  issue_json=$(forge_issue_get "$iid" 2>/dev/null || echo "{}")
  label=$(current_label "$iid")
  state=$(echo "$issue_json" | jq -r '.state // "unknown"')
  assignee=$(echo "$issue_json" | jq -r '.assignees[0].username // .assignee.username // "unassigned"')

  echo "=== Issue #$iid ==="
  echo "State:    $state"
  echo "Label:    boucle:$label"
  echo "Assignee: $assignee"

  # Branch URL on the forge (for live diff consultation).
  local branch
  branch=$(boucle_branch_name "$iid")
  local branch_url
  branch_url=$(forge_branch_url "$branch" 2>/dev/null || echo "")
  echo "Branch:   $branch"
  if [ -n "$branch_url" ]; then
    echo "Branch URL: $branch_url"
  fi

  # MR status (if any). Lookup uses the protocol key boucle/<iid> —
  # forge_mr_lookup_by_branch prefix-matches so boucle/<iid>-<slug> is found.
  local mr_iid
  mr_iid=$(forge_mr_lookup_by_branch "boucle/$iid" "opened" 2>/dev/null || echo "")
  if [ -n "$mr_iid" ]; then
    local mr_status
    mr_status=$(forge_mr_merge_status "$mr_iid" 2>/dev/null || echo "unknown")
    echo "MR:       !$mr_iid (status: $mr_status)"
  else
    echo "MR:       (none open)"
  fi

  # Iteration count from iterations.md.
  local iter_file=".boucle-state/$iid/iterations.md"
  if [ -f "$iter_file" ]; then
    local iter_count
    iter_count=$(grep -c '^### Iteration' "$iter_file" 2>/dev/null || echo 0)
    echo "Iterations: $iter_count"
  else
    echo "Iterations: (no iterations.md)"
  fi

  # state.md summary.
  local state_file=".boucle-state/$iid/state.md"
  if [ -f "$state_file" ]; then
    echo ""
    echo "--- state.md ---"
    cat "$state_file"
  else
    echo ""
    echo "--- state.md: (not found) ---"
  fi

  # Last 3 iterations.
  if [ -f "$iter_file" ]; then
    echo ""
    echo "--- iterations.md (last 3) ---"
    grep -A5 '^### Iteration' "$iter_file" | tail -30
  fi
}

# ── check <iid> ──────────────────────────────────────────────────────────
#
# Pre-work gate check: file-gate, deps, siblings. Consultation only —
# informs, does not block.
cmd_check() {
  local iid="${1:?usage: boucle check <iid>}"

  local all_clear=1

  # ── File-gate: check boucle:files marker against in-flight issues ──────
  # Source the gates library if available for the full check_file_gate.
  # Otherwise, do a simple marker-based check.
  local files_marker=""
  local notes_json
  notes_json=$(forge_issue_notes "$iid" 2>/dev/null || echo "[]")
  files_marker=$(echo "$notes_json" \
    | jq -r '[.[] | select(.body | test("<!-- boucle:files v=1"))] | last | .body // ""' \
    | grep -oP '(?<=paths=)[^"]+' | head -1)

  if [ -z "$files_marker" ]; then
    echo "✓ File-gate: no file-impact marker (fail-open — safe to proceed)"
  else
    # Check in-flight issues (working/review/approval/merging) for overlap.
    local in_flight
    in_flight=$(forge_issue_list_by_label "boucle:working,boucle:review,boucle:approval,boucle:merging" "opened" 2>/dev/null || echo "[]")
    local overlap_iids
    overlap_iids=$(echo "$in_flight" \
      | jq -r --arg iid "$iid" --arg paths "$files_marker" '
          [.[] | select(.iid != ($iid | tonumber))]
          | map(.iid as $other | {
              iid: .iid,
              overlap: ($paths | split(",") | map(
                . as $p | $other  # placeholder — full impl needs the other issue files marker
              ))
            } | select(.overlap | length > 0)) | .[].iid' 2>/dev/null || echo "")

    if [ -z "$overlap_iids" ]; then
      echo "✓ File-gate: clear (no overlapping issues)"
    else
      echo "✗ File-gate: OVERLAP with issue(s): $overlap_iids"
      echo "  Files: $files_marker"
      echo "  → Wait for the overlapping issue(s) to merge, or coordinate."
      all_clear=0
    fi
  fi

  # ── Dependency gate: check boucle:depends-on marker ───────────────────
  local deps_marker
  deps_marker=$(echo "$notes_json" \
    | jq -r '[.[] | select(.body | test("<!-- boucle:depends-on"))] | last | .body // ""' \
    | grep -oP '(?<=iids=)[^" ]+' | head -1)

  if [ -z "$deps_marker" ]; then
    echo "✓ Dependencies: clear (no parent deps)"
  else
    local dep_blocked=""
    for dep_iid in $(echo "$deps_marker" | tr ',' ' '); do
      local dep_state
      dep_state=$(issue_state "$dep_iid")
      if [ "$dep_state" != "closed" ]; then
        dep_blocked="$dep_blocked #$dep_iid ($dep_state)"
      fi
    done
    if [ -z "$dep_blocked" ]; then
      echo "✓ Dependencies: clear (all deps closed: $deps_marker)"
    else
      echo "✗ Dependencies: BLOCKED by:$dep_blocked"
      all_clear=0
    fi
  fi

  # ── Sibling gate: check if this is a sub-issue with active siblings ────
  local split_parent
  split_parent=$(echo "$notes_json" \
    | jq -r '[.[] | select(.body | test("<!-- boucle:split-parent"))] | last | .body // ""' \
    | grep -oP '(?<=iids=)[^" ]+' | head -1)

  if [ -z "$split_parent" ]; then
    echo "✓ Siblings: clear (not a sub-issue)"
  else
    echo "ℹ Siblings: this is a sub-issue (siblings: $split_parent)"
    echo "  Check sibling states manually before starting work."
  fi

  echo ""
  if [ "$all_clear" -eq 1 ]; then
    local branch
    branch=$(boucle_branch_name "$iid")
    echo "→ Safe to work on $branch"
  else
    echo "→ NOT safe — resolve the issues above before starting work"
  fi
}

# ── log <iid> ────────────────────────────────────────────────────────────
#
# Print the agent-output.log from the last run. Read-only.
cmd_log() {
  local iid="${1:?usage: boucle log <iid>}"
  local log_file=".boucle-state/$iid/agent-output.log"
  if [ -f "$log_file" ]; then
    cat "$log_file"
  else
    echo "No agent-output.log found for issue #$iid." >&2
    echo "Expected at: $log_file" >&2
    exit 1
  fi
}

# ── Main dispatch ────────────────────────────────────────────────────────
case "${1:-}" in
  pause)    shift; cmd_pause "$@" ;;
  resume)   shift; cmd_resume "$@" ;;
  restart)  shift; cmd_restart "$@" ;;
  status)   shift; cmd_status "$@" ;;
  check)    shift; cmd_check "$@" ;;
  log)      shift; cmd_log "$@" ;;
  *) echo "Usage: boucle <pause|resume|restart|status|check|log> <iid>" >&2; exit 1 ;;
esac
