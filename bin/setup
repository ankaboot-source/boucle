#!/usr/bin/env bash
# bin/setup — Day 0 infrastructure setup for boucle on a target repo.
# Supports GitLab and GitHub. The forge is auto-detected from the origin
# git remote when possible (github.com → github, gitlab.com → gitlab,
# self-hosted via hostname heuristic or API probe). Override with a
# subcommand (setup gitlab / setup github) or --forge <gitlab|github>.
# Idempotent: safe to run multiple times. Checks before creating.
# Usage: bin/setup [gitlab|github] [--project <id-or-path>] [--host <forge-host>] [--bot-id <id>] [--bot-token <pat>] [--cf-token <token>] [--dry-run]
#        bin/setup --forge <gitlab|github> [other flags]   (legacy syntax)

set -euo pipefail

# ── Args ──────────────────────────────────────────────────────────────
# Every flag has a BOUCLE_* env fallback so bin/setup works with zero
# prompts (AI-agent-driven installs). The forge is auto-detected from the
# origin git remote; override with a subcommand, --forge, or BOUCLE_FORGE.
FORGE="${BOUCLE_FORGE:-}"
PROJECT="${BOUCLE_PROJECT:-}"
HOST="${BOUCLE_HOST:-}"
BOT_ID="${BOUCLE_BOT_ID:-}"
BOT_USERNAME="${BOUCLE_BOT_USERNAME:-up-bot}"
BOT_TOKEN="${BOUCLE_BOT_TOKEN:-}"
MONO_USER="${BOUCLE_MONO_USER:-}"
CF_TOKEN="${BOUCLE_CF_TOKEN:-}"
RUNNER_TAG="${BOUCLE_RUNNER_TAG:-}"
ALLOWED_USERS="${BOUCLE_ALLOWED_USERS:-}"
DRY_RUN=false
NON_INTERACTIVE=false

# Capture whether any CLI args were passed — used after the while loop to
# auto-enable non-interactive mode (passing args = scripting, not prompting).
CLI_ARGS_PASSED=$#

# ── Subcommand: setup gitlab / setup github ───────────────────────────
# The first positional arg can be the forge name (subcommand syntax):
#   bin/setup gitlab --bot-token <pat>
#   bin/setup github --bot-token <pat>
# This is equivalent to --forge <gitlab|github> but more ergonomic.
if [ $# -gt 0 ]; then
  case "$1" in
    gitlab|github)
      FORGE="$1"
      shift
      ;;
    --forge)
      # Legacy syntax: --forge <gitlab|github> as first arg is handled below
      ;;
    *)
      # Not a subcommand — fall through to the flag parser
      ;;
  esac
fi

while [[ $# -gt 0 ]]; do
  case $1 in
    --forge)
      FORGE="$2"
      case "$FORGE" in
        gitlab | github) ;;
        *)
          echo "Error: --forge must be 'gitlab' or 'github' (got: $FORGE)" >&2
          exit 1
          ;;
      esac
      shift 2
      ;;
    --project)
      PROJECT="$2"
      shift 2
      ;;
    --host)
      HOST="$2"
      shift 2
      ;;
    --bot-id)
      BOT_ID="$2"
      shift 2
      ;;
    --bot-username)
      BOT_USERNAME="$2"
      shift 2
      ;;
    --bot-token)
      BOT_TOKEN="$2"
      shift 2
      ;;
    --mono-user)
      MONO_USER=true
      shift
      ;;
    --cf-token)
      CF_TOKEN="$2"
      shift 2
      ;;
    --runner-tag)
      RUNNER_TAG="$2"
      shift 2
      ;;
    --allowed-users)
      ALLOWED_USERS="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --non-interactive)
      NON_INTERACTIVE=true
      shift
      ;;
    -h | --help)
      echo "Usage: bin/setup [gitlab|github] [options]"
      echo "       bin/setup --forge <gitlab|github> [options]   (legacy syntax)"
      echo ""
      echo "The forge is auto-detected from the origin git remote when possible"
      echo "(github.com → github, gitlab.com → gitlab, self-hosted via hostname"
      echo "heuristic or API probe). Override with a subcommand, --forge, or BOUCLE_FORGE."
      echo ""
      echo "Options:"
      echo "  --project <id-or-path>   Target project ID or path (e.g. 123456, group/project, or owner/repo)"
      echo "                           Optional: auto-detected from the origin git remote"
      echo "  --host <forge-host>      Forge host (auto-detected from origin)"
      echo "  --bot-id <id>            Bot user ID (for adding as project member)."
      echo "                           When provided, mono-user is disabled (dedicated bot)."
      echo "  --bot-username <name>    Bot username (default: up-bot; used to seed BOUCLE_BOT_USERNAME CI variable)"
      echo "  --bot-token <pat>        Bot PAT (used as BOUCLE_TOKEN CI variable)"
      echo "                           GitHub scopes: 'repo' + 'workflow' (optionally 'admin:org'"
      echo "                           for branch-protection checks). Create one at"
      echo "                           https://github.com/settings/tokens/new — see"
      echo "                           https://docs.github.com/apps/oauth-apps/building-oauth-apps/scopes-for-oauth-apps"
      echo "                           An invalid/expired PAT fails setup with instructions."
      echo "  --mono-user              Force mono-user mode (default when no --bot-id is given)."
      echo "                           Mono-user = one account owns both the issues and the loop."
      echo "                           Swaps the actor-based anti-loop guard for the"
      echo "                           label-state + agent-marker guard. Degrades notifications"
      echo "                           — see README. Prefer a bot/service account when you can."
      echo "  --cf-token <token>       Cloudflare API token (for Pages project)."
      echo "                           When omitted, Cloudflare Pages setup is skipped —"
      echo "                           configure your deploy target via BOUCLE_DEPLOY_PROVIDER instead."
      echo "  --runner-tag <tag>       Pin jobs to a runner carrying <tag>, by writing a"
      echo "                           'default: tags:' block into the root CI shim. Omit it"
      echo "                           (the default) to run untagged on the instance's shared"
      echo "                           runners — no runner of your own required."
      echo "  --allowed-users <u1,u2>  Usernames allowed to feed issues to boucle, comma-separated."
      echo "                           Default: the user running setup. Empty = allow list disabled (legacy)."
      echo "  --dry-run                 Print what would be done, don't execute"
      echo "  --non-interactive        No prompts: read config from BOUCLE_* env vars only."
      echo "                           If BOUCLE_LLM_API_KEY is unset, it is skipped and must be"
      echo "                           added manually as a masked CI/CD variable."
      echo ""
      echo "  Project and host are auto-detected from the origin git remote when not"
      echo "  passed, so an install can be a pure copy/paste inside the target repo."
      echo ""
      echo "Env fallbacks: BOUCLE_FORGE BOUCLE_PROJECT BOUCLE_HOST BOUCLE_BOT_ID BOUCLE_BOT_USERNAME"
      echo "               BOUCLE_BOT_TOKEN BOUCLE_CF_TOKEN BOUCLE_RUNNER_TAG BOUCLE_ALLOWED_USERS"
      echo "               BOUCLE_LLM_API_KEY BOUCLE_LLM_BASE_URL"
      exit 0
      ;;
    *)
      echo "Unknown arg: $1" >&2
      exit 1
      ;;
  esac
done

# ── Non-interactive auto-detection ────────────────────────────────────
# If any args were passed on the command line, the user is scripting —
# switch to non-interactive mode automatically. --non-interactive is still
# accepted for explicitness but is no longer required when args are present.
if [ "$CLI_ARGS_PASSED" -gt 0 ]; then
  NON_INTERACTIVE=true
fi

# ── Mono-user auto-detection ──────────────────────────────────────────
# Mono-user means one account owns both the issues and the loop (no separate
# bot). This is the default — especially on GitHub where nothing provisions a
# bot account for you. A dedicated bot is opt-in: pass --bot-id (a separate
# account ID) to disable mono-user. --bot-token is ALWAYS required (it is the
# auth token, whether it belongs to a bot or to the human in mono-user mode).
#
# Logic:
#   - --mono-user explicitly forces mono-user (overrides everything)
#   - --bot-id provided → dedicated bot → mono-user OFF
#   - no --bot-id → mono-user ON (default)
if [ -z "$MONO_USER" ]; then
  if [ -n "$BOT_ID" ]; then
    MONO_USER=false
  else
    MONO_USER=true
  fi
fi

# ── detect_forge_from_host — auto-detect forge type from a hostname ────
# Resolution order:
#   1. Known SaaS hosts: github.com → github, gitlab.com → gitlab
#   2. Hostname heuristic: contains "github" → github, "gitlab" → gitlab
#      (covers common self-hosted conventions like gitlab.example.com)
#   3. API probe (no auth, 3s timeout):
#      GitLab  /api/v4/version → 401 (endpoint exists, auth required)
#      GitHub  /api/v3/meta    → 200 (public endpoint)
#   4. Unrecognized → empty (caller must handle)
detect_forge_from_host() {
  local host="$1"
  [ -z "$host" ] && return 0

  # Known SaaS hosts
  case "$host" in
    github.com) echo "github"; return 0 ;;
    gitlab.com) echo "gitlab"; return 0 ;;
  esac

  # Hostname heuristic (common for self-hosted: gitlab.example.com, github.example.com)
  case "$host" in
    *github*) echo "github"; return 0 ;;
    *gitlab*) echo "gitlab"; return 0 ;;
  esac

  # API probe — no auth needed, short timeout
  local code
  code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "https://$host/api/v4/version" 2>/dev/null || true)
  case "$code" in
    200|401) echo "gitlab"; return 0 ;;
  esac

  code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "https://$host/api/v3/meta" 2>/dev/null || true)
  case "$code" in
    200) echo "github"; return 0 ;;
  esac

  # Could not detect — return empty
  return 0
}

# ── Auto-detect host + project + forge from the origin remote ──────────
# Auto-detect from the origin git remote when not provided, so a
# copy/paste install works with zero values to replace — including the
# forge itself (github.com → github, gitlab.com → gitlab, self-hosted
# detected via hostname heuristic or API probe).
if [ -z "$PROJECT" ] || [ -z "$HOST" ] || [ -z "$FORGE" ]; then
  REMOTE_URL="$(git remote get-url origin 2> /dev/null || true)"
  if [ -n "$REMOTE_URL" ]; then
    # git@host:group/project.git  →  host, group/project
    # https://host/group/project.git  →  host, group/project
    case "$REMOTE_URL" in
      git@*)
        REMOTE_HOST="${REMOTE_URL#git@}"
        REMOTE_HOST="${REMOTE_HOST%%:*}"
        REMOTE_PATH="${REMOTE_URL#*:}"
        ;;
      https://*)
        REMOTE_BODY="${REMOTE_URL#https://}"
        REMOTE_HOST="${REMOTE_BODY%%/*}"
        REMOTE_PATH="${REMOTE_BODY#*/}"
        ;;
      ssh://*)
        REMOTE_BODY="${REMOTE_URL#ssh://}"
        REMOTE_HOST="${REMOTE_BODY%%/*}"
        REMOTE_PATH="${REMOTE_BODY#*/}"
        ;;
      *)
        REMOTE_HOST=""
        REMOTE_PATH=""
        ;;
    esac
    REMOTE_PATH="${REMOTE_PATH%.git}"
    [ -z "$PROJECT" ] && PROJECT="$REMOTE_PATH"
    [ -z "$HOST" ] && HOST="$REMOTE_HOST"
    # Auto-detect the forge from the remote host when not specified.
    if [ -z "$FORGE" ] && [ -n "$REMOTE_HOST" ]; then
      DETECTED_FORGE=$(detect_forge_from_host "$REMOTE_HOST")
      if [ -n "$DETECTED_FORGE" ]; then
        FORGE="$DETECTED_FORGE"
      fi
    fi
    echo "Auto-detected from origin remote: project=$PROJECT host=$HOST${FORGE:+ forge=$FORGE}"
  fi
fi

# ── Validate forge ────────────────────────────────────────────────────
# The forge is auto-detected from the origin remote when possible.
# If auto-detection failed (no remote, unrecognized host, API probe
# failed), it must be specified explicitly: subcommand, --forge, or
# BOUCLE_FORGE.
if [ -z "$FORGE" ]; then
  echo "Error: could not auto-detect the forge from the origin remote." >&2
  echo "       Specify it explicitly:" >&2
  echo "       bin/setup <gitlab|github> [flags]" >&2
  echo "       bin/setup --forge <gitlab|github> [flags]" >&2
  echo "       export BOUCLE_FORGE=<gitlab|github> && bin/setup" >&2
  exit 1
fi

case "$FORGE" in
  gitlab|github) ;;
  *)
    echo "Error: forge must be 'gitlab' or 'github' (got: $FORGE)" >&2
    exit 1
    ;;
esac

# Default host per forge (only when not auto-detected from the remote)
if [ -z "$HOST" ]; then
  if [ "$FORGE" = "github" ]; then
    HOST="github.com"
  else
    HOST="gitlab.example.com"
  fi
fi

[ -z "$PROJECT" ] && {
  echo "Error: --project is required (run inside the target repo or set BOUCLE_PROJECT)" >&2
  exit 1
}

# Source forge helpers — forge_ci_var_set, forge_label_create, forge_branch_protect, etc.
FORGE_BACKEND="$(cd "$(dirname "$0")" && pwd)/forge/${FORGE}.sh"
if [ -f "$FORGE_BACKEND" ]; then
  # shellcheck disable=SC1090
  source "$FORGE_BACKEND"
else
  echo "Error: forge backend not found: $FORGE_BACKEND" >&2
  exit 1
fi

# ── Helpers ───────────────────────────────────────────────────────────
PASS=0
FAIL=0
SKIP=0
log_pass() {
  echo "  ✓ $1"
  PASS=$((PASS + 1))
}
log_fail() {
  echo "  ✗ $1" >&2
  FAIL=$((FAIL + 1))
}
log_skip() {
  echo "  - $1 (skipped)"
  SKIP=$((SKIP + 1))
}

# Resolve project ID/owner-repo
if [ "$FORGE" = "gitlab" ]; then
  resolve_project_id() {
    if [[ "$PROJECT" =~ ^[0-9]+$ ]]; then
      echo "$PROJECT"
    else
      ENCODED=$(echo "$PROJECT" | sed 's/\//%2F/g')
      glab api --hostname "$HOST" "/projects/$ENCODED" 2> /dev/null | jq -r '.id'
    fi
  }
fi

echo "boucle setup — Day 0 infrastructure"
echo "Forge: $FORGE"
echo "Project: $PROJECT on $HOST"
echo ""

# GitLab: resolve numeric project ID
if [ "$FORGE" = "gitlab" ]; then
  PROJECT_ID=$(resolve_project_id)
  [ -z "$PROJECT_ID" ] || [ "$PROJECT_ID" = "null" ] && {
    echo "Error: could not resolve project ID" >&2
    exit 1
  }
  echo "Project ID: $PROJECT_ID"
  # Resolve the project web URL once (used for CI/CD variables manual-entry link).
  PROJECT_URL=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID" 2> /dev/null | jq -r '.web_url // empty' || true)
  [ -n "$PROJECT_URL" ] && echo "Project URL: $PROJECT_URL"
else
  # GitHub: PROJECT is already owner/repo
  PROJECT_ID="$PROJECT"
  PROJECT_URL="https://github.com/$PROJECT"
  echo "Project: $PROJECT_ID"
  echo "Project URL: $PROJECT_URL"
fi
echo ""

# Export BOUCLE_PROJECT_ID so the forge helpers (forge_label_create,
# forge_branch_protect, etc.) can resolve the repo. On GitLab this is the
# numeric project ID; on GitHub it is "owner/repo".
export BOUCLE_PROJECT_ID="$PROJECT_ID"

# Export BOUCLE_TOKEN so the forge helpers (_gh_api, _gl_api) can authenticate.
# The --bot-token arg seeds BOT_TOKEN; the forge helpers read BOUCLE_TOKEN.
export BOUCLE_TOKEN="$BOT_TOKEN"

# Dry-run wrapper
run() {
  if [ "$DRY_RUN" = "true" ]; then
    echo "  [dry-run] $*"
  else
    # shellcheck disable=SC2294 # intentional: re-exec the caller's command string
    eval "$@"
  fi
}

# detect_iana_tz — detect the IANA timezone name from the environment
# Resolution order: $TZ (if it contains a /), /etc/timezone, readlink /etc/localtime, UTC
detect_iana_tz() {
  local tz=""
  if [ -n "${TZ:-}" ] && [[ "$TZ" == */* ]]; then
    tz="$TZ"
  elif [ -f /etc/timezone ] && [ -s /etc/timezone ]; then
    tz="$(cat /etc/timezone | tr -d '[:space:]')"
  else
    local link
    link="$(readlink -f /etc/localtime 2> /dev/null || true)"
    if [ -n "$link" ] && [[ "$link" == *zoneinfo/* ]] && ! echo "$link" | grep -q 'localtime$'; then
      tz="${link#*zoneinfo/}"
    fi
  fi
  echo "${tz:-UTC}"
}

# configure_webhook <hook_id> <url> — GitLab only
configure_webhook() {
  local hook_id="$1"
  local url="$2"
  run "glab api --hostname $HOST -X PUT /projects/$PROJECT_ID/hooks/$hook_id -f \"url=$url\" -f issues_events=true -f note_events=true -f merge_requests_events=true -f push_events=false -f tag_push_events=false -f pipeline_events=false -f wiki_page_events=false -f deployment_events=false -f release_events=false -f emoji_events=false -f job_events=false -f confidential_issues_events=false -f confidential_note_events=false >/dev/null"
  log_pass "webhook (ID: $hook_id) configured — only Issue + Note + Merge Request events (amplification events disabled)"
}

# print_webhook_recommendations — GitLab only
print_webhook_recommendations() {
  echo ""
  echo "  Webhook event filtering (recommended):"
  echo "    Project → Settings → Webhooks — enable ONLY:"
  echo "      ✓ Issues, ✓ Notes, ✓ Merge requests"
  echo "    Leave ALL others unchecked (Push, Tag push, Pipelines, Wiki page,"
  echo "      Deployment, Release, Emoji reactions)."
  echo "    Why: boucle only acts on issue/note/MR events. Pipeline and push"
  echo "      events are generated by boucle itself (self-amplification) —"
  echo "      disabling them at the webhook source prevents no-op dispatch"
  echo "      pipelines from being created at all."
}

# ── 0. Root CI shim ───────────────────────────────────────────────────
if [ "$FORGE" = "gitlab" ]; then
  echo "=== Root .gitlab-ci.yml ==="
  # The consumer's root CI file is a thin shim that includes the engine
  # pipeline via `include: remote`. GitLab cannot `include: local` a file
  # inside a git submodule — submodule content is not part of the main
  # project tree (gitlab issue #25249).
  # An existing non-boucle .gitlab-ci.yml is NEVER overwritten: we print the
  # include block to merge manually instead, so a consumer's own pipeline is
  # never clobbered.
  GITLAB_CI="${GITLAB_CI:-.gitlab-ci.yml}"
  ENGINE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
  ENGINE_REF="main"
  if (cd "$ENGINE_ROOT" && git rev-parse --is-inside-work-tree > /dev/null 2>&1); then
    ENGINE_REF="$(cd "$ENGINE_ROOT" && git rev-parse --short=12 HEAD)"
  fi
  ENGINE_INCLUDE="https://raw.githubusercontent.com/ankaboot-source/boucle/${ENGINE_REF}/.gitlab-ci.yml"
  # Runner routing is OPT-IN. With no --runner-tag, the shim carries no
  # `tags:` at all and the engine's untagged jobs land on the instance's
  # shared runners — so a fresh install needs no runner of its own. When a tag
  # IS given, the shim overrides `default:` key-by-key (GitLab deep-merges
  # included configuration), so `image:` and `before_script:` from the engine
  # are preserved and only routing changes.
  TAGS_BLOCK=""
  if [ -n "$RUNNER_TAG" ]; then
    TAGS_BLOCK="default:
  tags: [$RUNNER_TAG]

"
  fi
  if [ -f "$GITLAB_CI" ]; then
    if grep -q "boucle engine" "$GITLAB_CI"; then
      log_skip "root $GITLAB_CI already references the boucle engine"
    else
      log_skip "existing $GITLAB_CI left untouched — add the boucle include block manually:"
      cat << SHIM
include:
  - remote: '$ENGINE_INCLUDE'

${TAGS_BLOCK}variables:
  BOUCLE_FORGE_HOST: "$HOST"
SHIM
    fi
  else
    if [ "$DRY_RUN" = "true" ]; then
      echo "  [dry-run] write $GITLAB_CI (boucle engine shim, ref $ENGINE_REF)"
    else
      cat > "$GITLAB_CI" << SHIM
# boucle engine shim (generated by bin/setup — safe to re-run).
# Includes the boucle engine pipeline from the .boucle/ submodule.
# Add your own jobs below this block; they run after the engine stages.
include:
  - remote: '$ENGINE_INCLUDE'

${TAGS_BLOCK}variables:
  BOUCLE_FORGE_HOST: "$HOST"
SHIM
    fi
    log_pass "root $GITLAB_CI written (boucle engine shim, ref $ENGINE_REF)"
  fi
  echo ""
fi

# ── 0a. GitHub Actions workflow ───────────────────────────────────────
# On GitHub, the workflow IS the webhook receiver (on: issues, on: pull_request).
# The engine ships .github/workflows/boucle.yml; the setup copies it into the
# consumer's .github/workflows/ so the consumer repo triggers the loop.
# An existing non-boucle workflow in the same file is NEVER overwritten.
if [ "$FORGE" = "github" ]; then
  echo "=== GitHub Actions workflow ==="
  ENGINE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
  ENGINE_WORKFLOW="$ENGINE_ROOT/.github/workflows/boucle.yml"
  CONSUMER_WORKFLOW=".github/workflows/boucle.yml"
  if [ ! -f "$ENGINE_WORKFLOW" ]; then
    log_fail "engine workflow not found at $ENGINE_WORKFLOW — the .boucle submodule may be incomplete"
  elif [ -f "$CONSUMER_WORKFLOW" ] && ! grep -q "boucle" "$CONSUMER_WORKFLOW" 2>/dev/null; then
    log_skip "existing $CONSUMER_WORKFLOW is not a boucle workflow — left untouched"
  else
    mkdir -p .github/workflows
    if [ "$DRY_RUN" = "true" ]; then
      echo "  [dry-run] copy $CONSUMER_WORKFLOW from engine"
    else
      cp "$ENGINE_WORKFLOW" "$CONSUMER_WORKFLOW"
    fi
    log_pass "$CONSUMER_WORKFLOW copied from engine"
  fi
  echo ""
fi

# ── 0a-bis. Charter docs at the consumer root ─────────────────────────
# The engine owns reference docs (AGENTS.md, SKILL.md, ARCHITECTURE.md) that
# agents MUST find at the repo root (AGENTS.md §"Reference files"). These are
# engine-owned: bin/update re-syncs them on every engine bump. Consumer-owned
# docs (README.md, LOOP.md, CONTEXT.md, the design charter) are NEVER
# overwritten — they belong to the consumer project.
ENGINE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC2206
CHARTER_DOCS=(AGENTS.md SKILL.md ARCHITECTURE.md)
echo "=== Charter docs ==="
for doc in "${CHARTER_DOCS[@]}"; do
  if [ ! -f "$ENGINE_ROOT/$doc" ]; then
    log_skip "$doc not in engine — skipping"
  else
    if [ "$DRY_RUN" = "true" ]; then
      echo "  [dry-run] copy $doc from engine"
    else
      cp "$ENGINE_ROOT/$doc" "$doc"
    fi
    log_pass "$doc copied from engine"
  fi
done
echo ""

# ── 0b. Consumer .gitignore — forge-agnostic ──────────────────────────
# Per-issue state lives in .boucle-state/ at the consumer root (gitignored).
# Never clobber an existing .gitignore — only append the entry if missing.
GITIGNORE_ENTRY='# boucle per-issue state (generated by bin/setup)
.boucle-state/
'
if [ -f .gitignore ]; then
  if grep -qxF ".boucle-state/" .gitignore; then
    log_skip ".gitignore already ignores .boucle-state/"
  else
    if [ "$DRY_RUN" = "true" ]; then
      echo "  [dry-run] append .boucle-state/ to .gitignore"
    else
      printf '%s' "$GITIGNORE_ENTRY" >> .gitignore
    fi
    log_pass ".gitignore updated with .boucle-state/"
  fi
else
  if [ "$DRY_RUN" = "true" ]; then
    echo "  [dry-run] create .gitignore with .boucle-state/"
  else
    printf '%s' "$GITIGNORE_ENTRY" > .gitignore
  fi
  log_pass ".gitignore created with .boucle-state/"
fi

echo ""

# ── 1. CI Variables / Secrets ────────────────────────────────────────
echo "=== CI Variables ==="

if [ "$FORGE" = "gitlab" ]; then
  # BOUCLE_TOKEN (from --bot-token)
  if [ -n "$BOT_TOKEN" ]; then
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_TOKEN" 2> /dev/null | jq -r '.key // empty' || true)
    if [ -n "$EXISTING" ]; then
      log_skip "BOUCLE_TOKEN already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_TOKEN -f value='$BOT_TOKEN' -f masked=true -f protected=true >/dev/null"
      log_pass "BOUCLE_TOKEN set"
    fi
  else
    log_skip "BOUCLE_TOKEN (no --bot-token provided)"
  fi

  # CLOUDFLARE_API_TOKEN (from --cf-token)
  if [ -n "$CF_TOKEN" ]; then
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/CLOUDFLARE_API_TOKEN" 2> /dev/null | jq -r '.key // empty' || true)
    if [ -n "$EXISTING" ]; then
      log_skip "CLOUDFLARE_API_TOKEN already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=CLOUDFLARE_API_TOKEN -f value='$CF_TOKEN' -f masked=true -f protected=true >/dev/null"
      log_pass "CLOUDFLARE_API_TOKEN set"
    fi
  else
    log_skip "CLOUDFLARE_API_TOKEN (no --cf-token provided)"
  fi

  # BOUCLE_ENABLED
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_ENABLED" 2> /dev/null | jq -r '.key // empty' || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_ENABLED already exists"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_ENABLED -f value=true -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_ENABLED set"
  fi

  # BOUCLE_SPEC_PROFILE
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_SPEC_PROFILE" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_SPEC_PROFILE already exists"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_SPEC_PROFILE -f value=product -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_SPEC_PROFILE set"
  fi

  # BOUCLE_LLM_API_KEY
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_LLM_API_KEY" 2> /dev/null | jq -r '.key // empty' || true)

  # BOUCLE_DND_TZ
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_DND_TZ" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_DND_TZ already exists"
  else
    DND_TZ_VALUE="${BOUCLE_DND_TZ:-$(detect_iana_tz)}"
    if [ "$NON_INTERACTIVE" = "false" ]; then
      read -r -p "BOUCLE_DND_TZ (IANA timezone, e.g. Europe/Paris) [$DND_TZ_VALUE]: " DND_TZ_INPUT || true
      [ -n "$DND_TZ_INPUT" ] && DND_TZ_VALUE="$DND_TZ_INPUT"
    fi
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_DND_TZ -f value=$DND_TZ_VALUE -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_DND_TZ set ($DND_TZ_VALUE)"
  fi

  # BOUCLE_DND_START
  if [ -n "${BOUCLE_DND_START:-}" ]; then
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_DND_START" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
    if [ -n "$EXISTING" ]; then
      log_skip "BOUCLE_DND_START already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_DND_START -f value=$BOUCLE_DND_START -f masked=false -f protected=false >/dev/null"
      log_pass "BOUCLE_DND_START set ($BOUCLE_DND_START)"
    fi
  else
    log_skip "BOUCLE_DND_START (not provided — default 22:00 applies)"
  fi

  # BOUCLE_DND_END
  if [ -n "${BOUCLE_DND_END:-}" ]; then
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_DND_END" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
    if [ -n "$EXISTING" ]; then
      log_skip "BOUCLE_DND_END already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_DND_END -f value=$BOUCLE_DND_END -f masked=false -f protected=false >/dev/null"
      log_pass "BOUCLE_DND_END set ($BOUCLE_DND_END)"
    fi
  else
    log_skip "BOUCLE_DND_END (not provided — default 07:00 applies)"
  fi

  # BOUCLE_DND_EXCLUDE_DAYS
  if [ -n "${BOUCLE_DND_EXCLUDE_DAYS:-}" ]; then
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_DND_EXCLUDE_DAYS" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
    if [ -n "$EXISTING" ]; then
      log_skip "BOUCLE_DND_EXCLUDE_DAYS already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_DND_EXCLUDE_DAYS -f value=$BOUCLE_DND_EXCLUDE_DAYS -f masked=false -f protected=false >/dev/null"
      log_pass "BOUCLE_DND_EXCLUDE_DAYS set ($BOUCLE_DND_EXCLUDE_DAYS)"
    fi
  else
    log_skip "BOUCLE_DND_EXCLUDE_DAYS (not provided — no excluded days)"
  fi

  # BOUCLE_UPDATE_MODE
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_UPDATE_MODE" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_UPDATE_MODE already exists"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_UPDATE_MODE -f value=release -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_UPDATE_MODE set to release"
  fi

  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_LLM_API_KEY already exists"
  else
    LLM_API_KEY="${BOUCLE_LLM_API_KEY:-}"
    if [ -z "$LLM_API_KEY" ] && [ "$NON_INTERACTIVE" = "false" ]; then
      read -r -p "BOUCLE_LLM_API_KEY value (masked): " LLM_API_KEY || true
    fi
    if [ -n "$LLM_API_KEY" ]; then
      if [ "$DRY_RUN" = "true" ]; then
        echo "  [dry-run] set BOUCLE_LLM_API_KEY (masked) — value omitted from dry-run output"
      else
        glab api --hostname "$HOST" -X POST "/projects/$PROJECT_ID/variables" --field key=BOUCLE_LLM_API_KEY --field value="$LLM_API_KEY" --field masked=true > /dev/null
      fi
      log_pass "BOUCLE_LLM_API_KEY set (masked)"
    elif [ "$NON_INTERACTIVE" = "true" ]; then
      CI_VARS_URL="${PROJECT_URL:-https://$HOST/$PROJECT}/-/settings/ci_cd"
      log_skip "BOUCLE_LLM_API_KEY — set it manually as a masked CI/CD variable: $CI_VARS_URL"
    else
      log_fail "BOUCLE_LLM_API_KEY — no value provided"
    fi
  fi

  # BOUCLE_LLM_BASE_URL
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_LLM_BASE_URL" 2> /dev/null | jq -r '.key // empty' || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_LLM_BASE_URL already exists"
  else
    LLM_BASE_URL="${BOUCLE_LLM_BASE_URL:-https://ollama.com/v1}"
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables --field key=BOUCLE_LLM_BASE_URL --field value=$LLM_BASE_URL >/dev/null"
    log_pass "BOUCLE_LLM_BASE_URL set (${BOUCLE_LLM_BASE_URL:-default: https://ollama.com/v1})"
  fi

  # BOUCLE_FALLBACK_PROVIDER
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_FALLBACK_PROVIDER" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_FALLBACK_PROVIDER already exists"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_FALLBACK_PROVIDER -f value='${BOUCLE_FALLBACK_PROVIDER:-}' -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_FALLBACK_PROVIDER set (${BOUCLE_FALLBACK_PROVIDER:-empty — fallback disabled by default; set a provider + BOUCLE_FALLBACK_API_KEY to enable})"
  fi

  # BOUCLE_FALLBACK_MODEL_TRIAGE
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_FALLBACK_MODEL_TRIAGE" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_FALLBACK_MODEL_TRIAGE already exists"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_FALLBACK_MODEL_TRIAGE -f value=${BOUCLE_FALLBACK_MODEL_TRIAGE:-glm-5.2} -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_FALLBACK_MODEL_TRIAGE set (${BOUCLE_FALLBACK_MODEL_TRIAGE:-glm-5.2})"
  fi

  # BOUCLE_FALLBACK_MODEL_WORKER
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_FALLBACK_MODEL_WORKER" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_FALLBACK_MODEL_WORKER already exists"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_FALLBACK_MODEL_WORKER -f value=${BOUCLE_FALLBACK_MODEL_WORKER:-deepseek-v4-flash} -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_FALLBACK_MODEL_WORKER set (${BOUCLE_FALLBACK_MODEL_WORKER:-deepseek-v4-flash})"
  fi

  # BOUCLE_FALLBACK_MODEL_REVIEWER
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_FALLBACK_MODEL_REVIEWER" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_FALLBACK_MODEL_REVIEWER already exists"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_FALLBACK_MODEL_REVIEWER -f value=${BOUCLE_FALLBACK_MODEL_REVIEWER:-glm-5.2} -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_FALLBACK_MODEL_REVIEWER set (${BOUCLE_FALLBACK_MODEL_REVIEWER:-glm-5.2})"
  fi

  # BOUCLE_FALLBACK_MODEL_E2E
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_FALLBACK_MODEL_E2E" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_FALLBACK_MODEL_E2E already exists"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_FALLBACK_MODEL_E2E -f value=${BOUCLE_FALLBACK_MODEL_E2E:-deepseek-v4-flash} -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_FALLBACK_MODEL_E2E set (${BOUCLE_FALLBACK_MODEL_E2E:-deepseek-v4-flash})"
  fi

  # BOUCLE_FALLBACK_BASE_URL (masked — only when env var is set)
  if [ -n "${BOUCLE_FALLBACK_BASE_URL:-}" ]; then
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_FALLBACK_BASE_URL" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
    if [ -n "$EXISTING" ]; then
      log_skip "BOUCLE_FALLBACK_BASE_URL already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_FALLBACK_BASE_URL -f value=$BOUCLE_FALLBACK_BASE_URL -f masked=true -f protected=false >/dev/null"
      log_pass "BOUCLE_FALLBACK_BASE_URL set (masked)"
    fi
  else
    log_skip "BOUCLE_FALLBACK_BASE_URL (not provided — fallback provider URL must be set manually when fallback is enabled)"
  fi

  # BOUCLE_FALLBACK_API_KEY (masked — only when env var is set)
  if [ -n "${BOUCLE_FALLBACK_API_KEY:-}" ]; then
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_FALLBACK_API_KEY" 2> /dev/null | jq -r '.key // empty' 2> /dev/null || true)
    if [ -n "$EXISTING" ]; then
      log_skip "BOUCLE_FALLBACK_API_KEY already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_FALLBACK_API_KEY -f value='$BOUCLE_FALLBACK_API_KEY' -f masked=true -f protected=false >/dev/null"
      log_pass "BOUCLE_FALLBACK_API_KEY set (masked)"
    fi
  else
    log_skip "BOUCLE_FALLBACK_API_KEY (not provided — must be set manually when fallback is enabled)"
  fi

  # BOUCLE_ALLOWED_USERS (issue allow-list — safety net)
  ALLOWED_USERS_VALUE="${BOUCLE_ALLOWED_USERS:-}"
  if [ -z "$ALLOWED_USERS_VALUE" ]; then
    # Default: the user who runs setup (the installer).
    ALLOWED_USERS_VALUE=$(glab api --hostname "$HOST" user 2> /dev/null | jq -r '.username // empty' || true)
  fi
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_ALLOWED_USERS" 2> /dev/null | jq -r '.key // empty' || true)
  if [ -n "$EXISTING" ]; then
    log_skip "BOUCLE_ALLOWED_USERS already exists"
  elif [ -n "$ALLOWED_USERS_VALUE" ]; then
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_ALLOWED_USERS -f value=$ALLOWED_USERS_VALUE -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_ALLOWED_USERS set ($ALLOWED_USERS_VALUE — only these users' issues are accepted)"
  else
    log_skip "BOUCLE_ALLOWED_USERS (could not resolve the installer username — leave unset = no allow list, or set BOUCLE_ALLOWED_USERS)"
  fi
else
  # ── GitHub: repo secrets via gh secret set ──────────────────────────
  # BOUCLE_TOKEN (from --bot-token)
  if [ -n "$BOT_TOKEN" ]; then
    run "echo \"$BOT_TOKEN\" | GH_TOKEN=\"$BOT_TOKEN\" gh secret set BOUCLE_TOKEN --repo \"$PROJECT_ID\" 2>/dev/null"
    log_pass "BOUCLE_TOKEN set (secrets)"
  else
    log_skip "BOUCLE_TOKEN (no --bot-token provided)"
  fi

  # CLOUDFLARE_API_TOKEN (from --cf-token)
  if [ -n "$CF_TOKEN" ]; then
    run "echo \"$CF_TOKEN\" | GH_TOKEN=\"$BOT_TOKEN\" gh secret set CLOUDFLARE_API_TOKEN --repo \"$PROJECT_ID\" 2>/dev/null"
    log_pass "CLOUDFLARE_API_TOKEN set (secrets)"
  else
    log_skip "CLOUDFLARE_API_TOKEN (no --cf-token provided)"
  fi

  # PI_AUTH (base64-encoded BOT_TOKEN). On GitHub, the Actions workflow
  # uses PI_AUTH for forge API calls.
  if [ -n "$BOT_TOKEN" ]; then
    PI_AUTH_B64=$(echo -n "$BOT_TOKEN" | base64 -w0 2> /dev/null || echo -n "$BOT_TOKEN" | base64)
    run "echo \"$PI_AUTH_B64\" | GH_TOKEN=\"$BOT_TOKEN\" gh secret set PI_AUTH --repo \"$PROJECT_ID\" 2>/dev/null"
    log_pass "PI_AUTH set (base64-encoded BOT_TOKEN, secrets)"
  else
    log_skip "PI_AUTH (no --bot-token provided)"
  fi

  # ── GitHub: repo vars via gh variable set ───────────────────────────
  # BOUCLE_ENABLED
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_ENABLED --repo \"$PROJECT_ID\" --body true 2>/dev/null"
  log_pass "BOUCLE_ENABLED set (vars)"

  # BOUCLE_SPEC_PROFILE
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_SPEC_PROFILE --repo \"$PROJECT_ID\" --body product 2>/dev/null"
  log_pass "BOUCLE_SPEC_PROFILE set to product (vars)"

  # BOUCLE_UPDATE_MODE
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_UPDATE_MODE --repo \"$PROJECT_ID\" --body release 2>/dev/null"
  log_pass "BOUCLE_UPDATE_MODE set to release (vars)"

  # BOUCLE_FORGE
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_FORGE --repo \"$PROJECT_ID\" --body github 2>/dev/null"
  log_pass "BOUCLE_FORGE set to github (vars)"

  # BOUCLE_MONO_USER — one account owns both the issues and the loop.
  if [ "$MONO_USER" = "true" ]; then
    run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_MONO_USER --repo \"$PROJECT_ID\" --body true 2>/dev/null"
    log_pass "BOUCLE_MONO_USER set to true (vars)"
  fi

  # BOUCLE_RUNS_ON — forge-agnostic runner selection (default GitHub-hosted).
  # GitHub: 'ubuntu-latest' (hosted) or '["self-hosted", "<label>"]' (self-hosted).
  # GitLab: maps to tags: [$BOUCLE_RUNS_ON].
  RUNS_ON="${BOUCLE_RUNS_ON:-ubuntu-latest}"
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_RUNS_ON --repo \"$PROJECT_ID\" --body \"$RUNS_ON\" 2>/dev/null"
  log_pass "BOUCLE_RUNS_ON set to $RUNS_ON (vars)"

  # BOUCLE_LLM_API_KEY (masked — use secret not var for maskable values)
  LLM_API_KEY="${BOUCLE_LLM_API_KEY:-}"
  if [ -z "$LLM_API_KEY" ] && [ "$NON_INTERACTIVE" = "false" ]; then
    read -r -p "BOUCLE_LLM_API_KEY value (masked): " LLM_API_KEY || true
  fi
  if [ -n "$LLM_API_KEY" ]; then
    if [ "$DRY_RUN" = "true" ]; then
      echo "  [dry-run] set BOUCLE_LLM_API_KEY (secret, masked) — value omitted"
    else
      echo "$LLM_API_KEY" | GH_TOKEN="$BOT_TOKEN" gh secret set BOUCLE_LLM_API_KEY --repo "$PROJECT_ID" 2> /dev/null
    fi
    log_pass "BOUCLE_LLM_API_KEY set (secrets, masked)"
  elif [ "$NON_INTERACTIVE" = "true" ]; then
    log_skip "BOUCLE_LLM_API_KEY — set it manually as a repo secret in Settings > Secrets > Actions"
  else
    log_fail "BOUCLE_LLM_API_KEY — no value provided"
  fi

  # BOUCLE_LLM_BASE_URL (var, not secret)
  LLM_BASE_URL="${BOUCLE_LLM_BASE_URL:-https://ollama.com/v1}"
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_LLM_BASE_URL --repo \"$PROJECT_ID\" --body \"$LLM_BASE_URL\" 2>/dev/null"
  log_pass "BOUCLE_LLM_BASE_URL set to ${BOUCLE_LLM_BASE_URL:-default: https://ollama.com/v1} (vars)"

  # ── GitHub: DND variables ────────────────────────────────────────────

  # BOUCLE_DND_TZ
  DND_TZ_VALUE="${BOUCLE_DND_TZ:-$(detect_iana_tz)}"
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_DND_TZ --repo \"$PROJECT_ID\" --body \"$DND_TZ_VALUE\" 2>/dev/null"
  log_pass "BOUCLE_DND_TZ set to $DND_TZ_VALUE (vars)"

  # BOUCLE_DND_START (only when provided via env)
  if [ -n "${BOUCLE_DND_START:-}" ]; then
    run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_DND_START --repo \"$PROJECT_ID\" --body \"$BOUCLE_DND_START\" 2>/dev/null"
    log_pass "BOUCLE_DND_START set to $BOUCLE_DND_START (vars)"
  else
    log_skip "BOUCLE_DND_START (not provided — default 22:00 applies)"
  fi

  # BOUCLE_DND_END (only when provided via env)
  if [ -n "${BOUCLE_DND_END:-}" ]; then
    run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_DND_END --repo \"$PROJECT_ID\" --body \"$BOUCLE_DND_END\" 2>/dev/null"
    log_pass "BOUCLE_DND_END set to $BOUCLE_DND_END (vars)"
  else
    log_skip "BOUCLE_DND_END (not provided — default 07:00 applies)"
  fi

  # BOUCLE_DND_EXCLUDE_DAYS (only when provided via env)
  if [ -n "${BOUCLE_DND_EXCLUDE_DAYS:-}" ]; then
    run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_DND_EXCLUDE_DAYS --repo \"$PROJECT_ID\" --body \"$BOUCLE_DND_EXCLUDE_DAYS\" 2>/dev/null"
    log_pass "BOUCLE_DND_EXCLUDE_DAYS set to $BOUCLE_DND_EXCLUDE_DAYS (vars)"
  else
    log_skip "BOUCLE_DND_EXCLUDE_DAYS (not provided — no excluded days)"
  fi

  # ── GitHub: fallback provider variables ───────────────────────────────

  # BOUCLE_FALLBACK_PROVIDER — GitHub rejects empty variable values (HTTP 422),
  # so skip the variable entirely when unset; the engine treats a missing
  # variable the same as an empty one (fallback disabled by default).
  if [ -n "${BOUCLE_FALLBACK_PROVIDER:-}" ]; then
    run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_FALLBACK_PROVIDER --repo \"$PROJECT_ID\" --body \"$BOUCLE_FALLBACK_PROVIDER\" 2>/dev/null"
    log_pass "BOUCLE_FALLBACK_PROVIDER set to '$BOUCLE_FALLBACK_PROVIDER' (vars)"
  else
    log_skip "BOUCLE_FALLBACK_PROVIDER (empty — fallback disabled by default; set a provider + BOUCLE_FALLBACK_API_KEY to enable)"
  fi

  # BOUCLE_FALLBACK_MODEL_TRIAGE
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_FALLBACK_MODEL_TRIAGE --repo \"$PROJECT_ID\" --body \"${BOUCLE_FALLBACK_MODEL_TRIAGE:-glm-5.2}\" 2>/dev/null"
  log_pass "BOUCLE_FALLBACK_MODEL_TRIAGE set to ${BOUCLE_FALLBACK_MODEL_TRIAGE:-glm-5.2} (vars)"

  # BOUCLE_FALLBACK_MODEL_WORKER
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_FALLBACK_MODEL_WORKER --repo \"$PROJECT_ID\" --body \"${BOUCLE_FALLBACK_MODEL_WORKER:-deepseek-v4-flash}\" 2>/dev/null"
  log_pass "BOUCLE_FALLBACK_MODEL_WORKER set to ${BOUCLE_FALLBACK_MODEL_WORKER:-deepseek-v4-flash} (vars)"

  # BOUCLE_FALLBACK_MODEL_REVIEWER
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_FALLBACK_MODEL_REVIEWER --repo \"$PROJECT_ID\" --body \"${BOUCLE_FALLBACK_MODEL_REVIEWER:-glm-5.2}\" 2>/dev/null"
  log_pass "BOUCLE_FALLBACK_MODEL_REVIEWER set to ${BOUCLE_FALLBACK_MODEL_REVIEWER:-glm-5.2} (vars)"

  # BOUCLE_FALLBACK_MODEL_E2E
  run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_FALLBACK_MODEL_E2E --repo \"$PROJECT_ID\" --body \"${BOUCLE_FALLBACK_MODEL_E2E:-deepseek-v4-flash}\" 2>/dev/null"
  log_pass "BOUCLE_FALLBACK_MODEL_E2E set to ${BOUCLE_FALLBACK_MODEL_E2E:-deepseek-v4-flash} (vars)"

  # BOUCLE_ALLOWED_USERS (issue allow-list — safety net)
  ALLOWED_USERS_VALUE="${BOUCLE_ALLOWED_USERS:-}"
  if [ -z "$ALLOWED_USERS_VALUE" ]; then
    # Default: the user who runs setup (the installer).
    ALLOWED_USERS_VALUE=$(gh api user --jq .login 2> /dev/null || true)
  fi
  if [ -n "$ALLOWED_USERS_VALUE" ]; then
    run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_ALLOWED_USERS --repo \"$PROJECT_ID\" --body \"$ALLOWED_USERS_VALUE\" 2>/dev/null"
    log_pass "BOUCLE_ALLOWED_USERS set to '$ALLOWED_USERS_VALUE' (vars) — only these users' issues are accepted"
  else
    log_skip "BOUCLE_ALLOWED_USERS (could not resolve the installer username — leave unset = no allow list, or set BOUCLE_ALLOWED_USERS)"
  fi

  # BOUCLE_FALLBACK_BASE_URL (masked secret — only when provided via env)
  if [ -n "${BOUCLE_FALLBACK_BASE_URL:-}" ]; then
    if [ "$DRY_RUN" = "true" ]; then
      echo "  [dry-run] set BOUCLE_FALLBACK_BASE_URL (secret, masked) — value omitted"
    else
      echo "$BOUCLE_FALLBACK_BASE_URL" | GH_TOKEN="$BOT_TOKEN" gh secret set BOUCLE_FALLBACK_BASE_URL --repo "$PROJECT_ID" 2> /dev/null
    fi
    log_pass "BOUCLE_FALLBACK_BASE_URL set (secrets, masked)"
  else
    log_skip "BOUCLE_FALLBACK_BASE_URL (not provided — must be set manually when fallback is enabled)"
  fi

  # BOUCLE_FALLBACK_API_KEY (masked secret — only when provided via env)
  if [ -n "${BOUCLE_FALLBACK_API_KEY:-}" ]; then
    if [ "$DRY_RUN" = "true" ]; then
      echo "  [dry-run] set BOUCLE_FALLBACK_API_KEY (secret, masked) — value omitted"
    else
      echo "$BOUCLE_FALLBACK_API_KEY" | GH_TOKEN="$BOT_TOKEN" gh secret set BOUCLE_FALLBACK_API_KEY --repo "$PROJECT_ID" 2> /dev/null
    fi
    log_pass "BOUCLE_FALLBACK_API_KEY set (secrets, masked)"
  else
    log_skip "BOUCLE_FALLBACK_API_KEY (not provided — must be set manually when fallback is enabled)"
  fi

  # ── GitHub: bot account (PAT identity) ───────────────────────────────
  # GitHub has no project service accounts: the --bot-token PAT *is* the
  # bot. Resolve which account it belongs to so the user knows who boucle
  # acts as, seed BOUCLE_BOT_USERNAME with that login (the loop detects the
  # bot's own comments by it — a wrong value makes the loop treat the bot's
  # comments as human replies), and warn when the account is not yet a
  # collaborator of the repository.
  GH_LOGIN=""
  if [ -n "$BOT_TOKEN" ]; then
    GH_ME=$(GH_TOKEN="$BOT_TOKEN" gh api user 2> /dev/null || true)
    GH_LOGIN=$(echo "$GH_ME" | jq -r '.login // empty' 2> /dev/null || true)
    if [ -n "$GH_LOGIN" ] && [ "$GH_LOGIN" != "null" ]; then
      if [ "$MONO_USER" = "true" ]; then
        # Seeding the human's own login here is exactly what makes the loop
        # deaf: dispatch's actor guard would then discard every action the
        # human takes. Mono-user mode filters boucle's own writes by the
        # agent marker instead, so the name must stay unset.
        log_skip "BOUCLE_BOT_USERNAME not seeded (--mono-user) — boucle acts as @$GH_LOGIN and"
        log_skip "  recognises its own comments by the <!-- boucle:agent --> marker, not by identity."
      elif [ "$BOT_USERNAME" != "$GH_LOGIN" ] && [ "$BOT_USERNAME" != "up-bot" ]; then
        log_skip "BOUCLE_BOT_USERNAME stays '$BOT_USERNAME' (--bot-username) — resolved PAT login is '@$GH_LOGIN'"
      else
        BOT_USERNAME="$GH_LOGIN"
        run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_BOT_USERNAME --repo \"$PROJECT_ID\" --body \"$BOT_USERNAME\" 2>/dev/null"
        log_pass "BOUCLE_BOT_USERNAME set to '$BOT_USERNAME' (vars) — boucle acts as @$GH_LOGIN"
      fi
      if GH_TOKEN="$BOT_TOKEN" gh api "/repos/$PROJECT_ID/collaborators/$GH_LOGIN" > /dev/null 2>&1; then
        log_pass "bot @$GH_LOGIN is a collaborator of $PROJECT_ID"
      else
        log_skip "bot @$GH_LOGIN is not a collaborator of $PROJECT_ID — add it under"
        log_skip "  Settings → Collaborators → Add people (write access), then re-run bin/setup."
      fi
    else
      GH_LOGIN=""
      log_fail "BOUCLE_TOKEN (--bot-token) is invalid or expired — 'gh api user' failed.
              Create a new PAT at https://github.com/settings/tokens/new with scopes
              'repo' + 'workflow' (see
              https://docs.github.com/apps/oauth-apps/building-oauth-apps/scopes-for-oauth-apps),
              then re-run bin/setup with --bot-token <new-pat> (or export BOUCLE_TOKEN)."
    fi
  else
    log_skip "bot account (no --bot-token provided)"
  fi
fi

echo ""

# ── 2. Labels ─────────────────────────────────────────────────────────
echo "=== Labels ==="

if [ "$FORGE" = "gitlab" ]; then
  # boucle:* labels (12) — boucle:approved and boucle:spec-approved removed
  # (dead labels: MR approval is the native forge Approve button, spec
  # approval is a reply/emoji on boucle:spec-review — neither uses a label).
  # shellcheck disable=SC1010 # 'done' is a label name, not the loop keyword
  for label in triage needs-info todo working review human blocked done split approval spec-review merging board; do
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/labels?search=boucle:$label" 2> /dev/null | jq -r '.[0].name // empty' || true)
    if [ -n "$EXISTING" ]; then
      log_skip "boucle:$label already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/labels -f name=boucle:$label -f color=#0033CC -f 'description=boucle state: $label' >/dev/null"
      log_pass "boucle:$label created"
    fi
  done

  # size:* labels (3)
  for size in s m l; do
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/labels?search=size:$size" 2> /dev/null | jq -r '.[0].name // empty' || true)
    if [ -n "$EXISTING" ]; then
      log_skip "size:$size already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/labels -f name=size:$size -f color=#F0AD4E -f 'description=size: $size' >/dev/null"
      log_pass "size:$size created"
    fi
  done

  # boucle:autonomous
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/labels?search=boucle:autonomous" 2> /dev/null | jq -r '.[0].name // empty' || true)
  if [ -n "$EXISTING" ]; then
    log_skip "boucle:autonomous already exists"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/labels -f name=boucle:autonomous -f color=#6927C5 -f 'description=Flag: issue runs autonomously (spec gate auto-validated at triage)' >/dev/null"
    log_pass "boucle:autonomous created"
  fi

  # boucle:dnd
  EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/labels?search=boucle:dnd" 2> /dev/null | jq -r '.[0].name // empty' || true)
  if [ -n "$EXISTING" ]; then
    log_skip "boucle:dnd already exists"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/labels -f name=boucle:dnd -f color=#1A237E -f 'description=Flag: spec gate auto-validated by DND window at triage' >/dev/null"
    log_pass "boucle:dnd created"
  fi
else
  # GitHub: forge_label_create (idempotent, uses gh label create)
  # boucle:* labels (12) — same names/colors as GitLab (approved/spec-approved
  # removed: dead labels, see GitLab block comment above).
  # shellcheck disable=SC1010 # 'done' is a label name, not the loop keyword
  for label in triage needs-info todo working review human blocked done split approval spec-review merging board; do
    run "forge_label_create 'boucle:$label' '#0033CC'"
    log_pass "boucle:$label created"
  done

  # size:* labels (3)
  for size in s m l; do
    run "forge_label_create 'size:$size' '#F0AD4E'"
    log_pass "size:$size created"
  done

  # boucle:autonomous
  run "forge_label_create 'boucle:autonomous' '#6927C5'"
  log_pass "boucle:autonomous created"

  # boucle:dnd
  run "forge_label_create 'boucle:dnd' '#1A237E'"
  log_pass "boucle:dnd created"
fi

echo ""

# ── 3. Issue Board — GitLab only (GitHub doesn't have issue boards) ───
if [ "$FORGE" = "gitlab" ]; then
  echo "=== Issue Board ==="

  BOARD_ID=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/boards" 2> /dev/null | jq -r '.[] | select(.name=="boucle") | .id' | head -1 || true)
  if [ -n "$BOARD_ID" ] && [ "$BOARD_ID" != "null" ]; then
    log_skip "boucle board already exists (ID: $BOARD_ID)"
  else
    BOARD_RESPONSE=$(run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/boards -f name=boucle")
    BOARD_ID=$(echo "$BOARD_RESPONSE" | jq -r '.id')
    if [ -n "$BOARD_ID" ] && [ "$BOARD_ID" != "null" ]; then
      log_pass "boucle board created (ID: $BOARD_ID)"
      # shellcheck disable=SC1010
      for label in triage needs-info todo working review human blocked done split approval spec-review merging board; do
        LABEL_ID=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/labels?search=boucle:$label" 2> /dev/null | jq -r '.[0].id' || true)
        if [ -n "$LABEL_ID" ] && [ "$LABEL_ID" != "null" ]; then
          run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/boards/$BOARD_ID/lists -f label_id=$LABEL_ID >/dev/null"
          log_pass "  list boucle:$label added"
        fi
      done
    else
      log_fail "boucle board creation failed"
    fi
  fi
  echo ""
fi

# ── 4. Branch Protection ─────────────────────────────────────────────
echo "=== Branch Protection ==="

if [ "$FORGE" = "gitlab" ]; then
  DEFAULT_BRANCH=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID" 2> /dev/null | jq -r '.default_branch' || true)
  if [ -z "$DEFAULT_BRANCH" ] || [ "$DEFAULT_BRANCH" = "null" ]; then
    log_fail "could not determine default branch"
    DEFAULT_BRANCH="main"
  fi

  PROTECTION=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/protected_branches/$DEFAULT_BRANCH" 2> /dev/null || true)
  if [ -n "$PROTECTION" ] && echo "$PROTECTION" | jq -e '.name' > /dev/null 2>&1; then
    MERGE_LEVEL=$(echo "$PROTECTION" | jq -r '.merge_access_levels[0].access_level // empty')
    PUSH_LEVEL=$(echo "$PROTECTION" | jq -r '.push_access_levels[0].access_level // empty')
    NEEDS_UPDATE=false
    if [ "$MERGE_LEVEL" != "40" ]; then
      echo "  ! $DEFAULT_BRANCH merge_access_level=$MERGE_LEVEL (expected 40)"
      NEEDS_UPDATE=true
    fi
    if [ "$PUSH_LEVEL" != "30" ]; then
      echo "  ! $DEFAULT_BRANCH push_access_level=$PUSH_LEVEL (expected 30 for bot push)"
      NEEDS_UPDATE=true
    fi
    if [ "$NEEDS_UPDATE" = "true" ]; then
      run "glab api --hostname $HOST -X DELETE /projects/$PROJECT_ID/protected_branches/$DEFAULT_BRANCH >/dev/null"
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/protected_branches -f name=$DEFAULT_BRANCH -f merge_access_level=40 -f push_access_level=30 >/dev/null"
      log_pass "$DEFAULT_BRANCH access levels updated (merge=Maintainer, push=Developer)"
    else
      log_skip "$DEFAULT_BRANCH protected (merge=Maintainer, push=Developer)"
    fi
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/protected_branches -f name=$DEFAULT_BRANCH -f merge_access_level=40 -f push_access_level=30 >/dev/null"
    log_pass "$DEFAULT_BRANCH protected (merge=Maintainer, push=Developer)"
  fi
else
  # GitHub: use forge_branch_protect
  # Detect default branch
  GH_INFO=$(forge_project_get 2> /dev/null || echo '{"default_branch":"main"}')
  DEFAULT_BRANCH=$(echo "$GH_INFO" | jq -r '.default_branch // "main"' 2> /dev/null || echo "main")
  run "forge_branch_protect '$DEFAULT_BRANCH' 30 40"
  log_pass "$DEFAULT_BRANCH protected (required PR reviews, no direct push)"
fi

echo ""

# ── 5. Bot Member — GitLab only (GitHub uses the PAT directly) ───────
if [ "$FORGE" = "gitlab" ]; then
  echo "=== Bot Member ==="

  # ── 5a. Create the bot as a project service account ──────────────────
  # The install creates the bot as part of setup — it must NOT be a separate
  # manual step. A project owner can provision a project service account via
  # the API (no platform-admin needed, GitLab 16+). If the API is unavailable
  # (feature flag off, 403/404), fall back to the manual instructions printed
  # in the summary below.
  BOT_IS_SERVICE_ACCOUNT=false
  if [ -z "$BOT_ID" ]; then
    # Idempotence: a bot already wired via BOUCLE_BOT_ID is reused, and a
    # pre-existing project service account is reused too — re-running setup
    # never creates a duplicate bot.
    EXISTING_BOT_ID_VAR=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_BOT_ID" 2> /dev/null | jq -r '.value // empty' || true)
    if [ -n "$EXISTING_BOT_ID_VAR" ] && [ "$EXISTING_BOT_ID_VAR" != "null" ]; then
      BOT_ID="$EXISTING_BOT_ID_VAR"
      log_skip "bot already wired (BOUCLE_BOT_ID=$BOT_ID) — reusing"
    else
      EXISTING_SA=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/service_accounts" 2> /dev/null || true)
      SA_ID=$(echo "$EXISTING_SA" | jq -r '.[0].id // empty' 2> /dev/null || true)
      if [ -n "$SA_ID" ] && [ "$SA_ID" != "null" ]; then
        BOT_ID="$SA_ID"
        BOT_USERNAME=$(echo "$EXISTING_SA" | jq -r '.[0].username // empty' 2> /dev/null || true)
        BOT_IS_SERVICE_ACCOUNT=true
        log_skip "existing project service account reused (ID: $BOT_ID, username: ${BOT_USERNAME:-?})"
      else
        SA_RESPONSE=$(run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/service_accounts" 2> /dev/null) || SA_RESPONSE=""
        SA_NEW_ID=$(echo "$SA_RESPONSE" | jq -r '.id // empty' 2> /dev/null || true)
        if [ -n "$SA_NEW_ID" ] && [ "$SA_NEW_ID" != "null" ]; then
          BOT_ID="$SA_NEW_ID"
          BOT_USERNAME=$(echo "$SA_RESPONSE" | jq -r '.username // empty' 2> /dev/null || true)
          BOT_IS_SERVICE_ACCOUNT=true
          log_pass "bot service account created (ID: $BOT_ID, username: ${BOT_USERNAME:-?})"
        elif [ "$DRY_RUN" = "true" ]; then
          log_skip "bot service account creation (dry-run)"
        else
          log_skip "could not create a bot service account via the API (feature flag off or endpoint 403/404) —"
          log_skip "  create it manually under Project → Settings → Service accounts, then re-run:"
          log_skip "  bin/setup --bot-id <id> --bot-username <username> --bot-token <pat>"
        fi
      fi
    fi

    # Best-effort: request an API token (scope: api) for the service account
    # so BOUCLE_TOKEN is seeded too. Not fatal on failure — the PAT can be
    # created manually in the UI.
    if [ "$BOT_IS_SERVICE_ACCOUNT" = "true" ] && [ -z "$BOT_TOKEN" ]; then
      PAT_RESPONSE=$(run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/service_accounts/$BOT_ID/personal_access_tokens -f name=boucle -f 'scopes[]=api'" 2> /dev/null) || PAT_RESPONSE=""
      NEW_TOKEN=$(echo "$PAT_RESPONSE" | jq -r '.token // empty' 2> /dev/null || true)
      if [ -n "$NEW_TOKEN" ] && [ "$NEW_TOKEN" != "null" ]; then
        BOT_TOKEN="$NEW_TOKEN"
        log_pass "service account PAT created (name: boucle, scope: api)"
      elif [ "$DRY_RUN" = "true" ]; then
        log_skip "service account PAT creation (dry-run)"
      else
        log_skip "could not create a PAT for the service account — create one manually under"
        log_skip "  Project → Settings → Service accounts, then re-run:"
        log_skip "  bin/setup --bot-id $BOT_ID --bot-token <pat>"
      fi
    fi
  fi

  if [ -n "$BOT_ID" ]; then
    if [ "$BOT_IS_SERVICE_ACCOUNT" = "true" ]; then
      log_skip "bot (ID: $BOT_ID) is a project service account — already a project member"
    else
      EXISTING_MEMBER=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/members/all?user_ids=$BOT_ID" 2> /dev/null | jq -r '[.[] | .access_level] | max // empty' || true)
      if [ -n "$EXISTING_MEMBER" ]; then
        if [ "$EXISTING_MEMBER" -ge 30 ]; then
          log_skip "bot (ID: $BOT_ID) already member (access_level=$EXISTING_MEMBER)"
        else
          run "glab api --hostname $HOST -X PUT /projects/$PROJECT_ID/members/$BOT_ID -f access_level=30 >/dev/null"
          log_pass "bot (ID: $BOT_ID) access level updated to Developer"
        fi
      else
        run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/members -f user_id=$BOT_ID -f access_level=30 >/dev/null"
        log_pass "bot (ID: $BOT_ID) added as Developer"
      fi
    fi
  else
    log_skip "bot member (no --bot-id provided)"
  fi

  # ── 5b. Bot ID + Username CI variables ───────────────────────────────
  echo "=== Bot CI Variables ==="

  if [ -n "$BOT_ID" ]; then
    EXISTING_BOT_ID_VAR=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_BOT_ID" 2> /dev/null | jq -r '.value // empty' || true)
    if [ "$EXISTING_BOT_ID_VAR" = "$BOT_ID" ]; then
      log_skip "BOUCLE_BOT_ID CI variable (already $BOT_ID)"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_BOT_ID -f value=$BOT_ID -f masked=false -f protected=false >/dev/null"
      log_pass "BOUCLE_BOT_ID CI variable set to $BOT_ID"
    fi
  else
    log_skip "BOUCLE_BOT_ID CI variable (no --bot-id provided; before_script will resolve by username)"
  fi

  EXISTING_BOT_USERNAME_VAR=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_BOT_USERNAME" 2> /dev/null | jq -r '.value // empty' || true)
  if [ "$EXISTING_BOT_USERNAME_VAR" = "$BOT_USERNAME" ]; then
    log_skip "BOUCLE_BOT_USERNAME CI variable (already $BOT_USERNAME)"
  else
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_BOT_USERNAME -f value=$BOT_USERNAME -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_BOT_USERNAME CI variable set to $BOT_USERNAME"
  fi

  # BOUCLE_MONO_USER — one account owns both the issues and the loop.
  if [ "$MONO_USER" = "true" ]; then
    run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_MONO_USER -f value=true -f masked=false -f protected=false >/dev/null"
    log_pass "BOUCLE_MONO_USER CI variable set to true"
  fi

  # BOUCLE_TOKEN — from --bot-token (section 1) or from the service-account
  # PAT created above.
  if [ -n "$BOT_TOKEN" ]; then
    EXISTING_TOKEN_VAR=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_TOKEN" 2> /dev/null | jq -r '.key // empty' || true)
    if [ -n "$EXISTING_TOKEN_VAR" ]; then
      log_skip "BOUCLE_TOKEN already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_TOKEN -f value='$BOT_TOKEN' -f masked=true -f protected=true >/dev/null"
      log_pass "BOUCLE_TOKEN CI variable set (bot PAT)"
    fi
  else
    log_skip "BOUCLE_TOKEN CI variable (no bot PAT available)"
  fi

  echo ""
fi

# ── 6. Trigger Token — GitLab only ────────────────────────────────────
if [ "$FORGE" = "gitlab" ]; then
  echo "=== Trigger Token ==="

  TRIGGER_TOKEN=""
  EXISTING_TRIGGERS=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/triggers" 2> /dev/null || true)
  BOUCLE_TRIGGER=$(echo "$EXISTING_TRIGGERS" | jq -r '.[] | select(.description=="boucle-loop") | .token' | head -1)
  if [ -n "$BOUCLE_TRIGGER" ]; then
    TRIGGER_TOKEN="$BOUCLE_TRIGGER"
    log_skip "trigger token already exists"
  else
    TRIGGER_RESPONSE=$(run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/triggers -f description=boucle-loop")
    TRIGGER_TOKEN=$(echo "$TRIGGER_RESPONSE" | jq -r '.token')
    if [ -n "$TRIGGER_TOKEN" ] && [ "$TRIGGER_TOKEN" != "null" ]; then
      log_pass "trigger token created"
    else
      log_fail "trigger token creation failed (needs Owner access)"
    fi
  fi

  if [ -n "$TRIGGER_TOKEN" ] && [ "$TRIGGER_TOKEN" != "null" ]; then
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_TRIGGER_TOKEN" 2> /dev/null | jq -r '.key // empty' || true)
    if [ -n "$EXISTING" ]; then
      log_skip "BOUCLE_TRIGGER_TOKEN CI variable already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_TRIGGER_TOKEN -f value=$TRIGGER_TOKEN -f masked=true -f protected=true >/dev/null"
      log_pass "BOUCLE_TRIGGER_TOKEN stored as CI variable"
    fi
  fi

  echo ""
fi

# ── 7. Webhook — GitLab only (GitHub uses workflow as receiver) ──────
if [ "$FORGE" = "gitlab" ]; then
  echo "=== Webhook ==="

  if [ -n "$TRIGGER_TOKEN" ] && [ "$TRIGGER_TOKEN" != "null" ]; then
    WEBHOOK_URL="https://$HOST/api/v4/projects/$PROJECT_ID/trigger/pipeline?token=$TRIGGER_TOKEN&ref=$DEFAULT_BRANCH"

    EXISTING_WEBHOOK=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/hooks" 2> /dev/null | jq -r '.[] | select(.url | contains("trigger/pipeline")) | .id' | head -1 || true)
    if [ -n "$EXISTING_WEBHOOK" ]; then
      HOOK_CONFIG=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/hooks/$EXISTING_WEBHOOK" 2> /dev/null || true)
      if echo "$HOOK_CONFIG" | jq -e '.emoji_events == true or .push_events == true or .pipeline_events == true or .tag_push_events == true or .wiki_page_events == true or .deployment_events == true or .release_events == true' > /dev/null 2>&1; then
        configure_webhook "$EXISTING_WEBHOOK" "$WEBHOOK_URL"
      else
        log_skip "webhook (ID: $EXISTING_WEBHOOK) already configured — only Issue/Note/MR events"
      fi
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/hooks -f \"url=$WEBHOOK_URL\" -f issues_events=true -f note_events=true -f merge_requests_events=true -f push_events=false -f tag_push_events=false -f pipeline_events=false -f wiki_page_events=false -f deployment_events=false -f release_events=false -f emoji_events=false -f job_events=false -f confidential_issues_events=false -f confidential_note_events=false >/dev/null"
      log_pass "webhook configured (Issue + Note + Merge Request events only; amplification events disabled)"
    fi
  else
    log_skip "webhook (no trigger token)"
  fi

  echo ""
fi

# ── 8. Cloudflare Pages Project — forge-agnostic, opt-in ──────────────
# Cloudflare is NOT the default deploy target. The setup skips CF Pages
# project creation unless --cf-token is explicitly provided. Configure
# your deploy target via BOUCLE_DEPLOY_PROVIDER (gitlab-pages, github-pages,
# external, self) instead.
echo "=== Cloudflare Pages Project ==="

if [ -z "$CF_TOKEN" ]; then
  log_skip "CF Pages project (no --cf-token provided — Cloudflare is opt-in, not the default)"
elif [ -n "$CF_TOKEN" ]; then
  export CLOUDFLARE_API_TOKEN="$CF_TOKEN"
  CF_PROJECT_NAME="${CF_PROJECT_NAME:-$(echo "$PROJECT" | sed 's|.*/||' | sed 's/\.[a-z]*$//')}"
  if npx wrangler pages project list 2> /dev/null | grep -q "$CF_PROJECT_NAME"; then
    log_skip "CF Pages project already exists"
  else
    run "npx wrangler pages project create $CF_PROJECT_NAME --production-branch $DEFAULT_BRANCH >/dev/null 2>&1"
    if [ $? -eq 0 ]; then
      log_pass "CF Pages project '$CF_PROJECT_NAME' created"
    else
      log_fail "CF Pages project creation failed"
    fi
  fi
  # Store the CF Pages project name as BOUCLE_DEPLOY_PROJECT CI variable/secret
  if [ "$FORGE" = "gitlab" ]; then
    EXISTING=$(glab api --hostname "$HOST" "/projects/$PROJECT_ID/variables/BOUCLE_DEPLOY_PROJECT" 2> /dev/null | jq -r '.key // empty' || true)
    if [ -n "$EXISTING" ]; then
      log_skip "BOUCLE_DEPLOY_PROJECT already exists"
    else
      run "glab api --hostname $HOST -X POST /projects/$PROJECT_ID/variables -f key=BOUCLE_DEPLOY_PROJECT -f value=$CF_PROJECT_NAME -f masked=false -f protected=false >/dev/null"
      log_pass "BOUCLE_DEPLOY_PROJECT set to '$CF_PROJECT_NAME'"
    fi
  else
    # GitHub: use variable
    run "GH_TOKEN=\"$BOT_TOKEN\" gh variable set BOUCLE_DEPLOY_PROJECT --repo \"$PROJECT_ID\" --body \"$CF_PROJECT_NAME\" 2>/dev/null"
    log_pass "BOUCLE_DEPLOY_PROJECT set to '$CF_PROJECT_NAME' (vars)"
  fi
else
  log_skip "CF Pages project (no --cf-token)"
fi

echo ""

# ── 9. .boucle-version — GitHub only (GitLab uses CI mirror) ─────────
if [ "$FORGE" = "github" ]; then
  echo "=== .boucle-version ==="

  # Check if .boucle-version already exists in the repo
  FILE_CHECK=$(GH_TOKEN="$BOT_TOKEN" gh api "/repos/$PROJECT_ID/contents/.boucle-version" 2> /dev/null || true)
  if echo "$FILE_CHECK" | jq -e '.content' > /dev/null 2>&1; then
    log_skip ".boucle-version already exists"
  else
    BOUCLE_VERSION_CONTENT=$(echo -n '0.0.0' | base64 -w0 2> /dev/null || echo -n '0.0.0' | base64)
    run "GH_TOKEN=\"$BOT_TOKEN\" gh api -X PUT /repos/$PROJECT_ID/contents/.boucle-version -f message='init' -f content=\"$BOUCLE_VERSION_CONTENT\" >/dev/null 2>&1"
    log_pass ".boucle-version created (0.0.0)"
  fi
  echo ""
fi

# ── Summary ───────────────────────────────────────────────────────────
echo "=== Summary ==="
echo "  Passed: $PASS"
echo "  Skipped: $SKIP"
echo "  Failed: $FAIL"
echo ""

if [ "$FAIL" -gt 0 ]; then
  echo "Some steps failed. Check output above." >&2
  exit 1
fi

echo "Day 0 setup complete."
echo ""

if [ "$MONO_USER" = "true" ]; then
  echo "Mono-user mode is on — one account owns the issues and the loop."
  echo ""
  echo "  Notifications are degraded, and this is the one thing setup cannot fix for you."
  echo "  The forge signals 'it's your turn' by changing an issue's assignee, but the issue"
  echo "  is already yours, so nothing is emitted. Worse, every action the loop takes runs"
  echo "  under your own token, and forges do not notify you about your own activity."
  echo ""
  echo "  To be notified at all, turn on own-activity notifications, once:"
  if [ "$FORGE" = "github" ]; then
    echo "    GitHub → Settings → Notifications → check 'Include your own updates'"
    echo "             https://github.com/settings/notifications"
  else
    echo "    GitLab → Preferences → Notifications → check"
    echo "             'Receive notifications about your own activity'"
  fi
  echo "  It is account-wide, so expect noise from the loop's routine comments."
  echo ""
  echo "  Prefer a dedicated bot identity when you can — re-run without --mono-user."
  echo ""
fi

if [ "$FORGE" = "gitlab" ]; then
  echo "Next steps:"
  echo "  1. Make the engine a git submodule (if not already done):"
  echo "     git submodule add https://github.com/ankaboot-source/boucle .boucle"
  echo "  2. Commit the engine and the root shim:"
  echo "     git add .gitmodules .boucle $GITLAB_CI"
  echo "     git commit -m \"chore: install boucle engine\""
  echo "     (Push the commit — the runner needs GIT_SUBMODULE_STRATEGY to fetch .boucle/.)"
  if [ -n "$RUNNER_TAG" ]; then
    echo "  3. Runner: make sure a GitLab runner with tag '$RUNNER_TAG' is available."
    echo "     (The tag is baked into $GITLAB_CI. Re-run with --runner-tag <tag> to change it,"
    echo "     or remove the 'default: tags:' block from $GITLAB_CI to use shared runners.)"
  else
    echo "  3. Runner: nothing to do — jobs run untagged on this instance's shared runners."
    echo "     (To pin them to your own runner instead, re-run with --runner-tag <tag>.)"
  fi
  if [ -n "${CI_VARS_URL:-}" ]; then
    echo "  4. CI/CD variables: $CI_VARS_URL"
    echo "     - BOUCLE_LLM_API_KEY (masked) if bin/setup skipped it."
  else
    echo "  4. CI/CD variables: add BOUCLE_LLM_API_KEY (masked) under Settings > CI/CD."
  fi
  echo "  5. Create your first issue — the webhook will trigger triage."
  if [ -z "$BOT_ID" ]; then
    echo ""
    echo "  NOTE: no --bot-id was provided and the service-account API could not"
    echo "  create a bot (feature flag off, or the endpoint 403/404 on this"
    echo "  GitLab). boucle reassigns issues to the bot (assignee_ids[]) and"
    echo "  merges MRs as it — without an account, issues stay assigned to the"
    echo "  current user and the loop still runs. To use a dedicated bot:"
    echo "    1. Create the bot via Project → Settings → Service accounts"
    echo "       (no platform-admin needed — a project owner can provision it)."
    echo "    2. Create a PAT for the bot (scope: api) and note its user ID."
    echo "    3. Re-run: bin/setup --bot-id <id> --bot-token <pat>"
  fi
  if [ "${BOT_IS_SERVICE_ACCOUNT:-false}" = "true" ]; then
    echo "  Bot: project service account '${BOT_USERNAME:-?}' created and wired as Developer —"
    echo "       boucle comments, reassigns issues, and merges MRs as this account."
  fi

  print_webhook_recommendations
else
  echo "Next steps:"
  echo "  1. Make the engine a git submodule (if not already done):"
  echo "     git submodule add https://github.com/ankaboot-source/boucle .boucle"
  echo "  2. Commit the engine, the workflow, and the root files:"
  echo "     git add .gitmodules .boucle .github/workflows/boucle.yml"
  echo "     git commit -m \"chore: install boucle engine\""
  echo "  3. Runner: by default boucle uses GitHub-hosted runners (ubuntu-latest)."
  echo "     To use your own self-hosted runner instead, set the repo variable"
  echo "     BOUCLE_RUNS_ON to '[\"self-hosted\", \"<label>\"]' and register a runner"
  echo "     with that label (Settings > Actions > Runners)."
  echo "  4. Repository variables and secrets should now be set in"
  echo "     Settings > Secrets and variables > Actions."
  echo "  5. Create your first issue — boucle will pick it up via the workflow trigger."
  if [ -n "${BOT_TOKEN:-}" ]; then
    echo "  6. (Optional) Set BOUCLE_LLM_API_KEY as a repo secret if bin/setup skipped it."
  fi
  echo ""
  echo "  NOTE: GitHub does not need a trigger token, webhook, or issue board —"
  echo "  the workflow itself acts as the receiver and GitHub labels serve as the board."
  if [ -n "${GH_LOGIN:-}" ]; then
    echo "  Bot: boucle acts as @$GH_LOGIN (resolved from the BOUCLE_TOKEN PAT)."
  fi
fi

# ── Configuration readiness (#41) ─────────────────────────────────────
# Print the audit here so a fresh install reports what is still missing
# BEFORE the first issue, rather than one failed run at a time. Never fails
# the install: setup has already done its work, and a blocker here is a
# variable the operator sets in the forge UI afterwards.
if [ -x "$(dirname "$0")/doctor" ]; then
  echo ""
  "$(dirname "$0")/doctor" --audit || true
fi

exit 0
