#!/usr/bin/env bash
# bin/boucle-ci — Forge-agnostic CI stage dispatcher.
# Usage: boucle-ci <stage> [args...]
#
# Sources lib/boucle-ci.sh which defines stage functions,
# then calls the requested stage function.
set -euo pipefail

BOUCLE_HOME="${BOUCLE_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
export BOUCLE_HOME

# shellcheck source=../lib/boucle-ci.sh
. "$BOUCLE_HOME/lib/boucle-ci.sh"

STAGE="${1:-}"
shift || true

if [ -z "$STAGE" ]; then
  echo "Usage: $0 <stage> [args...]" >&2
  echo "Stages: check dispatch triage worker reviewer retro merger post-merge catchup automerge deploy e2e doctor doctor-opportunistic cmd-log cmd-status cmd-help" >&2
  exit 1
fi

# Map stage name to function name.
FUNC="boucle_ci_${STAGE//-/_}"

if ! declare -F "$FUNC" > /dev/null 2>&1; then
  echo "Unknown stage: $STAGE (function $FUNC not found)" >&2
  exit 1
fi

# ── Metrics liveness heartbeat ────────────────────────────────────────────
# Every LOOP RUN — a stage that does work on the board — appends one heartbeat
# row to the metrics branch when metrics are enabled. It proves the credential,
# the branch and the push path work independently of any issue's terminal
# state: the publish path is fail-open, so without this a collector that was
# never wired, or whose pushes always fail, leaves no trace anywhere.
#
# Scope is deliberately the work stages only: `check` is a lint gate and
# `cmd-*` are human commands, not loop runs. Fail-open by contract — the helper
# never fails and is never the reason a stage does not start.
case "$STAGE" in
  dispatch | triage | worker | reviewer | e2e | merger | post-merge | catchup | automerge | doctor | doctor-opportunistic | retro)
    # A local `bin/boucle-ci <stage>` has no CI job id and MUST NOT push to
    # the consumer's metrics branch; BOUCLE_JOB_ID is 0 outside CI.
    if [ "${BOUCLE_JOB_ID:-0}" != "0" ]; then
      boucle_metrics_heartbeat "$STAGE" || true
    fi
    ;;
esac

"$FUNC" "$@"
