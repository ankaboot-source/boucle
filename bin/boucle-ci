#!/usr/bin/env bash
# bin/boucle-ci — Forge-agnostic CI stage dispatcher.
# Usage: boucle-ci <stage> [args...]
#
# Sources lib/boucle-ci.sh which defines stage functions,
# then calls the requested stage function.
set -euo pipefail

BOUCLE_HOME="${BOUCLE_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
export BOUCLE_HOME

# shellcheck source=../lib/boucle-ci.sh
. "$BOUCLE_HOME/lib/boucle-ci.sh"

STAGE="${1:-}"
shift || true

if [ -z "$STAGE" ]; then
  echo "Usage: $0 <stage> [args...]" >&2
  echo "Stages: check dispatch triage worker reviewer retro merger post-merge catchup automerge deploy e2e doctor doctor-opportunistic cmd-log cmd-status cmd-help" >&2
  exit 1
fi

# Map stage name to function name.
FUNC="boucle_ci_${STAGE//-/_}"

if ! declare -F "$FUNC" > /dev/null 2>&1; then
  echo "Unknown stage: $STAGE (function $FUNC not found)" >&2
  exit 1
fi

# ── Metrics liveness ─────────────────────────────────────────────────────────
# Every loop stage proves the metrics path (credential, branch, push) with one
# heartbeat row, independently of any issue reaching a terminal state. Without
# it, a collector that was never wired is invisible: the retro can only see the
# ABSENCE of issue rows, which a genuinely quiet window produces too (see
# boucle_metrics_heartbeat in lib/boucle.sh).
#
# Gated on a CI job id so a local `bin/boucle-ci <stage>` never pushes a row to
# the consumer's metrics branch, and skipped for stages that are not loop runs
# (`check` is lint, `cmd-*` is the interactive operator surface). Fail-open:
# the heartbeat must never be what stops a stage.
case "$STAGE" in
  check | cmd-*) ;;
  *)
    if [ "${BOUCLE_JOB_ID:-0}" != "0" ]; then
      boucle_metrics_heartbeat "$STAGE" || true
    fi
    ;;
esac

"$FUNC" "$@"
