#!/usr/bin/env bash
# bin/check-design-charter — validate a consumer site's design charter file
# Called by the worker before any UI work (see .jcode/agents/worker.md).
#
# Usage:
#   bin/check-design-charter [path/to/DESIGN.md]
#
# Validates the DESIGN-template structure (see .jcode/DESIGN-template.md):
#   - required sections 1-4 present (5-7 recommended, warned only)
#   - all 7 required color tokens present in the Colors table
#   - no placeholder values (all-identical colors, <...> fill-ins)
#   - contrast rules cited (4.5:1 / 3:1)
#   - Typography / Spacing / Motion sections non-empty
#
# Exit codes:
#   0 — PASS (warnings allowed)
#   1 — FAIL (issues found)
#   2 — usage error or unreadable charter
#
# Override the default charter path with BOUCLE_CHARTER (default: DESIGN.md).
set -u

CHARTER="${1:-${BOUCLE_CHARTER:-DESIGN.md}}"
if [ ! -r "${CHARTER}" ]; then
  echo "[check-design-charter] ERROR: cannot read charter: ${CHARTER}" >&2
  exit 2
fi

ISSUES=0
WARNINGS=0

fail() {
  echo "  ✗ $1" >&2
  ISSUES=$((ISSUES + 1))
}

warn() {
  echo "  ⚠ $1" >&2
  WARNINGS=$((WARNINGS + 1))
}

# ── Required sections (1-4) ────────────────────────────────────────────

REQUIRED_SECTIONS=(
  "## 1. Product context"
  "## 2. Design tokens"
  "## 3. Motion"
  "## 4. Components"
)
for sec in "${REQUIRED_SECTIONS[@]}"; do
  grep -qF "${sec}" "${CHARTER}" || fail "missing required section: ${sec}"
done

# ── Recommended sections (5-7) — warned, not blocking ──────────────────

RECOMMENDED_SECTIONS=(
  "## 5. Content & tone"
  "## 6. Iconography"
  "## 7. Visual foundations"
)
for sec in "${RECOMMENDED_SECTIONS[@]}"; do
  grep -qF "${sec}" "${CHARTER}" || warn "recommended section missing: ${sec}"
done

# ── Required color tokens in the Colors table ──────────────────────────

REQUIRED_TOKENS="--surface-base --surface-raised --text-primary --text-secondary --accent --border --destructive"
for tok in ${REQUIRED_TOKENS}; do
  grep -qF "| \`${tok}\` |" "${CHARTER}" || fail "missing color token: ${tok}"
done

# ── Placeholder detection ──────────────────────────────────────────────

# All color tokens share one value → template placeholders not filled
COLOR_VALUE_COUNT=$(grep -E '^\| `--' "${CHARTER}" \
  | awk -F'|' '{gsub(/[ `]/, "", $3); print $3}' \
  | sort -u | wc -l | tr -d ' ')
if [ -n "${COLOR_VALUE_COUNT}" ] && [ "${COLOR_VALUE_COUNT}" -le 1 ]; then
  fail "all color tokens share one value (template placeholders not filled)"
fi

# Generic <...> fill-in placeholders
if grep -qE '<[^>]+>' "${CHARTER}"; then
  fail "placeholder values remain (<...> fill-ins present):"
  grep -nE '<[^>]+>' "${CHARTER}" | sed 's/^/      /' >&2
fi

# ── Contrast rules ─────────────────────────────────────────────────────

grep -q '4\.5:1' "${CHARTER}" || fail "contrast rule not cited (4.5:1)"
grep -q '3:1' "${CHARTER}" || fail "contrast rule not cited (3:1)"

# ── Section content (non-empty beyond the header) ──────────────────────

section_nonempty() {
  local header="$1"
  awk -v h="${header}" '
    $0 == h { insec = 1; next }
    insec && /^#/ { insec = 0 }
    insec && NF { found = 1 }
    END { exit found ? 0 : 1 }
  ' "${CHARTER}"
}

section_nonempty '### Typography' || fail "Typography section is empty"
section_nonempty '### Spacing & layout' || fail "Spacing & layout section is empty"
section_nonempty '## 3. Motion' || fail "Motion section is empty"

# ── Result ─────────────────────────────────────────────────────────────

if [ "${ISSUES}" -gt 0 ]; then
  echo "DESIGN CHARTER: FAIL — ${ISSUES} issue(s), ${WARNINGS} warning(s)"
  exit 1
fi
echo "DESIGN CHARTER: PASS — ${WARNINGS} warning(s)"
exit 0
