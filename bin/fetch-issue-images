#!/usr/bin/env bash
# bin/fetch-issue-images — downloads images attached to a GitLab issue
# Called before ./bin/oc <role> to make issue images available to agents.
#
# Policy: caps individual image size (BOUCLE_IMAGE_MAX_BYTES) and total
# downloaded size per issue (BOUCLE_IMAGE_TOTAL_MAX_BYTES). Images over
# the individual cap are skipped. Once the total cap is reached, remaining
# images are skipped.
#
# Output: writes .boucle/$ISSUE/.attachments.env (sourced by bin/oc) and
#         .boucle/$ISSUE/images/MANIFEST.md (human-readable log).
set -euo pipefail

ISSUE="${BOUCLE_ISSUE:?BOUCLE_ISSUE must be set}"
CI_PROJECT_DIR="${CI_PROJECT_DIR:-$(pwd)}"
STATE_DIR="$CI_PROJECT_DIR/.boucle/$ISSUE"
IMG_DIR="$STATE_DIR/images"
ENV_FILE="$STATE_DIR/.attachments.env"

# Size caps (defaults: 10 MiB per image, 50 MiB total per issue)
MAX_BYTES="${BOUCLE_IMAGE_MAX_BYTES:-10485760}"
TOTAL_MAX_BYTES="${BOUCLE_IMAGE_TOTAL_MAX_BYTES:-52428800}"

HOST="${BOUCLE_FORGE_HOST:-framagit.org}"
TOKEN="${BOUCLE_TOKEN:?BOUCLE_TOKEN must be set}"
PROJECT_ID="${CI_PROJECT_ID:?CI_PROJECT_ID must be set}"

mkdir -p "$IMG_DIR"
# Clean slate per run (re-download fresh each time)
rm -f "$IMG_DIR"/* "$ENV_FILE" 2>/dev/null || true

# Collect all markdown text from the issue description + all note bodies
ALL_TEXT=$(mktemp)
trap 'rm -f "$ALL_TEXT"' EXIT

{
  glab api --hostname "$HOST" "/projects/$PROJECT_ID/issues/$ISSUE" 2>/dev/null \
    | jq -r '.description // empty' 2>/dev/null || true
  glab api --hostname "$HOST" "/projects/$PROJECT_ID/issues/$ISSUE/notes" 2>/dev/null \
    | jq -r '.[].body // empty' 2>/dev/null || true
} > "$ALL_TEXT"

# Extract GitLab upload paths with image extensions.
# GitLab markdown references uploads as ![alt](/uploads/<hash>/<filename.ext>)
# We only download forge-hosted uploads (not arbitrary internet URLs) for safety.
mapfile -t UPLOAD_PATHS < <(
  grep -oiE "/uploads/[^[:space:]\"')]+\.(png|jpe?g|gif|webp|avif|svg)" "$ALL_TEXT" \
    | sort -u || true
)

if [ "${#UPLOAD_PATHS[@]}" -eq 0 ] || [ -z "${UPLOAD_PATHS[0]:-}" ]; then
  echo "[fetch-issue-images] No images found in issue #$ISSUE"
  printf 'BOUCLE_ISSUE_ATTACHMENTS=""\n' > "$ENV_FILE"
  exit 0
fi

downloaded_files=()
total_size=0
skipped_count=0
idx=0

for path in "${UPLOAD_PATHS[@]}"; do
  [ -z "$path" ] && continue
  idx=$((idx + 1))

  url="https://$HOST$path"
  filename=$(basename "$path")
  # Sanitize filename (alphanumeric, dot, dash, underscore only)
  filename=$(echo "$filename" | tr -cd '[:alnum:]._-')
  [ -z "$filename" ] && filename="image_${idx}.png"

  # Prefix with idx to guarantee uniqueness across uploads with same basename
  outpath="$IMG_DIR/${idx}_${filename}"

  # Check total cap
  if [ "$total_size" -ge "$TOTAL_MAX_BYTES" ]; then
    echo "[fetch-issue-images] Total cap ($TOTAL_MAX_BYTES bytes) reached — skipping $filename"
    skipped_count=$((skipped_count + 1))
    continue
  fi

  remaining=$((TOTAL_MAX_BYTES - total_size))
  per_file_cap=$((MAX_BYTES < remaining ? MAX_BYTES : remaining))

  # Download with per-file size limit.
  # --max-filesize aborts if body exceeds the limit (curl exit 63).
  # Fallback: check actual size after download (handles chunked encoding).
  if curl -sL --max-filesize "$per_file_cap" \
       -H "PRIVATE-TOKEN: $TOKEN" \
       -o "$outpath" "$url" 2>/dev/null; then
    actual_size=$(wc -c < "$outpath")
    if [ "$actual_size" -eq 0 ]; then
      rm -f "$outpath"
      echo "[fetch-issue-images] Empty response for $filename — skipping"
      skipped_count=$((skipped_count + 1))
      continue
    fi
    # Double-check against cap (in case --max-filesize was ignored: no Content-Length)
    if [ "$actual_size" -gt "$per_file_cap" ]; then
      rm -f "$outpath"
      echo "[fetch-issue-images] $filename ($actual_size bytes) exceeds cap ($per_file_cap) — skipping"
      skipped_count=$((skipped_count + 1))
      continue
    fi
    total_size=$((total_size + actual_size))
    downloaded_files+=("$outpath")
    echo "[fetch-issue-images] Downloaded ${idx}_${filename} ($actual_size bytes)"
  else
    rm -f "$outpath"
    echo "[fetch-issue-images] Skipped $filename (over ${per_file_cap} bytes or download failed)"
    skipped_count=$((skipped_count + 1))
  fi
done

# Write manifest
{
  echo "# Issue #$ISSUE — image attachments"
  echo ""
  echo "- Downloaded: ${#downloaded_files[@]} image(s), $total_size bytes total"
  [ "$skipped_count" -gt 0 ] && echo "- Skipped: $skipped_count (over size cap or total cap reached)"
  echo ""
  echo "## Files"
  for f in "${downloaded_files[@]}"; do
    echo "- $(basename "$f") ($(wc -c < "$f") bytes)"
  done
} > "$IMG_DIR/MANIFEST.md"

# Write env file for bin/oc to source
{
  printf 'BOUCLE_ISSUE_ATTACHMENTS="'
  for f in "${downloaded_files[@]}"; do
    printf '%s ' "$f"
  done
  printf '"\n'
} > "$ENV_FILE"

echo "[fetch-issue-images] Done: ${#downloaded_files[@]} images, $total_size bytes total, $skipped_count skipped"