---
import "../styles/global.css";
import "../styles/sections.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Urgence Palestine",
	description = "Solidarité avec le peuple palestinien. Informations, actions et ressources pour soutenir la Palestine.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color"="#0a0a0a" />

		<title>{title}</title>

		<!--
		  Preload the most critical font file to avoid a late reflow when the
		  heading face arrives. Body Poppins at 400 is the most-used weight.
		-->
		<link
			rel="preload"
			href="/fonts/the-bold-font.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/poppins-400.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="icon" type="image/svg+xml" href="./favicon.svg" />
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<script>
	/*
	 * Staggered Slide-Up Brutal — scroll reveal.
	 * -------------------------------------------
	 * Adds `.is-revealed` to every `.reveal` element and to the children of
	 * every `.reveal-stagger` container as they enter the viewport, driving
	 * the CSS transition-delay cascade (50-75ms) defined in sections.css.
	 * Uses only `transform` + `opacity` (composite properties) and is fully
	 * disabled under `prefers-reduced-motion: reduce`. Elements that miss
	 * the threshold still snap to their final (visible) state via the
	 * `.is-revealed` fallback in the reduced-motion CSS block.
	 */
	function initReveal() {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		const targets = document.querySelectorAll(".reveal, .reveal-stagger");
		if (!targets.length) return;

		const reveal = (el: Element) => {
			if (el.classList.contains("reveal")) {
				el.classList.add("is-revealed");
				return;
			}
			// `.reveal-stagger` — cascade its children.
			el.classList.add("is-revealed");
			const children = el.querySelectorAll(":scope > *");
			children.forEach((child, i) => {
				(child as HTMLElement).style.setProperty("--reveal-index", String(i));
				child.classList.add("is-revealed");
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						reveal(entry.target);
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
		);

		targets.forEach((el) => observer.observe(el));
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initReveal);
	} else {
		initReveal();
	}
</script>
