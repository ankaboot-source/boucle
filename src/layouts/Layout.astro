---
import "../styles/global.css";
import "../styles/sections.css";
import NewsletterSignup from "../components/NewsletterSignup.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Urgence Palestine",
	description = "Solidarité avec le peuple palestinien. Informations, actions et ressources pour soutenir la Palestine.",
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0a0a" />

		<title>{title}</title>

		<!--
		  Preload the most critical font file to avoid a late reflow when the
		  heading face arrives. Body Poppins at 400 is the most-used weight.
		-->
		<link
			rel="preload"
			href="/fonts/the-bold-font.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/poppins-400.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="icon" type="image/svg+xml" href="./favicon.svg" />
	</head>
	<body>
		<slot />

		<footer class="site-footer" aria-labelledby="site-footer-title">
			<div class="site-footer__inner">
				<div class="site-footer__brand">
					<p class="eyebrow site-footer__eyebrow">Urgence Palestine</p>
					<h2 id="site-footer-title" class="site-footer__title">
						Solidarité en action.
					</h2>
					<p class="site-footer__description">
						Une plateforme d'information, d'action et de mémoire. Pour
						que chaque voix porte et chaque geste compte.
					</p>
				</div>

				<div class="site-footer__nav" aria-label="Liens utiles">
					<h3 class="site-footer__nav-title">Liens</h3>
					<ul class="site-footer__list">
						<li><a href="/">Accueil</a></li>
						<li><a href="/engagement">S'engager</a></li>
						<li><a href="/symboles">Symboles</a></li>
					</ul>
				</div>

				<div class="site-footer__newsletter">
					<h3 class="site-footer__nav-title">Newsletter</h3>
					<NewsletterSignup variant="inline" />
				</div>
			</div>

			<div class="site-footer__base">
				<p class="site-footer__copy">
					© {year} Urgence Palestine. Tous droits réservés.
				</p>
			</div>
		</footer>
	</body>
</html>
