---
/*
 * /prises-de-parole/<slug>/ — Communiqué detail page.
 *
 * One route per Markdown file in `src/content/communiques/`. Renders
 * the full Markdown body plus the metadata (title, date, description)
 * declared in the frontmatter. Each card on the index page links here.
 *
 * `getStaticPaths()` is generated from the content collection so the
 * build knows which slugs to pre-render.
 */
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
	const entries = await getCollection("communiques");
	return entries.map((entry) => ({
		// `params.slug` mirrors the URL the index page emits:
		//   /prises-de-parole/<entry-id-without-YYYY-MM-DD-prefix>/
		params: { slug: entry.id.replace(/^\d{4}-\d{2}-\d{2}-/, "") },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const d = entry.data;

const pageTitle = `${d.title} — Prises de parole — Urgence Palestine`;
const pageDescription =
	d.description ??
	`« ${d.title} » — communiqué du Collectif Urgence Palestine.`;

const dateFormatter = new Intl.DateTimeFormat("fr-FR", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<Layout title={pageTitle} description={pageDescription}>
	<main id="main" class="entry">
		<!--
		  ====================================================================
		  Breadcrumb + back link
		  ====================================================================
		-->
		<nav class="entry__breadcrumb" aria-label="Fil d'Ariane">
			<a href="/prises-de-parole/">← Toutes les prises de parole</a>
		</nav>

		<article class="entry__article">
			<header class="entry__header">
				<p class="eyebrow">Prise de parole</p>
				<h1 class="entry__title">{d.title}</h1>
				<p class="entry__meta">
					<time datetime={d.date.toISOString()}>
						{dateFormatter.format(d.date)}
					</time>
				</p>
				{
					d.description && (
						<p class="entry__lede">{d.description}</p>
					)
				}
			</header>

			<!--
			  ====================================================================
			  Markdown body — images inside the body already point at
			  /communiques/<slug>/... local paths (rehosted in static/).
			  ====================================================================
			-->
			<div class="entry__body">
				<Content />
			</div>
		</article>

		<!--
		  ====================================================================
		  Footer CTA — invite readers to subscribe or move on to the next
		  communiqué.
		  ====================================================================
		-->
		<aside class="entry__footer" aria-labelledby="entry-footer-title">
			<h2 id="entry-footer-title" class="entry__footer-title">
				Tu veux suivre nos prochaines prises de parole&nbsp;?
			</h2>
			<p>
				Inscris-toi à la newsletter du collectif pour recevoir
				chaque nouveau communiqué en direct.
			</p>
			<div class="entry__footer-actions">
				<a
					class="btn btn--primary"
					href="/engagement/#newsletter"
				>
					S'inscrire à la newsletter
				</a>
				<a class="btn btn--ghost" href="/prises-de-parole/">
					Voir toutes les prises de parole
				</a>
			</div>
		</aside>
	</main>
</Layout>

<style>
	.eyebrow {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-mega);
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0;
	}

	/* ---------- Page wrapper ---------- */
	.entry {
		display: flex;
		flex-direction: column;
		gap: var(--space-l);
		padding-block: var(--space-l) var(--space-3xl);
		width: min(100% - 2 * var(--space-s), var(--container-base));
		margin-inline: auto;
	}

	/* ---------- Breadcrumb ---------- */
	.entry__breadcrumb {
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}

	.entry__breadcrumb a {
		color: var(--color-text-soft);
		text-decoration: none;
		transition: color var(--duration-base) var(--ease-out);
	}

	.entry__breadcrumb a:hover {
		color: var(--color-accent);
	}

	/* ---------- Article ---------- */
	.entry__article {
		display: flex;
		flex-direction: column;
		gap: var(--space-l);
	}

	.entry__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.entry__title {
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin: 0;
		/* Slightly larger on wide viewports via the global h1 rule. */
	}

	@media (min-width: 64rem) {
		.entry__title {
			font-size: var(--text-4xl);
		}
	}

	.entry__meta {
		margin: 0;
		font-size: var(--text-sm);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-text-muted);
		font-weight: var(--weight-semibold);
	}

	.entry__lede {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-muted);
		margin: var(--space-2xs) 0 0;
		max-width: 60ch;
	}

	/* ---------- Markdown body ---------- */
	.entry__body {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text);
	}

	.entry__body :global(h2) {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-tight);
		margin: var(--space-l) 0 var(--space-s);
	}

	.entry__body :global(h3) {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		margin: var(--space-m) 0 var(--space-2xs);
	}

	.entry__body :global(p) {
		margin: 0 0 var(--space-s);
	}

	.entry__body :global(ul),
	.entry__body :global(ol) {
		margin: 0 0 var(--space-s);
		padding-left: 1.2em;
	}

	.entry__body :global(li) {
		margin-bottom: var(--space-3xs);
	}

	.entry__body :global(a) {
		color: var(--color-link);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: oklch(75% 0.05 27);
		transition: color var(--duration-base) var(--ease-out);
	}

	.entry__body :global(a:hover) {
		color: var(--color-link-hover);
	}

	.entry__body :global(strong) {
		color: var(--color-text);
	}

	.entry__body :global(blockquote) {
		margin: var(--space-l) 0;
		padding: var(--space-s) var(--space-m);
		border-left: 3px solid var(--color-flag-red);
		background: var(--color-bg-soft);
		font-style: italic;
		color: var(--color-text-soft);
	}

	.entry__body :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin: var(--space-m) 0;
		border-radius: var(--radius-s);
	}

	/* ---------- Footer CTA ---------- */
	.entry__footer {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-s);
		padding: var(--space-l);
		background: var(--color-bg-soft);
		border: 1.5px solid var(--color-ink);
		border-radius: var(--radius-l);
	}

	.entry__footer-title {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		margin: 0;
	}

	.entry__footer p {
		font-size: var(--text-base);
		color: var(--color-text-muted);
		margin: 0;
		max-width: 60ch;
	}

	.entry__footer-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
	}

	/*
	 * .entry__footer-actions .btn — local override on the base .btn to
	 * align with the CTA charter (Variant A). Hard-edged red rectangle
	 * for primary, inverted ink rectangle for ghost so both reads stay
	 * high-contrast against the soft surface of the footer card.
	 */
	.entry__footer-actions .btn {
		min-height: 44px;
		padding: var(--space-s) var(--space-l);
		font-family: var(--font-heading);
		font-size: var(--text-base);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		border-radius: var(--radius-sharp);
		border-width: 0;
	}

	.entry__footer-actions .btn--primary {
		background: var(--color-flag-red);
		color: var(--color-flag-white);
	}

	.entry__footer-actions .btn--primary:hover {
		background: var(--color-flag-red-deep);
		color: var(--color-flag-white);
	}

	.entry__footer-actions .btn--primary:focus-visible {
		outline: 2px solid var(--color-flag-white);
		outline-offset: 3px;
	}

	.entry__footer-actions .btn--ghost {
		background: var(--color-ink);
		color: var(--color-ink-on-dark);
	}

	.entry__footer-actions .btn--ghost:hover {
		background: var(--color-ink-soft);
		color: var(--color-ink-on-dark);
	}

	.entry__footer-actions .btn--ghost:focus-visible {
		outline: 2px solid var(--color-flag-red);
		outline-offset: 3px;
	}
</style>
