---
/*
 * /collectif/<slug>/ — entry detail page.
 *
 * One route per Markdown file in `src/content/collectif/`. Renders the
 * full Markdown body plus the contact details (email + social links)
 * declared in the frontmatter. Falls back to a "no contact info" message
 * for entries that haven't published a channel yet.
 *
 * `getStaticPaths()` is generated from the content collection so the
 * build knows which slugs to pre-render.
 */
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
	const entries = await getCollection("collectif");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const d = entry.data;
const kind = d.kind ?? "section-locale";

type Channel = { label: string; href: string; icon: string };
const channels: Channel[] = [];
if (d.contact_email) {
	channels.push({
		label: d.contact_email,
		href: `mailto:${d.contact_email}`,
		icon: "✉",
	});
}
if (d.instagram) {
	channels.push({ label: "Instagram", href: d.instagram, icon: "◐" });
}
if (d.telegram) {
	channels.push({ label: "Telegram", href: d.telegram, icon: "✈" });
}
if (d.twitter) {
	channels.push({ label: "X (Twitter)", href: d.twitter, icon: "✕" });
}
if (d.facebook) {
	channels.push({ label: "Facebook", href: d.facebook, icon: "f" });
}
if (d.website) {
	channels.push({ label: d.website, href: d.website, icon: "↗" });
}

const isEtudiante = kind === "mobilisation-etudiante";

// CTA destinations (kept in sync with the index page).
const CREER_UN_COLLECTIF_URL =
	"https://docs.google.com/forms/d/e/1FAIpQLScedxLah93YMCKnyNPi4TCyjz0cwp0L6prMat-D7HIXBhhVNw/viewform";
const JE_MENGAGE_URL = "https://forms.gle/zyhXWz6KjoPJ9q7B8";
const MOBILISATION_ETUDIANTE_URL = "https://linktr.ee/etudiant.es";

const pageTitle = `${d.title ?? d.city} — Collectif Urgence Palestine`;
const pageDescription =
	d.description ?? `Fiche de la section ${d.city} du Collectif Urgence Palestine.`;
---

<Layout title={pageTitle} description={pageDescription}>
	<main id="main" class="entry">
		<!--
		  ====================================================================
		  Breadcrumb + back link
		  ====================================================================
		-->
		<nav class="entry__breadcrumb" aria-label="Fil d'Ariane">
			<a href="/collectif/">← Toutes les sections du collectif</a>
		</nav>

		<article class={`entry__article ${isEtudiante ? "entry__article--etudiante" : ""}`}>
			<header class="entry__header">
				<p class="eyebrow">
					{isEtudiante ? "Mobilisation étudiante" : "Section locale"}
				</p>
				<h1 class="entry__title">{d.title ?? d.city}</h1>
				{
					d.description && (
						<p class="entry__lede">{d.description}</p>
					)
				}
			</header>

			{
				d.image && !isEtudiante && (
					<figure class="entry__hero">
						<img src={d.image} alt="" loading="eager" decoding="async" />
					</figure>
				)
			}

			<!--
			  ====================================================================
			  Markdown body
			  ====================================================================
			-->
			<div class="entry__body">
				<Content />
			</div>

			<!--
			  ====================================================================
			  Contact panel
			  ====================================================================
			-->
			<aside class="entry__contact" aria-labelledby="contact-title">
				<h2 id="contact-title" class="entry__contact-title">
					{isEtudiante ? "Liens utiles" : "Contact"}
				</h2>

				{
					channels.length > 0 ? (
						<ul class="entry__channels" role="list">
							{channels.map((c) => (
								<li>
									<a
										class="entry__channel"
										href={c.href}
										rel={
											c.href.startsWith("http") ? "noopener external" : undefined
										}
										target={c.href.startsWith("http") ? "_blank" : undefined}
									>
										<span class="entry__channel-icon" aria-hidden="true">
											{c.icon}
										</span>
										<span class="entry__channel-label">{c.label}</span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="entry__no-contact">
							Aucun contact public pour l'instant. Tu peux contribuer à
							compléter cette fiche via le formulaire « Créer un collectif ».
						</p>
					)
				}

				{
					!isEtudiante && (
						<div class="entry__cta">
							<a
								class="btn btn--primary"
								href={CREER_UN_COLLECTIF_URL}
								rel="noopener external"
								target="_blank"
							>
								Créer un collectif
							</a>
						</div>
					)
				}

				{
					isEtudiante && (
						<div class="entry__cta">
							<a
								class="btn btn--primary"
								href={MOBILISATION_ETUDIANTE_URL}
								rel="noopener external"
								target="_blank"
							>
								Annuaire des campus
							</a>
							<a
								class="btn btn--ghost"
								href={JE_MENGAGE_URL}
								rel="noopener external"
								target="_blank"
							>
								Je m'engage
							</a>
						</div>
					)
				}
			</aside>
		</article>
	</main>
</Layout>

<style>
	.eyebrow {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-mega);
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0;
	}

	/* ---------- Page wrapper ---------- */
	.entry {
		display: flex;
		flex-direction: column;
		gap: var(--space-l);
		padding-block: var(--space-l) var(--space-3xl);
		width: min(100% - 2 * var(--space-s), var(--container-base));
		margin-inline: auto;
	}

	/* ---------- Breadcrumb ---------- */
	.entry__breadcrumb {
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}

	.entry__breadcrumb a {
		color: var(--color-text-soft);
		text-decoration: none;
		transition: color var(--duration-base) var(--ease-out);
	}

	.entry__breadcrumb a:hover {
		color: var(--color-accent);
	}

	/* ---------- Article ---------- */
	.entry__article {
		display: flex;
		flex-direction: column;
		gap: var(--space-l);
	}

	.entry__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.entry__title {
		font-family: var(--font-heading);
		font-size: var(--text-4xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin: 0;
	}

	.entry__lede {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-muted);
		margin: 0;
		max-width: 60ch;
	}

	/* ---------- Hero image (per-city) ---------- */
	.entry__hero {
		margin: 0;
		border-radius: var(--radius-l);
		overflow: hidden;
		background: var(--color-bg-soft);
		border: 1px solid var(--color-border);
	}

	.entry__hero img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* ---------- Body ---------- */
	.entry__body {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text);
	}

	.entry__body :global(h2) {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-tight);
		margin: var(--space-l) 0 var(--space-s);
	}

	.entry__body :global(h3) {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		margin: var(--space-m) 0 var(--space-2xs);
	}

	.entry__body :global(p) {
		margin: 0 0 var(--space-s);
	}

	.entry__body :global(ul),
	.entry__body :global(ol) {
		margin: 0 0 var(--space-s);
		padding-left: 1.2em;
	}

	.entry__body :global(li) {
		margin-bottom: var(--space-3xs);
	}

	.entry__body :global(a) {
		color: var(--color-link);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: oklch(75% 0.05 27);
		transition: color var(--duration-base) var(--ease-out);
	}

	.entry__body :global(a:hover) {
		color: var(--color-link-hover);
	}

	.entry__body :global(strong) {
		color: var(--color-text);
	}

	/* ---------- Contact panel ---------- */
	.entry__contact {
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
		padding: var(--space-l);
		background: var(--color-ink);
		color: var(--color-ink-on-dark);
		border-radius: var(--radius-l);
	}

	.entry__article--etudiante .entry__contact {
		background: var(--color-bg-soft);
		color: var(--color-ink);
		border: 1px solid var(--color-ink);
	}

	.entry__contact-title {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		margin: 0;
	}

	.entry__channels {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-2xs);
	}

	@media (min-width: 40rem) {
		.entry__channels {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.entry__channel {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		padding: var(--space-2xs) var(--space-s);
		min-height: 44px;
		border-radius: var(--radius-m);
		border: 1px solid oklch(35% 0 0);
		text-decoration: none;
		color: var(--color-ink-on-dark);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out);
	}

	.entry__channel:hover {
		background: oklch(22% 0 0);
		border-color: var(--color-flag-red);
	}

	.entry__article--etudiante .entry__channel {
		border-color: var(--color-border);
		color: var(--color-ink);
	}

	.entry__article--etudiante .entry__channel:hover {
		background: var(--color-paper);
		border-color: var(--color-ink);
	}

	.entry__channel-icon {
		font-family: var(--font-body);
		font-size: var(--text-base);
		width: 1.4em;
		text-align: center;
	}

	.entry__channel-label {
		font-family: var(--font-body);
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.entry__no-contact {
		margin: 0;
		font-size: var(--text-base);
		line-height: var(--leading-relaxed);
		color: oklch(75% 0 0);
	}

	.entry__article--etudiante .entry__no-contact {
		color: var(--color-text-muted);
	}

	.entry__cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
		margin-top: var(--space-2xs);
	}

	/*
	 * .entry__cta .btn — local override on the base .btn to align with
	 * the CTA charter (Variant A). Hard-edged red rectangle for primary,
	 * inverted ink rectangle for ghost so both reads stay high-contrast
	 * against the surrounding ink contact panel.
	 */
	.entry__cta .btn {
		min-height: 44px;
		padding: var(--space-s) var(--space-l);
		font-family: var(--font-heading);
		font-size: var(--text-base);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		border-radius: var(--radius-sharp);
		border-width: 0;
	}

	.entry__cta .btn--primary {
		background: var(--color-flag-red);
		color: var(--color-flag-white);
	}

	.entry__cta .btn--primary:hover {
		background: var(--color-flag-red-deep);
		color: var(--color-flag-white);
	}

	.entry__cta .btn--primary:focus-visible {
		outline: 2px solid var(--color-flag-white);
		outline-offset: 3px;
	}

	.entry__cta .btn--ghost {
		background: var(--color-flag-white);
		color: var(--color-ink);
	}

	.entry__cta .btn--ghost:hover {
		background: var(--color-paper-edge);
		color: var(--color-ink);
	}

	.entry__cta .btn--ghost:focus-visible {
		outline: 2px solid var(--color-flag-red);
		outline-offset: 3px;
	}

	/*
	 * Etudiante variant: the contact panel swaps to a light surface, so
	 * invert the pair — primary stays red, ghost becomes ink so the two
	 * reads remain balanced on the lighter background.
	 */
	.entry__article--etudiante .entry__cta .btn--ghost {
		background: var(--color-ink);
		color: var(--color-ink-on-dark);
	}

	.entry__article--etudiante .entry__cta .btn--ghost:hover {
		background: var(--color-ink-soft);
		color: var(--color-ink-on-dark);
	}
</style>
