---
import "../styles/sections.css";
import Layout from "../layouts/Layout.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import NewsletterModal from "../components/NewsletterModal.astro";
import DonationCTA from "../components/DonationCTA.astro";
import GeneralCTA from "../components/GeneralCTA.astro";
import MobilisationBlock from "../components/MobilisationBlock.astro";
---

<Layout>
	<main id="main" class="home">
		<!--
		  ============================================================
		  Top brand band: statement headline, optional symbol, and
		  the four flag colors as a thin tri-color stripe.
		  ============================================================
		-->
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero__inner">
				<p class="eyebrow">Urgence Palestine</p>
				<h1 id="hero-title" class="display font-display tracking-tight text-ink">
					Solidarité<br />avec la Palestine.
				</h1>
				<p class="hero__lede">
					Une plateforme d'information, d'action et de mémoire. Pour
					que chaque voix porte, chaque histoire soit entendue, et
					chaque geste compte.
				</p>
				<div class="hero__cta">
					<a class="btn btn--primary" href="/engagement">Agir maintenant</a>
					<img
						class="hero__symbol"
						src="/symbols/keffiyeh_-_ancala_nusantara.png"
						alt="Keffieh, foulard palestinien, symbole d'identité"
						width="64"
						height="64"
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
			</div>
		</section>

		<!--
		  ============================================================
		  General CTA: a non-clickable, two-stripe visual harness for
		  the upcoming CTA migrations. Pure Astro, no client JS.
		  ============================================================
		-->
		<GeneralCTA
			eyebrow="S'informer"
			title="S'informer, c'est déjà résister"
			ctaLabel="Lire les derniers articles"
		/>

		<!--
		  ============================================================
		  Tailwind utility callout: exercises the Palestinian flag color
		  tokens (bg-palestine-red) and the font-display utility, proving
		  that the Tailwind integration is wired into the build. Kept
		  intentionally small: page content beyond the placeholder is
		  owned by parent issue #1.
		  ============================================================
		-->
		<DonationCTA />

		<!--
		  ============================================================
		  Mobilisation: a photo of a manifestation, covered by a solid
		  flag-red overlay, with the title sitting on the overlay and
		  the body lede + CTA living below the photo on a clean paper
		  surface. No body paragraph, no CTA floats over the photo.
		  Image is a temporary placeholder (see
		  `static/mobilisation/_placeholder-manifestation.svg` and
		  `data-placeholder="true"` on the rendered element). When the
		  author supplies a real photograph, swap the `backgroundImage`
		  prop and drop `isPlaceholder` to `false`.
		  ============================================================
		-->
		<MobilisationBlock />

		<!-- Decorative olive branch above the flag stripe. -->
		<p class="section-head__lede section-head__lede--centered" aria-hidden="false">
			<img
				class="accent-inline"
				src="/symbols/olive_branch_-_ccnisa.png"
				alt="Branche d'olivier, symbole de la Palestine"
				loading="lazy"
				decoding="async"
				width="48"
				height="48"
			/>
			Aucune image ne représente mieux la Palestine que l'olivier&nbsp;:
			arbre millénaire, source d'huile et de lien.
		</p>

		<!--
		  ============================================================
		  Flag stripe: a horizontal Palestinian flag that doubles as a
		  brand color reference.
		  ============================================================
		-->
		<div class="flag-stripe" role="img" aria-label="Drapeau palestinien : noir, blanc, vert, rouge">
			<span class="flag-stripe__band flag-stripe__band--black"></span>
			<span class="flag-stripe__band flag-stripe__band--white"></span>
			<span class="flag-stripe__band flag-stripe__band--green"></span>
			<span class="flag-stripe__band flag-stripe__band--red"></span>
		</div>

		<!--
		  ============================================================
		  Three pillars: the visual brand distilled.
		  ============================================================
		-->
		<section class="pillars" aria-labelledby="pillars-title">
			<header class="section-head">
				<p class="eyebrow">
					<img
						class="accent-inline"
						src="/symbols/vecteezy_red-simple-watercolor-flower_27102639.png"
						alt=""
						loading="lazy"
						decoding="async"
						width="32"
						height="32"
						aria-hidden="true"
					/>
					Notre identité
				</p>
				<h2 id="pillars-title">Trois piliers, un message clair.</h2>
			</header>

			<ol class="pillars__list">
				<li class="pillar">
					<p class="pillar__index">01</p>
					<h3>Le noir et le blanc d'abord</h3>
					<p>
						Une base monochrome, lisible, sans distraction. Les
						couleurs du drapeau sont réservées aux moments où elles
						portent un sens.
					</p>
				</li>
				<li class="pillar">
					<p class="pillar__index">02</p>
					<h3>Une typographie qui s'impose</h3>
					<p>
						The Bold Font pour les titres, Poppins pour le reste.
						Contraste assumé entre un display géométrique et un
						sans-serif moderne.
					</p>
				</li>
			</ol>
		</section>

		<!--
		  ============================================================
		  Newsletter: a dedicated content section that re-uses the
		  <NewsletterSignup /> component.
		  ============================================================
		-->
		<section class="newsletter-section" aria-labelledby="newsletter-section-title">
			<header class="section-head">
				<p class="eyebrow">Newsletter</p>
				<h2 id="newsletter-section-title">Suivez nos actions.</h2>
			</header>
			<NewsletterSignup variant="block" />
		</section>
	</main>

	<NewsletterModal slot="modal" />
</Layout>
