---
import "../styles/sections.css";
import Layout from "../layouts/Layout.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import NewsletterModal from "../components/NewsletterModal.astro";
---

<Layout>
	<main id="main" class="home">
		<!--
		  ============================================================
		  Top brand band: statement headline, optional symbol, and
		  the four flag colors as a thin tri-color stripe.
		  ============================================================
		-->
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero__inner">
				<p class="eyebrow">Urgence Palestine</p>
				<h1 id="hero-title" class="display">
					Solidarité<br />avec la Palestine.
				</h1>
				<p class="hero__lede">
					Une plateforme d'information, d'action et de mémoire. Pour
					que chaque voix porte, chaque histoire soit entendue, et
					chaque geste compte.
				</p>
				<div class="hero__cta">
					<a class="btn btn--primary" href="/agir">Agir maintenant</a>
					<a class="btn btn--ghost" href="/symboles">Découvrir nos symboles</a>
				</div>
			</div>

			<figure class="hero__symbol" aria-label="Symbole de la clef antique palestinienne">
				<img
					src="/symbols/antique-key.webp"
					alt="Clef ancienne palestinienne, symbole du retour"
					width="512"
					height="512"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</figure>
		</section>

		<!--
		  ============================================================
		  Flag stripe: a horizontal Palestinian flag that doubles as a
		  brand color reference.
		  ============================================================
		-->
		<div class="flag-stripe" role="img" aria-label="Drapeau palestinien : noir, blanc, vert, rouge">
			<span class="flag-stripe__band flag-stripe__band--black"></span>
			<span class="flag-stripe__band flag-stripe__band--white"></span>
			<span class="flag-stripe__band flag-stripe__band--green"></span>
			<span class="flag-stripe__band flag-stripe__band--red"></span>
		</div>

		<!--
		  ============================================================
		  Three pillars: the visual brand distilled.
		  ============================================================
		-->
		<section class="pillars" aria-labelledby="pillars-title">
			<header class="section-head">
				<p class="eyebrow">Notre identité</p>
				<h2 id="pillars-title">Trois piliers, un message clair.</h2>
			</header>

			<ol class="pillars__list">
				<li class="pillar">
					<p class="pillar__index">01</p>
					<h3>Le noir et le blanc d'abord</h3>
					<p>
						Une base monochrome, lisible, sans distraction. Les
						couleurs du drapeau sont réservées aux moments où elles
						portent un sens.
					</p>
				</li>
				<li class="pillar">
					<p class="pillar__index">02</p>
					<h3>Une typographie qui s'impose</h3>
					<p>
						The Bold Font pour les titres, Poppins pour le reste.
						Contraste assumé entre un display géométrique et un
						sans-serif moderne.
					</p>
				</li>
				<li class="pillar">
					<p class="pillar__index">03</p>
					<h3>Neuf symboles, dessinés à la main</h3>
					<p>
						Clef antique, grenade, huile d'olive, keffieh, souimanga,
						coquelicot, Al-Quds, Al-Aqsa, orange. Une grammaire
						visuelle pour parler de Palestine.
					</p>
				</li>
			</ol>
		</section>

		<!--
		  ============================================================
		  Newsletter section. The acceptance criteria require the
		  <NewsletterSignup /> component to be rendered on a page-level
		  section in addition to the footer.
		  ============================================================
		-->
		<section class="home-newsletter" aria-labelledby="home-newsletter-title">
			<div class="home-newsletter__inner">
				<header class="home-newsletter__head">
					<p class="eyebrow">Newsletter</p>
					<h2 id="home-newsletter-title" class="home-newsletter__title">
						Un email par mois.<br />Trois clics pour s'inscrire.
					</h2>
					<p class="home-newsletter__lede">
						Notre lettre d'information rassemble les appels à l'action
						du mois, les rendez-vous près de chez vous et les ressources
						que nous publions. Pas de pub, pas de spam — vous pouvez
						vous désinscrire en un clic.
					</p>
				</header>
				<div class="home-newsletter__form">
					<NewsletterSignup
						id="home-newsletter"
						variant="inline"
						heading=""
						description=""
					/>
				</div>
			</div>
		</section>
	</main>

	<NewsletterModal slot="modal" />
</Layout>

<style>
	.home-newsletter {
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
	}

	.home-newsletter__inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-l);
		align-items: start;
		padding: var(--space-xl);
		background: var(--color-ink);
		color: var(--color-ink-on-dark);
		border-radius: var(--radius-l);
	}

	@media (min-width: 48rem) {
		.home-newsletter__inner {
			grid-template-columns: 1.1fr 1fr;
			gap: var(--space-2xl);
		}
	}

	.home-newsletter__head {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.home-newsletter__title {
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		font-weight: var(--weight-bold);
		color: var(--color-ink-on-dark);
		margin: 0;
		letter-spacing: var(--tracking-tight);
	}

	.home-newsletter__lede {
		font-size: var(--text-base);
		color: color-mix(in oklch, var(--color-ink-on-dark) 75%, transparent);
		max-width: 48ch;
		margin: var(--space-2xs) 0 0;
	}

	.home-newsletter__form {
		background: var(--color-bg);
		color: var(--color-ink);
		border-radius: var(--radius-l);
		padding: var(--space-l);
	}

	.home-newsletter__form :global(.newsletter__intro) {
		display: none;
	}
</style>
