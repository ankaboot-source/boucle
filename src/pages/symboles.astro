---
import "../styles/sections.css";
import Layout from "../layouts/Layout.astro";
import NewsletterModal from "../components/NewsletterModal.astro";

/*
 * The 9 hand-drawn brand symbols, loaded as raster images from /static/symbols/.
 * Per acceptance criteria, no <svg> is used to render these — only <img> tags
 * pointing to the PNG/WebP files in /static/symbols/.
 */

const symbols = [
	{
		name: "antique-key",
		label: "Clef antique",
		caption: "Symbole du retour au foyer",
	},
	{
		name: "pomegranate",
		label: "Grenade",
		caption: "Fertilité et abondance",
	},
	{
		name: "olive-oil",
		label: "Huile d'olive",
		caption: "L'or vert de Palestine",
	},
	{
		name: "keffieh",
		label: "Keffieh",
		caption: "Le foulard palestinien",
	},
	{
		name: "sunbird",
		label: "Souimanga",
		caption: "L'oiseau national de Palestine",
	},
	{
		name: "poppy",
		label: "Coquelicot",
		caption: "Mémoire et remembrance",
	},
	{
		name: "al-quds",
		label: "Al-Quds",
		caption: "Jérusalem, la ville sainte",
	},
	{
		name: "al-aqsa",
		label: "Al-Aqsa",
		caption: "La mosquée du Rocher",
	},
	{
		name: "orange",
		label: "Orange de Jaffa",
		caption: "L'or des vergers palestiniens",
	},
];
---

<Layout title="Symboles — Urgence Palestine">
	<main id="main" class="home">
		<section class="hero" aria-labelledby="symbols-title">
			<div class="hero__inner">
				<p class="eyebrow">Identité visuelle</p>
				<h1 id="symbols-title" class="display">
					Neuf symboles<br />dessinés à la main.
				</h1>
				<p class="hero__lede">
					Une grammaire visuelle pour parler de Palestine. Chaque
					symbole évoque une facette de la culture, de la mémoire et
					du territoire.
				</p>
			</div>
		</section>

		<section class="symbols" aria-labelledby="symbols-grid-title">
			<h2 id="symbols-grid-title" class="visually-hidden">Galerie des symboles</h2>
			<ul class="symbols__grid">
				{
					symbols.map((s) => (
						<li class="symbol-card">
							<img
								class="symbol-card__image"
								src={`/symbols/${s.name}.webp`}
								alt={s.caption}
								loading="lazy"
								decoding="async"
								width="512"
								height="512"
							/>
							<p class="symbol-card__label">{s.label}</p>
							<p class="symbol-card__caption">{s.caption}</p>
						</li>
					))
				}
			</ul>
		</section>
	</main>

	<NewsletterModal slot="modal" />
</Layout>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
