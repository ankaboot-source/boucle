---
import "../styles/sections.css";
import Layout from "../layouts/Layout.astro";

/*
 * /credits — Crédits et attributions des illustrations.
 *
 * Lists every visual the site reuses under a permissive licence, so that
 * authors are credited and visitors can verify the source of each asset.
 * The page is intentionally minimal: a single column, one section per
 * illustration, no JS, no third-party assets.
 */

interface Credit {
	file: string;
	label: string;
	artist: string;
	source: string;
	sourceHref: string;
	licence: string;
	licenceHref: string;
	usage: string;
}

const credits: Credit[] = [
	{
		file: "olive_branch_-_ccnisa.png",
