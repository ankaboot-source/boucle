	},
];
---

<Layout
	title="Crédits — Urgence Palestine"
	description="Crédits et attributions des illustrations réutilisées sur le site Urgence Palestine (CC-BY / Vecteezy)."
>
	<main id="main" class="credits">
		<header class="credits__header">
			<h1 class="credits__title">Illustrations et attributions.</h1>
			<p class="credits__lede">
				Les visuels ornant ce site proviennent d'illustrateurs et
				d'illustratrices qui ont publié leur travail sous licence
				ouverte. Chaque image est créditée ci-dessous avec le nom du
				fichier, l'artiste, la source et la licence.
			</p>
			<p class="credits__lede">
				Pour toute question sur les réutilisations ou les licences,
				écrivez-nous via la page <a href="/contact">Contact</a>.
			</p>
		</header>

		<section class="credits__list" aria-labelledby="credits-list-title">
			<h2 id="credits-list-title" class="visually-hidden">
				Liste des visuels et de leurs crédits
			</h2>
			<ul class="credits__grid" role="list">
				{
					credits.map((credit) => (
						<li class="credit-card">
							<figure class="credit-card__figure">
								<img
									class="credit-card__image"
									src={`/symbols/${credit.file}`}
									alt={credit.label}
									loading="lazy"
									decoding="async"
									width="128"
									height="128"
								/>
							</figure>
							<div class="credit-card__body">
								<h3 class="credit-card__label">{credit.label}</h3>
								<dl class="credit-card__meta">
									<dt>Artiste</dt>
									<dd>{credit.artist}</dd>
									<dt>Source</dt>
									<dd>
										<a
											href={credit.sourceHref}
											rel="noopener external"
											target="_blank"
										>
											{credit.source}
										</a>
									</dd>
									<dt>Licence</dt>
									<dd>
										<a
											href={credit.licenceHref}
											rel="noopener external"
											target="_blank"
										>
											{credit.licence}
										</a>
									</dd>
									<dt>Usage</dt>
									<dd>{credit.usage}</dd>
								</dl>
							</div>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</Layout>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.credits {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xl);
		padding-block: var(--space-xl) var(--space-3xl);
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
	}

	.credits__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
		max-width: 60ch;
	}

	.credits__title {
		font-family: var(--font-heading);
		font-size: var(--text-4xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin: 0;
	}

	.credits__lede {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-muted);
		margin: 0;
		max-width: 60ch;
	}

	.credits__lede a {
		color: var(--color-ink);
		font-weight: var(--weight-semibold);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.credits__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-l);
	}

	@media (min-width: 40rem) {
		.credits__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.credits__grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.credit-card {
		display: flex;
		gap: var(--space-s);
		padding: var(--space-m);
		background: var(--color-bg-soft);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-m);
	}

	.credit-card__figure {
		margin: 0;
		flex-shrink: 0;
		display: flex;
		align-items: flex-start;
		justify-content: center;
	}

	.credit-card__image {
		width: 96px;
		height: 96px;
		object-fit: contain;
		border-radius: var(--radius-s);
		background: var(--color-paper);
		border: 1px solid var(--color-border);
	}

	.credit-card__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
	}

	.credit-card__label {
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
		margin: 0;
	}

	.credit-card__meta {
		margin: 0;
		display: grid;
		grid-template-columns: max-content 1fr;
		column-gap: var(--space-2xs);
		row-gap: var(--space-3xs);
		font-size: var(--text-sm);
		line-height: var(--leading-snug);
	}

	.credit-card__meta dt {
		font-family: var(--font-body);
		font-weight: var(--weight-semibold);
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: var(--text-xs);
		align-self: start;
	}

	.credit-card__meta dd {
		margin: 0;
		color: var(--color-text);
	}

	.credit-card__meta a {
		color: var(--color-ink);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.credit-card__meta a:hover,
	.credit-card__meta a:focus-visible {
		color: var(--color-accent);
	}
</style>
