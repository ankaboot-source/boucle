		licence: "CC-BY 4.0",
		licenceHref: "https://creativecommons.org/licenses/by/4.0/deed.fr",
		usage:
			"Décor des sections don / récolte (olives, huile d'olive, cueillette).",
	},
	{
		file: "pomegranata_-_ccnisa.png",
		label: "Grenade",
		artist: "ccnisa",
		source: "Vecteezy — ccnisa",
		sourceHref: "https://fr.vecteezy.com/vecteur-libre/grenade-fruit",
		licence: "CC-BY 4.0",
		licenceHref: "https://creativecommons.org/licenses/by/4.0/deed.fr",
		usage:
			"Décor des sections fertilité, culture et cuisine palestinienne.",
	},
	{
		file: "keffiyeh_-_ancala_nusantara.png",
		label: "Keffieh",
		artist: "ancala nusantara",
		source: "Vecteezy — ancala nusantara",
		sourceHref:
			"https://fr.vecteezy.com/vecteur-libre/keffieh-palestinien-traditionnel",
		licence: "CC-BY 4.0",
		licenceHref: "https://creativecommons.org/licenses/by/4.0/deed.fr",
		usage:
			"Décor des piliers d'identité visuelle et de mouvement de solidarité.",
	},
	{
		file: "slignshot_-_ancala_nusantara.png",
		label: "Lance-pierre",
		artist: "ancala nusantara",
		source: "Vecteezy — ancala nusantara",
		sourceHref:
			"https://fr.vecteezy.com/vecteur-libre/lance-pierre-intifada-palestine",
		licence: "CC-BY 4.0",
		licenceHref: "https://creativecommons.org/licenses/by/4.0/deed.fr",
		usage:
			"Décor des sections résistance, mobilisation et intifada.",
	},
	{
		file: "red_riangle.png",
		label: "Triangle rouge",
		artist: "ancala nusantara",
		source: "Vecteezy — ancala nusantara",
		sourceHref:
			"https://fr.vecteezy.com/vecteur-libre/triangle-rouge-resistance-palestinienne",
		licence: "CC-BY 4.0",
		licenceHref: "https://creativecommons.org/licenses/by/4.0/deed.fr",
		usage:
			"Décor des sections résistance et mémoire des martyrs (avec parcimonie, symbole fort).",
	},
	{
		file: "victory_hand.png",
		label: "Victoire",
		artist: "ancala nusantara",
		source: "Vecteezy — ancala nusantara",
