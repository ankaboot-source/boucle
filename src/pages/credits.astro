			"Décor des CTA victoire et d'engagement (inscription, don).",
	},
	{
		file: "palestine_map_al_qods-_ancala_nusantara.png",
		label: "Carte de Palestine — Al-Qods",
		artist: "ancala nusantara",
		source: "Vecteezy — ancala nusantara",
		sourceHref:
			"https://fr.vecteezy.com/vecteur-libre/carte-palestine-al-quds-jerusalem",
		licence: "CC-BY 4.0",
		licenceHref: "https://creativecommons.org/licenses/by/4.0/deed.fr",
		usage:
			"Décor des sections Jérusalem, Al-Quds et géographie palestinienne.",
	},
	{
		file: "palestine_map_-_sam_graphics.png",
		label: "Carte de Palestine — sam graphics",
		artist: "sam graphics",
		source: "Vecteezy — sam graphics",
		sourceHref:
			"https://fr.vecteezy.com/vecteur-libre/carte-palestine-drapeau-tricolore",
