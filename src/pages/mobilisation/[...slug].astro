---
/*
 * /mobilisation/<slug>/ — Mobilisation entry detail page.
 *
 * One route per Markdown file in `src/content/mobilisation/`. Renders
 * the full Markdown body plus the campaign metadata (title, date,
 * location, description, category, featured image) declared in the
 * frontmatter. Each card on the index page links here.
 *
 * `getStaticPaths()` is generated from the content collection so the
 * build knows which slugs to pre-render.
 */
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
	const entries = await getCollection("mobilisation");
	return entries.map((entry) => ({
		// `params.slug` mirrors the URL the index page emits:
		//   /mobilisation/<entry-id-without-YYYY-MM-prefix>/
		params: { slug: entry.id.replace(/^\d{4}-\d{2}-/, "") },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const d = entry.data;
const category = d.category ?? "evenement";

type CategoryKey = "kit-militant" | "boycott" | "prisonniers" | "evenement";

const groupLabel: Record<CategoryKey, { tag: string; tagline: string }> = {
	"kit-militant": {
		tag: "Kit militant",
		tagline: "Affiches, tracts et pancartes prêts à imprimer.",
	},
	boycott: {
		tag: "Boycott",
		tagline: "Arguments, visuels et tracts pour interpeller les marques complices.",
	},
	prisonniers: {
		tag: "Prisonnier·es",
		tagline: "Soutien aux prisonniers politiques palestiniens.",
	},
	evenement: {
		tag: "Événement",
		tagline: "Rassemblement, marche ou action ponctuelle.",
	},
};

const group = groupLabel[category as CategoryKey] ?? groupLabel.evenement;

const pageTitle = `${d.title} — Mobilisation — Urgence Palestine`;
const pageDescription =
	d.description ?? `${d.title} — ${d.location} — Mobilisation Urgence Palestine.`;

const dateFormatter = new Intl.DateTimeFormat("fr-FR", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<Layout title={pageTitle} description={pageDescription}>
	<main id="main" class="entry">
		<!--
		  ====================================================================
		  Breadcrumb + back link
		  ====================================================================
		-->
		<nav class="entry__breadcrumb" aria-label="Fil d'Ariane">
			<a href="/mobilisation/">← Toutes les actions de mobilisation</a>
		</nav>

		<article class="entry__article">
			<header class="entry__header">
				<p class="eyebrow">
					<span class="entry__category-tag">{group.tag}</span>
				</p>
				<h1 class="entry__title">{d.title}</h1>
				<p class="entry__meta">
					<time datetime={d.date.toISOString()}>
						{dateFormatter.format(d.date)}
					</time>
					<span aria-hidden="true"> · </span>
					<span>{d.location}</span>
				</p>
				{
					d.description && (
						<p class="entry__lede">{d.description}</p>
					)
				}
			</header>

			{
				d.featured_image && (
					<figure class="entry__hero">
						<img
							src={d.featured_image}
							alt=""
							loading="eager"
							decoding="async"
						/>
					</figure>
				)
			}

			<!--
			  ====================================================================
			  Markdown body — images inside the body already point at
			  /mobilisation/<category>/... local paths (rehosted in
			  static/).
			  ====================================================================
			-->
			<div class="entry__body">
				<Content />
			</div>
		</article>

		<!--
		  ====================================================================
		  Footer CTA — drive readers to the other actions.
		  ====================================================================
		-->
		<aside class="entry__footer" aria-labelledby="entry-footer-title">
			<h2 id="entry-footer-title" class="entry__footer-title">
				{group.tagline}
			</h2>
			<p>
				Tu peux relayer cette action sur tes réseaux, imprimer les
				visuels et organiser une déclinaison locale. Le collectif
				relayera sur ses canaux.
			</p>
			<div class="entry__footer-actions">
				<a class="btn btn--primary" href="/mobilisation/">
					Voir toutes les actions
				</a>
				<a class="btn btn--ghost" href="/engagement/">
					Rejoindre le collectif
				</a>
			</div>
		</aside>
	</main>
</Layout>

<style>
	.eyebrow {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-mega);
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0;
	}

	/* ---------- Page wrapper ---------- */
	.entry {
		display: flex;
		flex-direction: column;
		gap: var(--space-l);
		padding-block: var(--space-l) var(--space-3xl);
		width: min(100% - 2 * var(--space-s), var(--container-base));
		margin-inline: auto;
	}

	/* ---------- Breadcrumb ---------- */
	.entry__breadcrumb {
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}

	.entry__breadcrumb a {
		color: var(--color-text-soft);
		text-decoration: none;
		transition: color var(--duration-base) var(--ease-out);
	}

	.entry__breadcrumb a:hover {
		color: var(--color-accent);
	}

	/* ---------- Article ---------- */
	.entry__article {
		display: flex;
		flex-direction: column;
		gap: var(--space-l);
	}

	.entry__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.entry__category-tag {
		display: inline-block;
		padding: 0.2em 0.7em;
		background: var(--color-ink);
		color: var(--color-ink-on-dark);
		border-radius: var(--radius-pill);
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-mega);
		text-transform: uppercase;
	}

	.entry__title {
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin: 0;
	}

	@media (min-width: 64rem) {
		.entry__title {
			font-size: var(--text-4xl);
		}
	}

	.entry__meta {
		margin: 0;
		font-size: var(--text-sm);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-text-muted);
		font-weight: var(--weight-semibold);
	}

	.entry__lede {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-muted);
		margin: var(--space-2xs) 0 0;
		max-width: 60ch;
	}

	/* ---------- Hero image ---------- */
	.entry__hero {
		margin: 0;
		border-radius: var(--radius-l);
		overflow: hidden;
		background: var(--color-bg-soft);
		border: 1px solid var(--color-border);
	}

	.entry__hero img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* ---------- Markdown body ---------- */
	.entry__body {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text);
	}

	.entry__body :global(h2) {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-tight);
		margin: var(--space-l) 0 var(--space-s);
	}

	.entry__body :global(h3) {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		margin: var(--space-m) 0 var(--space-2xs);
	}

	.entry__body :global(p) {
		margin: 0 0 var(--space-s);
	}

	.entry__body :global(ul),
	.entry__body :global(ol) {
		margin: 0 0 var(--space-s);
		padding-left: 1.2em;
	}

	.entry__body :global(li) {
		margin-bottom: var(--space-3xs);
	}

	.entry__body :global(a) {
		color: var(--color-link);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: oklch(75% 0.05 27);
		transition: color var(--duration-base) var(--ease-out);
	}

	.entry__body :global(a:hover) {
		color: var(--color-link-hover);
	}

	.entry__body :global(strong) {
		color: var(--color-text);
	}

	.entry__body :global(blockquote) {
		margin: var(--space-l) 0;
		padding: var(--space-s) var(--space-m);
		border-left: 3px solid var(--color-flag-red);
		background: var(--color-bg-soft);
		font-style: italic;
		color: var(--color-text-soft);
	}

	.entry__body :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin: var(--space-m) 0;
		border-radius: var(--radius-s);
	}

	/* ---------- Footer CTA ---------- */
	.entry__footer {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-s);
		padding: var(--space-l);
		background: var(--color-bg-soft);
		border: 1.5px solid var(--color-ink);
		border-radius: var(--radius-l);
	}

	.entry__footer-title {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		margin: 0;
	}

	.entry__footer p {
		font-size: var(--text-base);
		color: var(--color-text-muted);
		margin: 0;
		max-width: 60ch;
	}

	.entry__footer-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
	}
</style>
