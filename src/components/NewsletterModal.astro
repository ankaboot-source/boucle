---
import NewsletterSignup from "./NewsletterSignup.astro";

/*
 * NewsletterModal.astro
 * ---------------------------------------------------------------------------
 * A native <dialog>-based newsletter prompt that opens itself after a
 * configurable period of "inactivity" (no click, scroll, or keypress on
 * the document). Activity cancels the pending open; once dismissed — or
 * once the visitor has subscribed — the modal does not reappear during
 * the same browser session.
 *
 * Uses the native <dialog> element so we get focus trapping, the
 * `::backdrop` pseudo-element, and Escape-to-close for free.
 *
 * Session keys (must match NewsletterSignup.astro):
 *  - `up-newsletter-modal-dismissed` — visitor closed the modal without
 *    subscribing; suppress for the rest of the session.
 *  - `up-newsletter-subscribed` — visitor converted; suppress the modal
 *    and any re-prompt for the rest of the session.
 *
 * Props:
 *  - delayMs: how long to wait before opening (default 30 000 ms).
 *  - heading / description / buttonLabel: copy overrides for the modal.
 */
interface Props {
	delayMs?: number;
	heading?: string;
	description?: string;
	buttonLabel?: string;
}

const {
	delayMs = 30000,
	heading = "Restez informé·e",
	description = "Recevez nos appels à l'action, communiqués et événements locaux. Un email par mois, pas plus.",
	buttonLabel = "S'inscrire",
} = Astro.props;

// Unique id so multiple modals (e.g. nested layouts) don't collide.
const dialogId = "newsletter-modal";
const formId = "newsletter-modal-form";
---

<dialog
	id={dialogId}
	class="newsletter-modal"
	role="dialog"
	aria-modal="true"
	aria-labelledby={`${dialogId}-title`}
	aria-describedby={`${dialogId}-desc`}
	data-newsletter-modal
	data-delay-ms={String(delayMs)}
>
	{/*
	  Note: we do NOT wrap the modal content in `<form method="dialog">`
	  because the embedded <NewsletterSignup /> is itself a <form>, and
	  nested forms are invalid HTML (browsers drop the inner one). Each
	  dismiss control here is wired up via its own click handler in the
	  script below.
	*/}
	<div class="newsletter-modal__shell">
		<header class="newsletter-modal__header">
			<div>
				<p class="eyebrow">Newsletter</p>
				<h2 id={`${dialogId}-title`} class="newsletter-modal__title">
					{heading}
				</h2>
			</div>
			<button
				type="button"
				class="newsletter-modal__close"
				aria-label="Fermer la fenêtre"
				data-newsletter-modal-close
			>
				<svg
					aria-hidden="true"
					viewBox="0 0 24 24"
					width="22"
					height="22"
					focusable="false"
				>
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="2.2"
						stroke-linecap="round"
						d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</header>

		<article class="newsletter-modal__body">
			<p id={`${dialogId}-desc`} class="newsletter-modal__lede">
				{description}
			</p>

			{/*
			  Reuse the block newsletter form. The script in
			  NewsletterSignup.astro already dispatches
			  `up:newsletter:subscribed` on success, which the modal
			  listens for in order to close itself.
			*/}
			<NewsletterSignup
				id={formId}
				variant="block"
				buttonLabel={buttonLabel}
				heading=""
				description=""
				labelledBy={`${dialogId}-title`}
			/>

			<button
				type="button"
				class="newsletter-modal__dismiss"
				data-newsletter-modal-dismiss
			>
				Non merci, pas maintenant
			</button>
		</article>
	</div>
</dialog>

<style>
	.newsletter-modal {
		padding: 0;
		border: none;
		background: transparent;
		color: inherit;
		max-inline-size: min(92vw, 32rem);
		max-block-size: min(90dvb, 100%);
	}

	.newsletter-modal::backdrop {
		background: oklch(15% 0 0 / 0.55);
		backdrop-filter: blur(4px);
	}

	.newsletter-modal__shell {
		display: grid;
		grid-template-rows: auto 1fr;
		background: var(--color-bg);
		border-radius: var(--radius-l);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-lift);
		overflow: hidden;
		max-block-size: inherit;
	}

	.newsletter-modal__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-s);
		padding: var(--space-l) var(--space-l) var(--space-s);
		border-block-end: 1px solid var(--color-border);
		background: var(--color-ink);
		color: var(--color-ink-on-dark);
	}

	.newsletter-modal__header .eyebrow {
		color: color-mix(in oklch, var(--color-ink-on-dark) 70%, transparent);
		margin: 0 0 var(--space-2xs);
	}

	.newsletter-modal__title {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-ink-on-dark);
		margin: 0;
		letter-spacing: var(--tracking-tight);
	}

	.newsletter-modal__close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		flex: 0 0 auto;
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--color-ink-on-dark);
		border: 1px solid
			color-mix(in oklch, var(--color-ink-on-dark) 24%, transparent);
		cursor: pointer;
		transition:
			background var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out);
	}

	.newsletter-modal__close:hover,
	.newsletter-modal__close:focus-visible {
		background: color-mix(in oklch, var(--color-ink-on-dark) 12%, transparent);
		border-color: color-mix(in oklch, var(--color-ink-on-dark) 40%, transparent);
	}

	.newsletter-modal__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
		padding: var(--space-l);
		overflow-y: auto;
		overscroll-behavior-y: contain;
	}

	.newsletter-modal__lede {
		font-size: var(--text-base);
		color: var(--color-text-muted);
		margin: 0;
	}

	/*
	  The NewsletterSignup form inside the modal: hide the redundant
	  heading/description/hint so only the input + button + success state
	  show. The form provides its own aria-labelledby which we override
	  with aria-label here for clarity.
	*/
	.newsletter-modal .newsletter__intro,
	.newsletter-modal .newsletter__hint {
		display: none;
	}

	.newsletter-modal__dismiss {
		align-self: center;
		background: transparent;
		border: none;
		padding: var(--space-2xs) var(--space-s);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-muted);
		text-decoration: underline;
		text-underline-offset: 0.25em;
		cursor: pointer;
		transition: color var(--duration-fast) var(--ease-out);
	}

	.newsletter-modal__dismiss:hover,
	.newsletter-modal__dismiss:focus-visible {
		color: var(--color-ink);
	}

	/* ---------- Entry / exit animation (modern browsers) ---------- */

	.newsletter-modal[open] {
		animation: nl-modal-in var(--duration-base) var(--ease-out);
	}

	.newsletter-modal::backdrop {
		animation: nl-backdrop-in var(--duration-base) var(--ease-out);
	}

	@keyframes nl-modal-in {
		from {
			opacity: 0;
			transform: translateY(0.5rem) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes nl-backdrop-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.newsletter-modal[open],
		.newsletter-modal::backdrop {
			animation-duration: 0.01ms;
		}
	}
</style>

<script>
	/*
	 * Inactivity tracker. Opens the <dialog data-newsletter-modal> after
	 * `delayMs` of no activity. Any click / scroll / keypress on the
	 * document cancels the pending timer. Once the dialog is closed
	 * (whether by Escape, the close button, the "non merci" button, or
	 * a successful subscription), a `sessionStorage` flag prevents it
	 * from re-appearing in the same tab.
	 *
	 * Robustness notes:
	 *  - The script is wrapped in a defensive init() that no-ops if
	 *    the dialog element is missing, so this component can be safely
	 *    included on a page that strips it.
	 *  - Listeners are removed when the dialog opens, so activity on
	 *    the page behind the modal does not cancel a second timer.
	 *  - We listen to `up:newsletter:subscribed` so the modal closes
	 *    itself the moment the user converts.
	 */
	type ModalEl = HTMLDialogElement & { dataset: DOMStringMap };

	const STORAGE_KEY = "up-newsletter-modal-dismissed";
	const SUBSCRIBED_KEY = "up-newsletter-subscribed";
	const ACTIVITY_EVENTS = ["click", "scroll", "keydown"] as const;

	const isDismissed = (): boolean => {
		try {
			return sessionStorage.getItem(STORAGE_KEY) === "1";
		} catch {
			return false;
		}
	};

	const markDismissed = (): void => {
		try {
			sessionStorage.setItem(STORAGE_KEY, "1");
		} catch {
			// ignore
		}
	};

	const isSubscribed = (): boolean => {
		try {
			return sessionStorage.getItem(SUBSCRIBED_KEY) === "1";
		} catch {
			return false;
		}
	};

	const init = (): void => {
		const dialog = document.querySelector<ModalEl>(
			"dialog[data-newsletter-modal]",
		);
		if (!dialog) return;

		// Already dismissed or already subscribed this session: do nothing.
		// We don't even leave listeners attached — silent & cheap.
		if (isDismissed() || isSubscribed()) return;

		const delay = Number.parseInt(dialog.dataset["delayMs"] ?? "30000", 10);
		const safeDelay = Number.isFinite(delay) && delay > 0 ? delay : 30000;

		let timer: number | null = null;
		const cancelTimer = (): void => {
			if (timer !== null) {
				window.clearTimeout(timer);
				timer = null;
			}
		};

		const scheduleOpen = (): void => {
			if (timer !== null) return;
			timer = window.setTimeout(() => {
				timer = null;
				if (dialog.open) return;
				try {
					dialog.showModal();
				} catch {
					// showModal() throws if invoked from a non-user gesture
					// while the document is still parsing; safe to ignore.
				}
			}, safeDelay);
		};

		const onActivity = (): void => {
			// Activity before the modal opens → cancel and don't re-arm.
			if (!dialog.open) {
				cancelTimer();
				detach();
			}
		};

		const detach = (): void => {
			for (const ev of ACTIVITY_EVENTS) {
				document.removeEventListener(ev, onActivity, { capture: true });
			}
		};

		const attach = (): void => {
			for (const ev of ACTIVITY_EVENTS) {
				document.addEventListener(ev, onActivity, {
					passive: true,
					capture: true,
				});
			}
		};

		const onClose = (): void => {
			// If the user closed the dialog (any reason) and didn't
			// convert, remember the dismissal for this session.
			if (!isSubscribed()) {
				markDismissed();
			}
			// Re-arm listeners so the modal COULD open again later if
			// we ever wanted to (currently the session flag prevents
			// that, but this keeps the script idempotent across HMR /
			// client-side navigation).
			attach();
		};

		const onSubscribed = (): void => {
			markDismissed();
			if (dialog.open) dialog.close("subscribed");
		};

		// Wire up close controls inside the dialog.
		const closeButton = dialog.querySelector<HTMLElement>(
			"[data-newsletter-modal-close]",
		);
		const dismissButton = dialog.querySelector<HTMLElement>(
			"[data-newsletter-modal-dismiss]",
		);
		closeButton?.addEventListener("click", () => {
			// `returnValue` is arbitrary; the listener just needs to fire.
			dialog.close("dismissed");
		});
		dismissButton?.addEventListener("click", () => {
			dialog.close("dismissed");
		});

		dialog.addEventListener("close", onClose);
		document.addEventListener("up:newsletter:subscribed", onSubscribed);

		// Click on the backdrop closes the modal. The native dialog
		// reports clicks on the ::backdrop pseudo as clicks where
		// event.target === dialog itself.
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) dialog.close("dismissed");
		});

		attach();
		scheduleOpen();
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init, { once: true });
	} else {
		init();
	}
</script>
