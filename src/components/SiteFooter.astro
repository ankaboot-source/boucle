---
import NewsletterSignup from "./NewsletterSignup.astro";

/*
 * SiteFooter.astro
 * ---------------------------------------------------------------------------
 * The site-wide footer. Renders the tri-color flag stripe, a brand
 * statement, a small nav column, and the compact newsletter signup
 * component (which is required to be embedded in the footer per the
 * issue acceptance criteria).
 */
const year = new Date().getFullYear();
---

<footer class="site-footer" aria-labelledby="site-footer-title">
	<div
		class="flag-stripe flag-stripe--small"
		role="img"
		aria-label="Drapeau palestinien : noir, blanc, vert, rouge"
	>
		<span class="flag-stripe__band flag-stripe__band--black"></span>
		<span class="flag-stripe__band flag-stripe__band--white"></span>
		<span class="flag-stripe__band flag-stripe__band--green"></span>
		<span class="flag-stripe__band flag-stripe__band--red"></span>
	</div>

	<div class="site-footer__inner">
		<div class="site-footer__brand">
			<p class="eyebrow">Urgence Palestine</p>
			<h2 id="site-footer-title" class="site-footer__title">
				Solidarité avec la Palestine.
			</h2>
			<p class="site-footer__lede">
				Une plateforme d'information, d'action et de mémoire.
				Indépendante, à but non lucratif, financée par vos dons.
			</p>
		</div>

		<nav class="site-footer__nav" aria-label="Pied de page">
			<h3 class="site-footer__col-title">Explorer</h3>
			<ul>
				<li><a href="/">Accueil</a></li>
				<li><a href="/symboles">Symboles</a></li>
				<li><a href="/engagement">S'engager</a></li>
			</ul>
		</nav>

		<div class="site-footer__newsletter">
			<NewsletterSignup
				id="newsletter-footer"
				variant="footer"
				heading="La newsletter"
				description=""
				buttonLabel="OK"
			/>
		</div>
	</div>

	<div class="site-footer__legal">
		<p>
			© {year} Urgence Palestine. Tous droits réservés.
			<a href="/mentions-legales">Mentions légales</a> ·
			<a href="/contact">Contact</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-3xl);
		background: var(--color-ink);
		color: var(--color-ink-on-dark);
	}

	.flag-stripe--small {
		height: 6px;
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-l);
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
		padding: var(--space-2xl) 0 var(--space-l);
	}

	@media (min-width: 48rem) {
		.site-footer__inner {
			grid-template-columns: 1.4fr 0.8fr 1.4fr;
			align-items: start;
		}
	}

	.site-footer__title {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-ink-on-dark);
		margin: var(--space-2xs) 0 var(--space-s);
		letter-spacing: var(--tracking-tight);
		max-width: 18ch;
	}

	.site-footer__lede {
		font-size: var(--text-sm);
		color: color-mix(in oklch, var(--color-ink-on-dark) 75%, transparent);
		max-width: 42ch;
		margin: 0;
	}

	.site-footer .eyebrow {
		color: color-mix(in oklch, var(--color-ink-on-dark) 70%, transparent);
	}

	.site-footer__col-title {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-mega);
		text-transform: uppercase;
		color: color-mix(in oklch, var(--color-ink-on-dark) 70%, transparent);
		margin: 0 0 var(--space-s);
	}

	.site-footer__nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.site-footer__nav a {
		color: var(--color-ink-on-dark);
		text-decoration: none;
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.site-footer__nav a:hover,
	.site-footer__nav a:focus-visible {
		color: var(--color-flag-red);
	}

	/*
	  Force light-coloured form controls over the dark footer. The
	  NewsletterSignup component already has its own tokens-driven
	  palette; we just re-bind a few local variables so the
	  foreground/background align with the inverted surface.
	*/
	.site-footer .newsletter__heading {
		color: var(--color-ink-on-dark);
	}

	.site-footer .newsletter__input {
		background: color-mix(in oklch, var(--color-ink-on-dark) 8%, transparent);
		border-color: color-mix(in oklch, var(--color-ink-on-dark) 24%, transparent);
		color: var(--color-ink-on-dark);
	}

	.site-footer .newsletter__input::placeholder {
		color: color-mix(in oklch, var(--color-ink-on-dark) 55%, transparent);
	}

	.site-footer .newsletter__input:hover {
		border-color: color-mix(in oklch, var(--color-ink-on-dark) 50%, transparent);
	}

	.site-footer .newsletter__input:focus-visible {
		border-color: var(--color-ink-on-dark);
		box-shadow: 0 0 0 3px
			color-mix(in oklch, var(--color-ink-on-dark) 18%, transparent);
	}

	.site-footer .newsletter__hint {
		color: color-mix(in oklch, var(--color-ink-on-dark) 60%, transparent);
	}

	.site-footer .newsletter__success {
		background: color-mix(in oklch, var(--color-flag-green) 30%, transparent);
		color: var(--color-ink-on-dark);
	}

	.site-footer__legal {
		border-block-start: 1px solid
			color-mix(in oklch, var(--color-ink-on-dark) 18%, transparent);
		padding: var(--space-s) 0;
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
	}

	.site-footer__legal p {
		margin: 0;
		font-size: var(--text-xs);
		color: color-mix(in oklch, var(--color-ink-on-dark) 60%, transparent);
	}

	.site-footer__legal a {
		color: color-mix(in oklch, var(--color-ink-on-dark) 80%, transparent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
