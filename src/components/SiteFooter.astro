---
/*
 * SiteFooter.astro
 * ---------------------------------------------------------------------------
 * Site-wide footer: brand statement, navigation, social links and legal
 * copy. The newsletter signup now lives in a single dedicated block on the
 * homepage, so the footer only links to social networks.
 */
import { socialLinks } from "../data/social-links.ts";

const year = new Date().getFullYear();
---

<footer class="site-footer" aria-labelledby="site-footer-title">
	<div
		class="flag-stripe flag-stripe--small"
		role="img"
		aria-label="Drapeau palestinien : noir, blanc, vert, rouge"
	>
		<span class="flag-stripe__band flag-stripe__band--black"></span>
		<span class="flag-stripe__band flag-stripe__band--white"></span>
		<span class="flag-stripe__band flag-stripe__band--green"></span>
		<span class="flag-stripe__band flag-stripe__band--red"></span>
	</div>

	<div class="site-footer__inner">
		<div class="site-footer__brand">
			<p class="eyebrow">Urgence Palestine</p>
			<h2 id="site-footer-title" class="site-footer__title">
				Solidarité avec la Palestine.
			</h2>
			<p class="site-footer__lede">
				Une plateforme d'information, d'action et de mémoire.
				Indépendante, à but non lucratif, financée par vos dons.
			</p>
		</div>

		<nav class="site-footer__nav" aria-label="Pied de page">
			<h3 class="site-footer__col-title">Explorer</h3>
			<ul>
				<li><a href="/">Accueil</a></li>
				<li><a href="/credits">Crédits</a></li>
				<li><a href="/engagement">S'engager</a></li>
			</ul>
		</nav>

		<nav class="site-footer__nav" aria-label="Réseaux sociaux">
			<h3 class="site-footer__col-title">Réseaux sociaux</h3>
			<ul>
				{
					socialLinks.map((link) => (
						<li>
							<a href={link.href} target="_blank" rel="noopener">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	<div class="site-footer__legal">
		<p>
			© {year} Urgence Palestine. Tous droits réservés.
			<a href="/mentions-legales">Mentions légales</a> ·
			<a href="/contact">Contact</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-3xl);
		background: var(--color-ink);
		color: var(--color-ink-on-dark);
	}

	.flag-stripe--small {
		height: 6px;
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-l);
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
		padding: var(--space-2xl) 0 var(--space-l);
	}

	@media (min-width: 48rem) {
		.site-footer__inner {
			grid-template-columns: 1.4fr 0.8fr 1.4fr;
			align-items: start;
		}
	}

	.site-footer__title {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-ink-on-dark);
		margin: var(--space-2xs) 0 var(--space-s);
		letter-spacing: var(--tracking-tight);
		max-width: 18ch;
	}

	.site-footer__lede {
		font-size: var(--text-sm);
		color: color-mix(in oklch, var(--color-ink-on-dark) 75%, transparent);
		max-width: 42ch;
		margin: 0;
	}

	.site-footer .eyebrow {
		color: color-mix(in oklch, var(--color-ink-on-dark) 70%, transparent);
	}

	.site-footer__col-title {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-mega);
		text-transform: uppercase;
		color: color-mix(in oklch, var(--color-ink-on-dark) 70%, transparent);
		margin: 0 0 var(--space-s);
	}

	.site-footer__nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.site-footer__nav a {
		color: var(--color-ink-on-dark);
		text-decoration: none;
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.site-footer__nav a:hover,
	.site-footer__nav a:focus-visible {
		color: var(--color-flag-red);
	}

	.site-footer__legal {
		border-block-start: 1px solid
			color-mix(in oklch, var(--color-ink-on-dark) 18%, transparent);
		padding: var(--space-s) 0;
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
	}

	.site-footer__legal p {
		margin: 0;
		font-size: var(--text-xs);
		color: color-mix(in oklch, var(--color-ink-on-dark) 60%, transparent);
	}

	.site-footer__legal a {
		color: color-mix(in oklch, var(--color-ink-on-dark) 80%, transparent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
