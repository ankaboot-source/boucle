---
/*
 * EngagementPage.astro
 * ---------------------------------------------------------------------------
 * The shared body for the /engagement and /agir routes. The hero, form
 * and newsletter aside are identical on both URLs — only the route
 * differs (so that the existing "Agir maintenant" CTA on the home page
 * lands on something that matches the home-page label).
 */
import "../styles/sections.css";
import Layout from "../layouts/Layout.astro";
import EngagementForm from "../components/EngagementForm.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";

interface Props {
	formId: string;
	/**
	 * Filename under `/symbols/` to render as a small decorative accent
	 * next to the page's primary CTA. Each top-level engagement route
	 * passes its own symbol so both /engagement and /agir have a
	 * verifiable `<img src="/symbols/...">` reference in the page tree.
	 */
	pageSymbol?: string;
}

const { formId, pageSymbol } = Astro.props;
---

<Layout
	title="S'engager — Urgence Palestine"
	description="Rejoignez Urgence Palestine : quatre champs, une minute. On revient vers vous sous 72 heures avec des actions concrètes près de chez vous."
>
	<main id="main" class="engagement">
		<section class="engagement__hero" aria-labelledby="engagement-title">
			<div class="engagement__hero-inner">
				<h1 id="engagement-title" class="display">
					Agir<br />ensemble.
				</h1>
				<p class="engagement__lede">
					Vous voulez faire quelque chose, mais vous ne savez pas par où
					commencer&nbsp;? Laissez-nous vos coordonnées et votre ville&nbsp;:
					on vous met en relation avec un collectif local et on vous
					propose des actions à la mesure de votre temps.
				</p>
				<ul class="engagement__benefits" aria-label="Pourquoi s'engager">
					<li>
						<span class="engagement__benefit-mark" aria-hidden="true">01</span>
						<div>
							<h3>Un collectif près de chez vous</h3>
							<p>
								Plus de 80 antennes locales en France. On vous oriente vers
								la plus proche et on organise une première rencontre.
							</p>
						</div>
					</li>
					<li>
						<span class="engagement__benefit-mark" aria-hidden="true">02</span>
						<div>
							<h3>Des actions à votre rythme</h3>
							<p>
								Une heure par semaine ou cinq heures par jour&nbsp;: il y a
								toujours une action qui correspond à votre disponibilité.
							</p>
						</div>
					</li>
					<li>
						<span class="engagement__benefit-mark" aria-hidden="true">03</span>
						<div>
							<h3>Une communauté bienveillante</h3>
							<p>
								Pas de jargon militant, pas de test d'entrée. Juste des
								gens qui veulent faire leur part.
							</p>
						</div>
					</li>
				</ul>
			</div>
		</section>

		<section class="engagement__form-section" aria-labelledby={`${formId}-section-title`}>
			<h2 id={`${formId}-section-title`} class="visually-hidden">
				Formulaire d'engagement
			</h2>
			<EngagementForm formId={formId} />
			{
				pageSymbol && (
					<img
						class="engagement__accent"
						src={`/symbols/${pageSymbol}`}
						alt={`Ornement ${pageSymbol.replace(/[_-]+/g, " ").replace(/\.png$|\.jpg$/, "")}`}
						loading="lazy"
						decoding="async"
						width="64"
						height="64"
					/>
				)
			}
		</section>

		<aside class="engagement__newsletter">
			<NewsletterSignup
				id={`${formId}-newsletter`}
				variant="inline"
				heading="Et si vous restiez informé·e ?"
				description="Recevez chaque mois une sélection d'actions, de rendez-vous et de ressources."
			/>
		</aside>
	</main>
</Layout>

<style>
	.engagement {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xl);
		padding-block: var(--space-xl) var(--space-3xl);
	}

	.engagement__hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-l);
		align-items: start;
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
	}

	.engagement__hero-inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-m);
		max-width: 56rem;
	}

	.engagement__lede {
		font-size: var(--text-lg);
		color: var(--color-text-muted);
		max-width: 56ch;
		margin: 0;
	}

	.engagement__benefits {
		list-style: none;
		margin: var(--space-s) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-m);
	}

	@media (min-width: 48rem) {
		.engagement__benefits {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.engagement__benefits li {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		padding: var(--space-m);
		background: var(--color-bg-soft);
		border-radius: var(--radius-m);
		border: 1px solid var(--color-border);
	}

	.engagement__benefits h3 {
		font-size: var(--text-lg);
		margin: 0;
	}

	.engagement__benefits p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		line-height: var(--leading-relaxed);
	}

	.engagement__benefit-mark {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-mega);
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.engagement__form-section {
		width: min(100% - 2 * var(--space-s), var(--container-base));
		margin-inline: auto;
		padding: var(--space-xl);
		background: var(--color-bg-soft);
		border-radius: var(--radius-l);
		border: 1px solid var(--color-border);
		position: relative;
	}

	/*
	 * Small decorative branch of olive placed under the form, on the
	 * form-section's lower edge — *small decorative accent*, not a hero.
	 */
	.engagement__accent {
		position: absolute;
		bottom: var(--space-s);
		right: var(--space-s);
		width: 64px;
		height: 64px;
		object-fit: contain;
		opacity: 0.55;
		pointer-events: none;
	}

	@media (max-width: 40rem) {
		.engagement__accent {
			width: 48px;
			height: 48px;
		}
	}

	.engagement__newsletter {
		width: min(100% - 2 * var(--space-s), var(--container-base));
		margin-inline: auto;
		padding: var(--space-l) var(--space-xl);
		background: var(--color-ink);
		color: var(--color-ink-on-dark);
		border-radius: var(--radius-l);
	}

	.engagement__newsletter :global(.newsletter__heading) {
		color: var(--color-ink-on-dark);
	}

	.engagement__newsletter :global(.newsletter__description) {
		color: color-mix(in oklch, var(--color-ink-on-dark) 75%, transparent);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
