---
/*
 * SocialCTA
 * -----------------------------------------------------------------------------
 * Large homepage call-to-action block for the collectif's social networks.
 * Renders Instagram, TikTok, Telegram and Facebook as big, hard-edged,
 * flag-palette buttons, each with its network icon + label.
 *
 * Props:
 *  - id: optional unique id (used for aria-labelledby).
 *  - heading: override the block title (default shared with newsletter).
 *  - description: optional lede below the title.
 */
import { socialLinks } from "../data/social-links.ts";

interface Props {
	id?: string;
	heading?: string;
	description?: string;
}

const {
	id = "social-cta",
	heading = "Restons en contact. Poursuivons la mobilisation.",
	description = "Rejoignez-nous sur les réseaux pour relayer chaque appel, chaque mobilisation, chaque victoire.",
} = Astro.props;

const titleId = `${id}-title`;
---

<section class="social-cta" aria-labelledby={titleId}>
	<div class="social-cta__inner">
		<header class="social-cta__head">
			<h2 id={titleId} class="social-cta__heading">{heading}</h2>
			<p class="social-cta__description">{description}</p>
		</header>

		<ul class="social-cta__list" aria-label="Réseaux sociaux">
			{
				socialLinks.map((link) => (
					<li class="social-cta__item">
						<a
							class="social-cta__link"
							href={link.href}
							target="_blank"
							rel="noopener"
							aria-label={`${link.label} — ouvre dans un nouvel onglet`}
						>
							<svg
								class="social-cta__icon"
								viewBox="0 0 24 24"
								width="24"
								height="24"
								aria-hidden="true"
								focusable="false"
							>
								<path fill="currentColor" d={link.icon} />
							</svg>
							<span class="social-cta__label">{link.label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.social-cta {
		width: 100%;
		border: 2px solid var(--color-ink);
		background: var(--color-bg);
		color: var(--color-text);
		border-radius: var(--radius-sharp);
	}

	.social-cta__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-m);
		padding: clamp(var(--space-m), 4vw, var(--space-xl));
		height: 100%;
	}

	.social-cta__head {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.social-cta__heading {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-ink);
		margin: 0;
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
	}

	.social-cta__description {
		font-size: var(--text-base);
		color: var(--color-text-muted);
		margin: 0;
	}

	.social-cta__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
		flex: 1 1 auto;
	}

	.social-cta__item {
		display: flex;
	}

	.social-cta__link {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: var(--space-s);
		width: 100%;
		min-height: 56px;
		padding: var(--space-xs) var(--space-s);
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-flag-white);
		background: var(--color-flag-red);
		border: 2px solid var(--color-ink);
		border-radius: var(--radius-sharp);
		transition:
			background-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.social-cta__link:hover,
	.social-cta__link:focus-visible {
		background: var(--color-ink);
		color: var(--color-flag-white);
		border-color: var(--color-ink);
		transform: translateY(-2px);
	}

	.social-cta__link:focus-visible {
		outline: 3px solid var(--color-flag-white);
		outline-offset: -3px;
	}

	/* Per-button flag palette accents (kept subtle via dark ink). */
	.social-cta__item:nth-child(1) .social-cta__link {
		background: var(--color-flag-black);
	}

	.social-cta__item:nth-child(2) .social-cta__link {
		background: var(--color-flag-red);
	}

	.social-cta__item:nth-child(3) .social-cta__link {
		background: var(--color-flag-green);
	}

	.social-cta__item:nth-child(4) .social-cta__link {
		background: var(--color-flag-red-deep);
	}

	.social-cta__item .social-cta__link:hover,
	.social-cta__item .social-cta__link:focus-visible {
		background: var(--color-ink);
		color: var(--color-flag-white);
		border-color: var(--color-ink);
	}

	.social-cta__icon {
		flex: 0 0 auto;
		width: 24px;
		height: 24px;
	}

	.social-cta__label {
		line-height: 1;
	}
</style>
