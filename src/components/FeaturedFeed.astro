---
/*
 * FeaturedFeed
 * ------------
 * Curated "À la une" rail for the homepage. Six hand-picked items
 * sourced from the static /communiques/ folder (the same images that
 * illustrate the Markdown entries in `src/content/prises-de-parole/`).
 *
 * The list is static on purpose: the issue asks for no Astro content
 * collection here, and the homepage should only surface the editorial
 * picks the collectif wants to highlight.
 *
 * Each card is a single link (one tab stop) with a visible border, the image
 * and a solid black strip that always shows the title, date and category.
 * The strip darkens on hover/focus so keyboard and touch users get the same
 * information as mouse users.
 */

type FeedItem = {
	title: string;
	slug: string;
	image: string;
	date: string;
	category: "communique" | "analyse" | "appel-a-mobilisation";
	ratio: "1-1" | "4-5" | "4-3";
};

const categoryLabel: Record<FeedItem["category"], string> = {
	communique: "Communiqué",
	analyse: "Analyse",
	"appel-a-mobilisation": "Appel à mobilisation",
};

const dateFormatter = new Intl.DateTimeFormat("fr-FR", {
	day: "numeric",
	month: "long",
	year: "numeric",
});

const parseDate = (raw: string) => {
	const [y, m, d] = raw.split("-").map(Number);
	return new Date(y, m - 1, d);
};

const items: FeedItem[] = [
	{
		title: "Pour un 8 mars antisioniste et anticolonialiste",
		slug: "8mars2024",
		image: "/communiques/8mars2024/up-8-mars-anticolonialiste-final1.png",
		date: "2024-03-07",
		category: "appel-a-mobilisation",
		ratio: "1-1",
	},
	{
		title: "Cessez-le-feu à Gaza",
		slug: "cessez-le-feu-a-gaza",
		image: "/communiques/cessez-le-feu-a-gaza/whatsapp-image-2025-01-16-at-09-46-30.jpeg",
		date: "2025-01-16",
		category: "communique",
		ratio: "4-5",
	},
	{
		title: "77 ans de Nakba : l’héritage de l’Europe, notre responsabilité",
		slug: "77-ans-de-nakba-lheritage-de-leurope-notre-responsabilite",
		image: "/communiques/77-ans-de-nakba-lheritage-de-leurope-notre-responsabilite/visuel-nakba77.jpeg",
		date: "2025-04-22",
		category: "communique",
		ratio: "4-3",
	},
	{
		title: "8 Mars : un collectif sioniste agresse des manifestant·es",
		slug: "8mars2024-2",
		image: "/communiques/8mars2024-2/couv-agression-8-mars.png",
		date: "2024-03-08",
		category: "appel-a-mobilisation",
		ratio: "4-5",
	},
	{
		title: "Non à la dissolution d’Urgence Palestine !",
		slug: "non-a-la-dissolution-durgence-palestine",
		image: "/communiques/non-a-la-dissolution-durgence-palestine/cp-dissolution.png",
		date: "2025-04-30",
		category: "communique",
		ratio: "4-5",
	},
	{
		title: "CP Sogena",
		slug: "cp-sogena",
		image: "/communiques/cp-sogena/communique-de-presse1.png",
		date: "2024-11-02",
		category: "communique",
		ratio: "1-1",
	},
];
---

<section class="featured-feed" aria-label="À la une, prises de parole">
	<ul class="featured-feed__list" role="list">
		{
			items.map((item) => {
				const label = `${item.title} — ${categoryLabel[item.category]} · ${dateFormatter.format(parseDate(item.date))}`;
				return (
					<li class="featured-feed__item">
						<a
							class={`featured-feed__card featured-feed__card--ratio-${item.ratio}`}
							href={`/prises-de-parole/${item.slug}/`}
							aria-label={label}
						>
							<img
								class="featured-feed__image"
								src={item.image}
								alt=""
								loading="lazy"
								decoding="async"
							/>
							<span class="featured-feed__overlay" aria-hidden="true">
								<span class="featured-feed__title">{item.title}</span>
								<time class="featured-feed__date" datetime={item.date}>
									{dateFormatter.format(parseDate(item.date))}
								</time>
							</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</section>
