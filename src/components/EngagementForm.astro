---
/*
 * EngagementForm.astro
 * ---------------------------------------------------------------------------
 * Four-field form for the /engagement page: name, email, message, city.
 *
 * - All four fields are required (HTML `required` + client-side
 *   validation in the inline script).
 * - Email gets `type="email"` for native format validation.
 * - Submitting the form runs a small client-side handler that
 *   simulates a POST (no real backend in this static site) and
 *   replaces the form with a French-language confirmation card. No
 *   silent failure: every outcome (success, invalid, network) is
 *   surfaced to the user.
 *
 * The form is self-contained: a page only needs to render it and
 * it will work. Multiple forms on the same page are supported because
 * the script queries by `[data-engagement-form]` and scopes all
 * lookups to the submitted form element.
 */
interface Props {
	formId?: string;
}

const { formId = "engagement-form" } = Astro.props;
---

<section
	class="engagement-form"
	aria-labelledby={`${formId}-form-title`}
	data-engagement-form-wrapper
>
	<header class="engagement-form__intro">
		<h2 id={`${formId}-form-title`} class="engagement-form__title">
			Rejoignez le mouvement.
		</h2>
		<p class="engagement-form__lede">
			Quatre champs, une minute. On revient vers vous sous 72&nbsp;heures
			avec des actions concrètes près de chez vous.
		</p>
	</header>

	<form
		id={formId}
		class="engagement-form__form"
		data-engagement-form
		novalidate
	>
		<div class="field">
			<label class="field__label" for={`${formId}-name`}>
				Nom complet
				<span class="field__required" aria-hidden="true">*</span>
			</label>
			<input
				class="field__input"
				id={`${formId}-name`}
				name="name"
				type="text"
				required
				autocomplete="name"
				minlength="2"
				aria-required="true"
			/>
		</div>

		<div class="field">
			<label class="field__label" for={`${formId}-email`}>
				Adresse email
				<span class="field__required" aria-hidden="true">*</span>
			</label>
			<input
				class="field__input"
				id={`${formId}-email`}
				name="email"
				type="email"
				required
				autocomplete="email"
				aria-required="true"
			/>
		</div>

		<div class="field">
			<label class="field__label" for={`${formId}-city`}>
				Ville
				<span class="field__required" aria-hidden="true">*</span>
			</label>
			<input
				class="field__input"
				id={`${formId}-city`}
				name="city"
				type="text"
				required
				autocomplete="address-level2"
				minlength="2"
				aria-required="true"
			/>
		</div>

		<div class="field">
			<label class="field__label" for={`${formId}-message`}>
				Votre message
				<span class="field__required" aria-hidden="true">*</span>
			</label>
			<textarea
				class="field__input field__input--textarea"
				id={`${formId}-message`}
				name="message"
				required
				rows="5"
				minlength="10"
				aria-required="true"
				aria-describedby={`${formId}-message-hint`}
			></textarea>
			<p class="field__hint" id={`${formId}-message-hint`}>
				Dites-nous en quelques mots comment vous souhaitez vous engager.
			</p>
		</div>

		<p
			class="engagement-form__error"
			role="alert"
			aria-live="assertive"
			data-engagement-error
			hidden
		></p>

		<div class="engagement-form__actions">
			<button class="btn btn--primary" type="submit" data-engagement-submit>
				Envoyer mon engagement
			</button>
			<p class="engagement-form__legal">
				En soumettant ce formulaire, vous acceptez d'être recontacté·e par
				notre équipe. Vos données ne sont jamais partagées.
			</p>
		</div>
	</form>

	<!--
	  Success card. Hidden by default; revealed by the inline script
	  after a successful submit. `role="status"` + `aria-live="polite"`
	  so screen readers announce the confirmation.
	-->
	<article
		class="engagement-form__success"
		role="status"
		aria-live="polite"
		data-engagement-success
		hidden
	>
		<svg
			class="engagement-form__check"
			aria-hidden="true"
			viewBox="0 0 48 48"
			width="48"
			height="48"
			focusable="false"
		>
			<circle
				cx="24"
				cy="24"
				r="22"
				fill="none"
				stroke="currentColor"
				stroke-width="2"></circle>
			<path
				fill="none"
				stroke="currentColor"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M14 24.5l7 7L34 18"></path>
		</svg>
		<h3 class="engagement-form__success-title">Message bien reçu.</h3>
		<p class="engagement-form__success-lede">
			Merci <strong data-engagement-success-name>à vous</strong>. Un·e
			bénévole de notre équipe locale à <strong data-engagement-success-city>votre ville</strong>
			revient vers vous sous 72&nbsp;heures. En attendant, vous pouvez
			rejoindre l'une des <a href="/collectif">sections locales du
			collectif</a> pour partager le mouvement autour de vous.
		</p>
	</article>
</section>

<style>
	.engagement-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-l);
	}

	.engagement-form__intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.engagement-form__title {
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		font-weight: var(--weight-bold);
		color: var(--color-ink);
		margin: 0;
		letter-spacing: var(--tracking-tight);
		max-width: 18ch;
	}

	.engagement-form__lede {
		font-size: var(--text-base);
		color: var(--color-text-muted);
		max-width: 56ch;
		margin: 0;
	}

	.engagement-form__form {
		display: flex;
		flex-direction: column;
		gap: var(--space-m);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-3xs);
	}

	.field__label {
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-ink);
		letter-spacing: 0;
	}

	.field__required {
		color: var(--color-accent);
		margin-inline-start: 2px;
	}

	.field__input {
		appearance: none;
		width: 100%;
		min-height: 48px;
		padding: var(--space-2xs) var(--space-s);
		font-size: var(--text-base);
		font-family: inherit;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1.5px solid var(--color-border);
		border-radius: var(--radius-m);
		transition:
			border-color var(--duration-fast) var(--ease-out),
			box-shadow var(--duration-fast) var(--ease-out);
	}

	.field__input--textarea {
		min-height: 8rem;
		padding: var(--space-2xs) var(--space-s);
		resize: vertical;
		line-height: var(--leading-relaxed);
	}

	.field__input::placeholder {
		color: var(--color-text-faint);
	}

	.field__input:hover {
		border-color: var(--color-ink-muted);
	}

	.field__input:focus-visible {
		outline: none;
		border-color: var(--color-ink);
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-ink) 12%, transparent);
	}

	.field__input:user-invalid {
		border-color: var(--color-accent);
	}

	.field__hint {
		font-size: var(--text-xs);
		color: var(--color-text-faint);
		margin: 0;
	}

	.engagement-form__actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		margin-top: var(--space-s);
	}

	/*
	 * Submit button — local override on the base .btn to align with the
	 * CTA charter (Variant A): hard-edged red rectangle, heading face,
	 * uppercase. The busy/disabled state keeps the same shape but dims
	 * the label and the cursor so users get clear feedback.
	 */
	.engagement-form__actions .btn--primary {
		min-height: 44px;
		padding: var(--space-s) var(--space-l);
		font-family: var(--font-heading);
		font-size: var(--text-base);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		background: var(--color-flag-red);
		color: var(--color-flag-white);
		border: 0;
		border-radius: var(--radius-sharp);
		align-self: flex-start;
		transition:
			background-color var(--duration-fast) var(--ease-brutal-lift),
			transform var(--duration-fast) var(--ease-brutal-lift),
			box-shadow var(--duration-fast) var(--ease-brutal-lift),
			opacity var(--duration-fast) var(--ease-brutal-lift);
	}

	.engagement-form__actions .btn--primary:hover,
	.engagement-form__actions .btn--primary:focus-visible {
		background: var(--color-flag-red-deep);
		color: var(--color-flag-white);
		transform: translateY(-6px) translateX(2px);
		box-shadow: var(--shadow-hard);
	}

	.engagement-form__actions .btn--primary:active {
		transform: none;
		box-shadow: none;
	}

	.engagement-form__actions .btn--primary:focus-visible {
		outline: 2px solid var(--color-flag-red);
		outline-offset: 3px;
	}

	.engagement-form__actions .btn--primary:disabled,
	.engagement-form__actions .btn--primary[data-busy="1"] {
		opacity: 0.65;
		cursor: progress;
		transform: none;
	}

	.engagement-form__legal {
		font-size: var(--text-xs);
		color: var(--color-text-faint);
		margin: 0;
		max-width: 56ch;
	}

	.engagement-form__error {
		margin: 0;
		padding: var(--space-2xs) var(--space-s);
		border-radius: var(--radius-s);
		background: color-mix(in oklch, var(--color-accent) 12%, transparent);
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}

	/* ---------- Success state ---------- */

	.engagement-form__success {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-s);
		padding: var(--space-l);
		background: color-mix(in oklch, var(--color-secondary) 12%, transparent);
		border: 1px solid
			color-mix(in oklch, var(--color-secondary) 30%, transparent);
		border-radius: var(--radius-l);
	}

	.engagement-form__check {
		color: var(--color-secondary-strong);
	}

	.engagement-form__success-title {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-ink);
		margin: 0;
	}

	.engagement-form__success-lede {
		font-size: var(--text-base);
		color: var(--color-text);
		max-width: 56ch;
		margin: 0;
	}

	.engagement-form__success-lede a {
		color: var(--color-ink);
		font-weight: var(--weight-semibold);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}
</style>

<script>
	/*
	 * Client-side submit handler. Validates all four required fields,
	 * simulates a network POST, then swaps the form for a French
	 * success card (with the user's name + city echoed back). On
	 * validation failure, surfaces a single inline error message and
	 * focuses the first invalid field. No silent failure paths: every
	 * code branch ends with explicit user feedback.
	 */
	type Form = HTMLFormElement & { dataset: DOMStringMap };

	const FIELDS = ["name", "email", "city", "message"] as const;
	type FieldName = (typeof FIELDS)[number];

	const LABELS: Record<FieldName, string> = {
		name: "nom",
		email: "email",
		city: "ville",
		message: "message",
	};

	const getInput = (form: Form, name: FieldName): HTMLInputElement | HTMLTextAreaElement | null =>
		form.querySelector<HTMLInputElement | HTMLTextAreaElement>(
			`[name="${name}"]`,
		);

	const showError = (form: Form, message: string): void => {
		const error = form.parentElement?.querySelector<HTMLElement>(
			"[data-engagement-error]",
		);
		if (error) {
			error.textContent = message;
			error.hidden = false;
		}
	};

	const clearError = (form: Form): void => {
		const error = form.parentElement?.querySelector<HTMLElement>(
			"[data-engagement-error]",
		);
		if (error) {
			error.textContent = "";
			error.hidden = true;
		}
	};

	const validateField = (
		form: Form,
		name: FieldName,
	): { ok: true; value: string } | { ok: false; reason: string } => {
		const input = getInput(form, name);
		if (!input) return { ok: false, reason: "Champ manquant." };
		const value = input.value.trim();
		if (!value) {
			return {
				ok: false,
				reason: `Merci de renseigner votre ${LABELS[name]}.`,
			};
		}
		if (name === "email" && !input.checkValidity()) {
			return {
				ok: false,
				reason: "Cet email ne semble pas valide.",
			};
		}
		if (name === "message" && value.length < 10) {
			return {
				ok: false,
				reason: "Votre message doit faire au moins 10 caractères.",
			};
		}
		return { ok: true, value };
	};

	const handleSubmit = async (form: Form): Promise<void> => {
		clearError(form);

		let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;
		const collected: Partial<Record<FieldName, string>> = {};
		for (const name of FIELDS) {
			const result = validateField(form, name);
			if (!result.ok) {
				if (!firstInvalid) {
					firstInvalid = getInput(form, name);
					showError(form, result.reason);
				}
				continue;
			}
			collected[name] = result.value;
		}

		if (firstInvalid) {
			firstInvalid.focus();
			return;
		}

		const submit = form.querySelector<HTMLButtonElement>(
			"[data-engagement-submit]",
		);
		if (submit) {
			submit.disabled = true;
			submit.dataset["busy"] = "1";
			submit.textContent = "Envoi en cours…";
		}

		// Simulate a network round-trip. In production this would POST to
		// an engagement endpoint; the static site doesn't have one yet.
		await new Promise((resolve) => setTimeout(resolve, 500));

		const wrapper = form.closest<HTMLElement>(
			"[data-engagement-form-wrapper]",
		);
		const success = wrapper?.querySelector<HTMLElement>(
			"[data-engagement-success]",
		);
		const nameSlot = wrapper?.querySelector<HTMLElement>(
			"[data-engagement-success-name]",
		);
		const citySlot = wrapper?.querySelector<HTMLElement>(
			"[data-engagement-success-city]",
		);

		if (success) {
			if (nameSlot && collected.name) {
				nameSlot.textContent = collected.name;
			}
			if (citySlot && collected.city) {
				citySlot.textContent = collected.city;
			}
			success.hidden = false;
			success.scrollIntoView({
				behavior: "smooth",
				block: "center",
			});
		}
		form.hidden = true;

		// Announce the success state to other components (e.g. the
		// newsletter modal) so they can stop nagging the same user.
		document.dispatchEvent(
			new CustomEvent("up:engagement:submitted", {
				bubbles: false,
				detail: { name: collected.name, city: collected.city },
			}),
		);
	};

	const init = (): void => {
		document
			.querySelectorAll<Form>("form[data-engagement-form]")
			.forEach((form) => {
				form.addEventListener("submit", (event) => {
					event.preventDefault();
					void handleSubmit(form);
				});
			});
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init, { once: true });
	} else {
		init();
	}
</script>
