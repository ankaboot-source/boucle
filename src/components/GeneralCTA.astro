---
/*
 * GeneralCTA.astro
 * ---------------------------------------------------------------------------
 * A pure-Astro, non-clickable call-to-action block. Renders two stacked
 * stripes — a tall green headline block and a shorter red CTA-label block —
 * built from the brand flag tokens. It carries no interactive element on
 * purpose: this variant is a visual harness for upcoming CTA migrations,
 * not a final link target.
 *
 * The component is intentionally JS-free: no <script>, no `client:*`
 * directive, and no inline event handlers. All sizing/colour comes from
 * design tokens so the harness stays consistent with the rest of the
 * site.
 *
 * Props
 *  - title     (string, required)  Heading text, rendered as the section's
 *                                 accessible name via aria-labelledby.
 *  - ctaLabel  (string, required)  Short label shown on the lower (red)
 *                                 stripe. Rendered as plain text — never
 *                                 wrapped in an <a>.
 *  - tone      (literal, optional) Stripe order. The only supported value
 *                                 today is "green-then-red" (default).
 *  - variant   (literal, optional) Visual layout. "default" keeps the
 *                                 original full-width stripes;
 *                                 "angled-split" renders a text-hugging
 *                                 green headline above an inclined,
 *                                 ascending red label stripe.
 */
interface Props {
	title: string;
	ctaLabel: string;
	tone?: "green-then-red";
	variant?: "default" | "angled-split";
}

const {
	title,
	ctaLabel,
	tone = "green-then-red",
	variant = "default",
} = Astro.props;

// `tone` is reserved for future variants (e.g. red-then-green) — keeping
// the value in a const makes that future branch trivial without re-doing
// the markup below.
void tone;

const isAngledSplit = variant === "angled-split";

// Stable, predictable id so the section's aria-labelledby always resolves.
// Astro scopes styles by class, so we don't need a unique selector here.
const headingId = "general-cta-title";
---

<section
	class:list={["general-cta", { "general-cta--angled-split": isAngledSplit }]}
	aria-labelledby={headingId}
>
	<div class="general-cta__stripe general-cta__stripe--headline">
		<h2 id={headingId} class="general-cta__title"><span>{title}</span></h2>
	</div>
	<div class="general-cta__stripe general-cta__stripe--label" aria-hidden="true">
		<p class="general-cta__label"><span>{ctaLabel}</span></p>
	</div>
</section>

<style>
	/*
	 * Component-scoped styles. Astro rewrites the class selectors below
	 * with a per-instance hash, so they cannot leak to the rest of the
	 * page. The block intentionally uses no animation: a static visual
	 * harness is what the issue asks for.
	 */

	.general-cta {
		display: flex;
		flex-direction: column;
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
		border-radius: 0;
		overflow: hidden;
	}

	/* Both stripes share the same typographic system, white text on the
	 * brand flag colours, and the explicit no-radius policy required by
	 * the spec. The lower stripe stays visibly shorter via smaller
	 * padding and a smaller font size. */
	.general-cta__stripe {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 44px;
		padding-inline: clamp(var(--space-m), 4vw, var(--space-l));
		color: var(--color-flag-white);
		font-family: var(--font-heading);
		text-transform: uppercase;
		border-radius: 0;
	}

	.general-cta__stripe--headline {
		background: var(--color-flag-green);
		padding-block: clamp(var(--space-m), 3vw, var(--space-l));
		gap: var(--space-2xs);
	}

	.general-cta__stripe--label {
		background: var(--color-flag-red);
		padding-block: clamp(var(--space-s), 2vw, var(--space-m));
	}

	.general-cta__title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-flag-white);
		text-transform: uppercase;
		border-radius: 0;
	}

	.general-cta__label {
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-normal);
		color: var(--color-flag-white);
		text-transform: uppercase;
		border-radius: 0;
	}

	/* Variant "angled-split": the coloured background hugs the text,
	 * not the container. The green headline stripe keeps a straight,
	 * horizontal bottom edge and sits in front. The red CTA-label stripe
	 * is inclined by `transform: skewY(-6deg)` so its bottom edge forms
	 * an ascending slope toward the right. The label text is
	 * counter-skewed (`skewY(6deg)`) so it stays horizontal and readable.
	 *
	 * The title uses an inline <span> with `box-decoration-break: clone`
	 * (and the -webkit- prefix) so wrapped lines keep a tight background
	 * with no full-width band between fragments. Both stripes use
	 * `inline-block` + `width: fit-content` so their computed width equals
	 * the longest text line plus tight padding.
	 */
	.general-cta--angled-split {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
		border-radius: 0;
		overflow: visible;
		--cta-angle: 6deg;
	}

	.general-cta--angled-split .general-cta__stripe {
		display: inline-block;
		width: fit-content;
		min-height: 44px;
		padding-inline: 0;
		overflow: visible;
	}

	/* Green headline stripe: stable, horizontal, text-hugging. The span
	 * carries the background and tight padding; the wrapper is only a
	 * sizing/accessibility box. */
	.general-cta--angled-split .general-cta__stripe--headline {
		background: transparent;
		padding-block: 0;
		position: relative;
		z-index: 2;
	}

	.general-cta--angled-split .general-cta__title {
		margin: 0;
	}

	.general-cta--angled-split .general-cta__title span {
		display: inline;
		background: var(--color-flag-green);
		padding-inline: var(--space-xs);
		padding-block: var(--space-2xs) var(--space-xs);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	/* Red label stripe: inclined, ascending slope. The label element
	 * carries the red background and the skew; the inner span holds the
	 * text and is counter-skewed back to horizontal. */
	.general-cta--angled-split .general-cta__stripe--label {
		background: transparent;
		padding-block: 0;
		position: relative;
		z-index: 1;
		margin-top: -1px;
	}

	.general-cta--angled-split .general-cta__label {
		display: inline-block;
		width: fit-content;
		min-height: 44px;
		margin: 0;
		background: var(--color-flag-red);
		padding-inline: var(--space-xs);
		padding-block: var(--space-s);
		transform: skewY(calc(-1 * var(--cta-angle)));
		transform-origin: top left;
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-normal);
		color: var(--color-flag-white);
		text-transform: uppercase;
		border-radius: 0;
		max-width: 100%;
	}

	.general-cta--angled-split .general-cta__label span {
		display: inline-block;
		transform: skewY(var(--cta-angle));
		transform-origin: top left;
		max-width: 100%;
		overflow-wrap: break-word;
	}
</style>
