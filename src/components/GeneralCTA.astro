---
/*
 * GeneralCTA.astro
 * ---------------------------------------------------------------------------
 * A pure-Astro, non-clickable call-to-action block. Renders two stacked
 * stripes — a tall green headline block and a shorter red CTA-label block —
 * built from the brand flag tokens. It carries no interactive element on
 * purpose: this variant is a visual harness for upcoming CTA migrations,
 * not a final link target.
 *
 * The component is intentionally JS-free: no <script>, no `client:*`
 * directive, and no inline event handlers. All sizing/colour comes from
 * design tokens so the harness stays consistent with the rest of the
 * site.
 *
 * Props
 *  - title     (string, required)  Heading text, rendered as the section's
 *                                 accessible name via aria-labelledby.
 *  - ctaLabel  (string, required)  Short label shown on the lower (red)
 *                                 stripe. Rendered as plain text — never
 *                                 wrapped in an <a>.
 *  - eyebrow   (string, optional)  Small uppercase tag above the title.
 *  - tone      (literal, optional) Stripe order. The only supported value
 *                                 today is "green-then-red" (default).
 */
interface Props {
	title: string;
	ctaLabel: string;
	eyebrow?: string;
	tone?: "green-then-red";
}

const { title, ctaLabel, eyebrow, tone = "green-then-red" } = Astro.props;

// `tone` is reserved for future variants (e.g. red-then-green) — keeping
// the value in a const makes that future branch trivial without re-doing
// the markup below.
void tone;

// Stable, predictable id so the section's aria-labelledby always resolves.
// Astro scopes styles by class, so we don't need a unique selector here.
const headingId = "general-cta-title";
---

<section class="general-cta" aria-labelledby={headingId}>
	<div class="general-cta__stripe general-cta__stripe--headline">
		{eyebrow && <p class="general-cta__eyebrow">{eyebrow}</p>}
		<h2 id={headingId} class="general-cta__title">{title}</h2>
	</div>
	<div class="general-cta__stripe general-cta__stripe--label" aria-hidden="true">
		<p class="general-cta__label">{ctaLabel}</p>
	</div>
</section>

<style>
	/*
	 * Component-scoped styles. Astro rewrites the class selectors below
	 * with a per-instance hash, so they cannot leak to the rest of the
	 * page. The block intentionally uses no animation: a static visual
	 * harness is what the issue asks for.
	 */

	.general-cta {
		display: flex;
		flex-direction: column;
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
		border-radius: 0;
		overflow: hidden;
	}

	/* Both stripes share the same typographic system, white text on the
	 * brand flag colours, and the explicit no-radius policy required by
	 * the spec. The lower stripe stays visibly shorter via smaller
	 * padding and a smaller font size. */
	.general-cta__stripe {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 44px;
		padding-inline: clamp(var(--space-m), 4vw, var(--space-l));
		color: var(--color-flag-white);
		font-family: var(--font-heading);
		text-transform: uppercase;
		border-radius: 0;
	}

	.general-cta__stripe--headline {
		background: var(--color-flag-green);
		padding-block: clamp(var(--space-m), 3vw, var(--space-l));
		gap: var(--space-2xs);
	}

	.general-cta__stripe--label {
		background: var(--color-flag-red);
		padding-block: clamp(var(--space-s), 2vw, var(--space-m));
	}

	.general-cta__eyebrow {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-mega);
		color: var(--color-flag-white);
		opacity: 0.9;
	}

	.general-cta__title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-flag-white);
		text-transform: uppercase;
		border-radius: 0;
	}

	.general-cta__label {
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-normal);
		color: var(--color-flag-white);
		text-transform: uppercase;
		border-radius: 0;
	}
</style>
