---
/*
 * AngledSplitCTA.astro
 * ---------------------------------------------------------------------------
 * Reusable, pure-Astro variant of the general CTA: a green headline stripe
 * sits above an ascending red label stripe. The green stripe is a stable
 * text background; the red stripe rises toward the right, and its text rides
 * the same slope. The whole composition is wrapped by GeneralCTA.astro.
 *
 * Rules enforced here:
 *  - coloured background hugs the text (inline-block + fit-content +
 *    box-decoration-break: clone)
 *  - green headline stripe has a straight horizontal bottom edge
 *  - red label stripe is the only inclined element, angle 2–4°
 *  - red label text is skewed with the stripe (not counter-skewed)
 *  - hit-area ≥ 44 px on both stripes
 *  - accessible name comes from the <h2> via aria-labelledby
 */
interface Props {
	title: string;
	ctaLabel: string;
	headingId?: string;
}

const { title, ctaLabel, headingId = "general-cta-title" } = Astro.props;
---

<section
	class="angled-split-cta"
	aria-labelledby={headingId}
>
	<div class="angled-split-cta__stripe angled-split-cta__stripe--headline">
		<h2 id={headingId} class="angled-split-cta__title"><span>{title}</span></h2>
	</div>
	<div class="angled-split-cta__stripe angled-split-cta__stripe--label" aria-hidden="true">
		<p class="angled-split-cta__label"><span>{ctaLabel}</span></p>
	</div>
</section>

<style>
	.angled-split-cta {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		border-radius: 0;
		overflow: visible;
		/* subtle ascending slope for the red stripe only */
		--cta-angle: 2.5deg;
	}

	.angled-split-cta__stripe {
		display: inline-block;
		width: fit-content;
		min-height: 44px;
		padding-inline: 0;
		color: var(--color-flag-white);
		font-family: var(--font-heading);
		text-transform: uppercase;
		border-radius: 0;
		overflow: visible;
	}

	/* Green headline stripe: stable horizontal text background. */
	.angled-split-cta__stripe--headline {
		background: transparent;
		padding-block: 0;
		position: relative;
		z-index: 2;
	}

	.angled-split-cta__title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-flag-white);
		text-transform: uppercase;
		border-radius: 0;
	}

	.angled-split-cta__title span {
		display: inline;
		background: var(--color-flag-green);
		padding-inline: var(--space-xs);
		padding-block: var(--space-2xs) var(--space-xs);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	/* Red label stripe: rises toward the right; text follows the slope. */
	.angled-split-cta__stripe--label {
		background: transparent;
		padding-block: 0;
		position: relative;
		z-index: 1;
		margin-top: var(--space-3xs);
	}

	.angled-split-cta__label {
		display: inline-block;
		width: fit-content;
		min-height: 44px;
		margin: 0;
		background: var(--color-flag-red);
		padding-inline: var(--space-xs);
		padding-block: var(--space-s);
		transform: skewY(calc(-1 * var(--cta-angle)));
		transform-origin: top left;
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-normal);
		color: var(--color-flag-white);
		text-transform: uppercase;
		border-radius: 0;
		max-width: 100%;
	}

	.angled-split-cta__label span {
		display: inline-block;
		transform: skewY(calc(-1 * var(--cta-angle)));
		transform-origin: top left;
		max-width: 100%;
		overflow-wrap: break-word;
	}

	/* Entrance animation: both stripes slide up and fade in sequentially.
	 * Kept compositor-only (transform + opacity) and gated by reduced motion. */
	@keyframes angled-split-rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.angled-split-cta__stripe--headline {
		animation: angled-split-rise var(--duration-slow) var(--ease-out) both;
	}

	.angled-split-cta__stripe--label {
		animation: angled-split-rise var(--duration-slow) var(--ease-out) both;
		animation-delay: calc(var(--duration-base) * 0.6);
	}

	@media (prefers-reduced-motion: reduce) {
		.angled-split-cta__stripe--headline,
		.angled-split-cta__stripe--label {
			animation: none;
		}
	}
</style>
