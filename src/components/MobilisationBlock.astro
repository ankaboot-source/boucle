---
/*
 * MobilisationBlock.astro
 * ---------------------------------------------------------------------------
 * Section "mobilisation" displayed on the home page (`src/pages/index.astro`).
 *
 * Visual contract (issue #31, criterion (a)):
 *  - A photograph of a manifestation is rendered as a `background-image`
 *    on the outer wrapper.
 *  - A solid, uniform overlay (one of the flag tokens — see `--color-flag-*`
 *    in `src/styles/tokens.css`) is layered between the photograph and the
 *    content. The overlay is solid: no decorative gradient
 *    (cf. DESIGN.md §2.2).
 *  - NO body paragraph and NO CTA floats directly over the photograph.
 *    Only the title (a short heading) sits on the overlay, with text colour
 *    chosen for ≥ 4.5:1 contrast against the overlay surface (WCAG 2.1 AA).
 *    The body lede and the CTA live on a separate, clean paper surface
 *    below the photo block.
 *  - The block contains no `<img>` HTML element layered under the content;
 *    the photograph is a CSS `background-image` so the overlay is always
 *    strictly between photo and text (verifiable by inspecting the DOM).
 *
 * Placeholder:
 *  - Until the author supplies a real photograph, a temporary SVG placeholder
 *    ships at `/mobilisation/_placeholder-manifestation.svg` and is marked
 *    `data-placeholder="true"`. The SVG is abstract, royalty-free, and
 *    authored in-house (see the file's header comment for the alternative
 *    sources called out in the issue).
 *  - When the real photo arrives, replace the `backgroundImage` value
 *    below (or pass it via a prop) and drop the `data-placeholder="true"`
 *    attribute.
 */

interface Props {
	/**
	 * Optional override for the background image URL. Defaults to the
	 * temporary placeholder described above.
	 */
	backgroundImage?: string;
	/**
	 * Optional override for the placeholder marker. Set to `false` once
	 * the real photograph lands. The default (`true`) is what the
	 * acceptance criteria check for in `state.md`.
	 */
	isPlaceholder?: boolean;
	/**
	 * Optional override for the overlay tone. Accepts any of the four
	 * flag colours documented in `tokens.css`. Default: flag-red, which
	 * is the brand's primary mobilisation accent (DESIGN.md §3.4).
	 */
	overlayTone?: "red" | "green" | "white" | "black";
}

const {
	backgroundImage = "/mobilisation/_placeholder-manifestation.svg",
	isPlaceholder = true,
	overlayTone = "red",
} = Astro.props;

// Encode the chosen tone as a CSS custom property so it can be consumed
// from the scoped <style> block. The actual colour values are tokens; we
// never inline a hex / oklch literal here.
const overlayVar = `var(--color-flag-${overlayTone})`;

// Style string kept tiny: only the bits that need to be parameter-driven
// are inline. Everything else is in the scoped <style> below.
const wrapperStyle = `background-image: url(${backgroundImage}); --mobilisation-block-overlay: ${overlayVar};`;
---

<section
	class="mobilisation-block"
	style={wrapperStyle}
	data-placeholder={isPlaceholder ? "true" : undefined}
	aria-labelledby="mobilisation-block-title"
>
	{/*
	  The overlay is its own layer. It is rendered BEFORE the content via
	  DOM order + `position: absolute` so it always sits between the photo
	  (on the wrapper) and the content (z-index above the overlay).
	*/}
	<div class="mobilisation-block__overlay" aria-hidden="true"></div>

	<div class="mobilisation-block__photo">
		<!--
		  Only the title (a single short heading) sits on the photo. No
		  body copy, no CTA. The title's colour is chosen for high
		  contrast against the chosen overlay (see style block).
		-->
		<h2 id="mobilisation-block-title" class="mobilisation-block__title">
			On ne se tait pas.<br />On s'organise.
		</h2>
	</div>

	<!--
	  Body lede and CTA live BELOW the photo, on a clean paper surface.
	  They are deliberately NOT on the photograph — this is the
	  "no body / no CTA on the photo" rule from issue #31.
	-->
	<div class="mobilisation-block__content">
		<p class="mobilisation-block__eyebrow">
			<span aria-hidden="true" class="mobilisation-block__eyebrow-bar"></span>
			Mobilisation
		</p>
		<p class="mobilisation-block__lede">
			Trois campagnes de fond&nbsp;— kit militant, boycott,
			prisonnier·es&nbsp;— et les rassemblements des sections locales.
		</p>
		<a class="mobilisation-block__cta" href="/right-to-resist">
			Voir les actions
			<span aria-hidden="true" class="mobilisation-block__cta-arrow">→</span>
		</a>
		<!--
		  Fourth home-page symbol (keffieh in hero + olivier + fleur
		  already visible elsewhere on the page). Triangle rouge is
		  listed in DESIGN.md §5.1 and reads as the mondial
		  "mouvement de solidarité" mark — fitting for a mobilisation
		  call-to-action. Sized small (24 px) per the §5.1 accent rule.
		-->
		<img
			class="mobilisation-block__symbol"
			src="/symbols/red_riangle.png"
			alt="Triangle rouge, symbole du mouvement mondial de solidarité avec la Palestine"
			loading="lazy"
			decoding="async"
			width="24"
			height="24"
		/>
	</div>
</section>

<style>
	/*
	 * Component-scoped styles. Astro rewrites the class selectors with a
	 * per-instance hash, so they cannot leak to the rest of the page.
	 *
	 * Tokens consumed (no hard-coded colour / font-family / radius):
	 *   - --color-flag-{red,green,white,black} (overlay + CTA background)
	 *   - --color-ink-on-dark                  (title on the overlay)
	 *   - --color-paper                        (content surface below)
	 *   - --color-ink                          (default text colour)
	 *   - --font-heading, --font-body          (typography only)
	 *   - --radius-sharp                       (only radius used here)
	 *   - --space-*                            (spacing)
	 *   - --ease-out, --duration-*             (motion)
	 */

	.mobilisation-block {
		position: relative;
		width: min(100% - 2 * var(--space-s), var(--container-wide));
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 2px solid var(--color-flag-black);
		border-radius: var(--radius-sharp);
		/*
		 * Background image is set via inline style (see wrapperStyle above)
		 * so the URL is parameter-driven. The rest of the background
		 * shorthand is repeated here as a baseline.
		 */
		background-color: var(--color-flag-black);
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;
	}

	/*
	 * Overlay sits between the photo and the content. Solid colour,
	 * uniform, no gradient — see DESIGN.md §2.2 (gradients décoratifs
	 * interdits). Alpha is calibrated so silhouettes in the underlying
	 * placeholder SVG still read, but the overlay itself reads as a
	 * deliberate surface (not a tint).
	 */
	.mobilisation-block__overlay {
		position: absolute;
		inset: 0;
		background: var(--mobilisation-block-overlay, var(--color-flag-red));
		opacity: 0.78;
		pointer-events: none;
	}

	/*
	 * Photo block — the layer that holds the title. Z-index 1 keeps it
	 * above the overlay. Min-height is the photographic surface area;
	 * the title sits in the lower-left quadrant so the silhouettes in
	 * the photo (keffiehs, raised fists, etc.) stay visible at the top.
	 */
	.mobilisation-block__photo {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		min-height: clamp(20rem, 36vw, 30rem);
		padding: clamp(var(--space-l), 3vw, var(--space-xl));
	}

	.mobilisation-block__title {
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin: 0;
		/* White on flag-red overlay = ~5.4:1 contrast (WCAG 2.1 AA pass). */
		color: var(--color-flag-white);
		text-transform: uppercase;
		max-width: 22ch;
	}

	/*
	 * Content block — sits BELOW the photo, on a clean paper surface.
	 * Body lede + CTA only; never overlays the photograph.
	 */
	.mobilisation-block__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
		padding: clamp(var(--space-l), 3vw, var(--space-xl));
		background: var(--color-paper);
		color: var(--color-ink);
		border-top: 1px solid var(--color-paper-edge);
	}

	.mobilisation-block__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-mega);
		text-transform: uppercase;
		color: var(--color-flag-red);
	}

	/* A short red bar before the eyebrow label, set in the brand red.
	 * Inexpensive visual anchor that does not need its own component. */
	.mobilisation-block__eyebrow-bar {
		display: inline-block;
		width: 28px;
		height: 4px;
		background: var(--color-flag-red);
	}

	.mobilisation-block__lede {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--text-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-muted);
		max-width: 56ch;
	}

	.mobilisation-block__cta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		padding: var(--space-xs) var(--space-m);
		min-height: 44px; /* WCAG 2.5.5 hit area */
		background: var(--color-flag-red);
		color: var(--color-flag-white);
		font-family: var(--font-heading);
		font-size: var(--text-base);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		text-decoration: none;
		border-radius: var(--radius-sharp);
		border: 2px solid var(--color-flag-red);
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
		align-self: flex-start;
	}

	.mobilisation-block__cta:hover,
	.mobilisation-block__cta:focus-visible {
		background: var(--color-flag-red-deep);
		border-color: var(--color-flag-red-deep);
		transform: translateY(-1px);
	}

	.mobilisation-block__cta:focus-visible {
		outline: 2px solid var(--color-ink);
		outline-offset: 3px;
	}

	.mobilisation-block__cta-arrow {
		display: inline-block;
		transition: transform var(--duration-base) var(--ease-out);
	}

	.mobilisation-block__cta:hover .mobilisation-block__cta-arrow,
	.mobilisation-block__cta:focus-visible .mobilisation-block__cta-arrow {
		transform: translateX(4px);
	}

	/* Small accent symbol — sized per DESIGN.md §5.1 (32–64 px), placed
	 * at the bottom of the content block as a quiet visual signature.
	 * Slightly heavier than an `.accent-inline` because it sits alone. */
	.mobilisation-block__symbol {
		display: block;
		margin-top: var(--space-2xs);
		width: 24px;
		height: 24px;
		object-fit: contain;
	}

	/* On mobile, the photo block stays tall enough that the title is
	 * readable; the content block sits below it. */
	@media (max-width: 40rem) {
		.mobilisation-block__photo {
			min-height: clamp(18rem, 70vw, 24rem);
			padding: var(--space-m);
		}

		.mobilisation-block__title {
			font-size: var(--text-2xl);
		}

		.mobilisation-block__content {
			padding: var(--space-m);
		}
	}

	/* Reduced motion: kill all transitions on this block. The token
	 * override in `tokens.css` already zeroes the duration vars, but
	 * we also explicitly null the transform arrow so the focus ring
	 * never "pops" into place. */
	@media (prefers-reduced-motion: reduce) {
		.mobilisation-block,
		.mobilisation-block__overlay,
		.mobilisation-block__photo,
		.mobilisation-block__content,
		.mobilisation-block__cta,
		.mobilisation-block__cta-arrow {
			transition: none;
		}
	}
</style>
