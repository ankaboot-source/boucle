---
/*
 * Header
 * ------
 * Site chrome: a sticky top bar with the wordmark, the four primary
 * navigation links, two prominent CTAs (don / boutique), and a
 * discreet social row.
 *
 * Uses the brand black surface and the flag-red hover accent from the
 * design tokens. CTA buttons reuse the existing `.btn` / `.btn--primary`
 * / `.btn--ghost` utilities (no new button styles here).
 *
 * Social URLs are mirrored from `src/components/Footer.astro` — kept
 * identical to the footer's `socialLinks` array so a change in one
 * place can be propagated to the other.
 */

// TODO(#22): confirm the `Boutique solidaire` HelloAsso URL. The
// repository only ships a `forum-palestine-libre` billetterie link
// (https://www.helloasso.com/associations/jeune-palestine/evenements/forum-palestine-libre)
// which is a different event. Replace the placeholder below once the
// product owner confirms the canonical boutique URL.

const boutiqueSolidaireHref = "https://www.helloasso.com/associations/jeune-palestine";

const navItems = [
	{ label: "Prises de parole", href: "/prises-de-parole" },
	{ label: "Collectif", href: "/collectif" },
	{ label: "Faites un don", href: "/don" },
	// `featured` opts this entry into the brutalist "Right to Resist"
	// visual treatment (see `.site-header__link--featured` below).
	// Kept as the 4th nav item per the existing navItems[3] contract
	// documented in DESIGN.md and the issue #31 brief.
	{ label: "Right to Resist", href: "/right-to-resist", featured: true },
];

const ctaItems = [
	{ label: "Faire un don", href: "/don", variant: "primary" as const },
	{
		label: "Boutique solidaire",
		href: boutiqueSolidaireHref,
		variant: "ghost" as const,
		external: true,
	},
];

// Keep in sync with `socialLinks` in src/components/Footer.astro.
const socialLinks = [
	{
		label: "Instagram",
		href: "https://instagram.com/urgencepalestine",
	},
	{ label: "TikTok", href: "https://tiktok.com/@urgencepalestine" },
	{ label: "Telegram", href: "https://t.me/urgencepalestine" },
	{ label: "Facebook", href: "https://facebook.com/urgencepalestine" },
];
---

<header class="site-header" data-site-header>
	<div class="site-header__inner container">
		<a
			href="/"
			class="site-header__wordmark"
			aria-label="Urgence Palestine — Accueil"
		>
			<span class="site-header__title">Urgence Palestine</span>
		</a>

		<nav class="site-header__nav" aria-label="Navigation principale">
			<ul class="site-header__list">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								class:list={[
									"site-header__link",
									item.featured && "site-header__link--featured",
								]}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<ul class="site-header__cta">
			{
				ctaItems.map((cta) => (
					<li>
						<a
							href={cta.href}
							class:list={[
								"btn",
								cta.variant === "primary"
									? "btn--primary"
									: "btn--ghost",
							]}
							{...(cta.external
								? {
									target: "_blank",
									rel: "noopener",
								}
								: {})}
						>
							{cta.label}
						</a>
					</li>
				))
			}
		</ul>

		<ul class="site-header__social" aria-label="Réseaux sociaux">
			<li>
				<a
					href="https://instagram.com/urgencepalestine"
					class="site-header__social-link"
					target="_blank"
					rel="noopener"
					aria-label="Instagram — ouvre dans un nouvel onglet"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="20"
						height="20"
						aria-hidden="true"
						focusable="false"
					>
						<title>Instagram</title>
						<path
							fill="currentColor"
							d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zM12 7.4a4.6 4.6 0 1 1 0 9.2 4.6 4.6 0 0 1 0-9.2zm0 7.6a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm5.9-7.8a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0z"
						></path>
					</svg>
				</a>
			</li>
			<li>
				<a
					href="https://tiktok.com/@urgencepalestine"
					class="site-header__social-link"
					target="_blank"
					rel="noopener"
					aria-label="TikTok — ouvre dans un nouvel onglet"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="20"
						height="20"
						aria-hidden="true"
						focusable="false"
					>
						<title>TikTok</title>
						<path
							fill="currentColor"
							d="M19.6 6.3a4.8 4.8 0 0 1-3.4-1.4 4.8 4.8 0 0 1-1.4-3.2h-3.4v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V8.2a5.7 5.7 0 0 0-.8-.1 6 6 0 1 0 6 6V8.5a8.2 8.2 0 0 0 4.8 1.5V6.6c0-.1-.1-.2 0-.3z"
						></path>
					</svg>
				</a>
			</li>
			<li>
				<a
					href="https://t.me/urgencepalestine"
					class="site-header__social-link"
					target="_blank"
					rel="noopener"
					aria-label="Telegram — ouvre dans un nouvel onglet"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="20"
						height="20"
						aria-hidden="true"
						focusable="false"
					>
						<title>Telegram</title>
						<path
							fill="currentColor"
							d="M21.7 4.1 2.5 11.6c-1.2.5-1.2 1.2-.2 1.5l4.9 1.5 11.4-7.2c.5-.3 1-.2.6.3l-9.2 8.3-.4 4.1c.5 0 .7-.2 1-.5l2.4-2.3 5 3.7c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.8-1.1-1.5z"
						></path>
					</svg>
				</a>
			</li>
			<li>
				<a
					href="https://facebook.com/urgencepalestine"
					class="site-header__social-link"
					target="_blank"
					rel="noopener"
					aria-label="Facebook — ouvre dans un nouvel onglet"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="20"
						height="20"
						aria-hidden="true"
						focusable="false"
					>
						<title>Facebook</title>
						<path
							fill="currentColor"
							d="M13.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.9.2-1.5 1.5-1.5h1.6V4.3a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"
						></path>
					</svg>
				</a>
			</li>
		</ul>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--color-flag-black);
		color: var(--color-ink-on-dark);
		border-bottom: 1px solid oklch(28% 0 0);
		/* Dry transition: dry, fast, no ease-in-out lissage.
		 * Durations are taken from tokens.css so prefers-reduced-motion
		 * collapses them to 0ms automatically (see tokens.css). */
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out);
	}

	/* Scrolled state — the header shifts to the flag-red (rouge sang) accent
	 * and compresses its inner block. The compressed height uses steps() so
	 * the collapse snaps rather than gliding, in line with the brutalist
	 * charter (DESIGN.md §3). */
	.site-header.is-scrolled {
		background: var(--color-flag-red);
		border-bottom-color: var(--color-flag-black);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-s);
		min-height: 64px;
		padding-block: var(--space-xs);
		transition: min-height var(--duration-base) steps(3, end);
	}

	.site-header.is-scrolled .site-header__inner {
		min-height: 44px;
		padding-block: var(--space-2xs);
		transition: min-height var(--duration-fast) steps(2, end);
	}

	.site-header__wordmark {
		display: inline-flex;
		align-items: center;
		color: var(--color-ink-on-dark);
		text-decoration: none;
		transition: color var(--duration-base) var(--ease-out);
	}

	.site-header__wordmark:hover {
		color: var(--color-flag-red);
	}

	/* On the scrolled (red) surface, the red hover/focus accent would be
	 * invisible — invert to the deep-red and add an underline so the hover
	 * signal stays readable. Focus stays on red because the surface itself
	 * is red, so red still reads against the white link text. */
	.site-header.is-scrolled .site-header__wordmark:hover,
	.site-header.is-scrolled .site-header__link:hover {
		color: var(--color-flag-red-deep);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.site-header__title {
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		text-transform: uppercase;
	}

	.site-header__nav {
		display: flex;
	}

	.site-header__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-2xs) var(--space-s);
	}

	.site-header__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--space-2xs);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-ink-on-dark);
		text-decoration: none;
		letter-spacing: 0.01em;
		transition: color var(--duration-base) var(--ease-out);
	}

	.site-header__link:hover {
		color: var(--color-flag-red);
	}

	/*
	 * "Right to Resist" (navItems[3]) — brutalist signature treatment.
	 * Distinguishes the campaign-marked entry from the three standard
	 * links via three token-driven gestures:
	 *   1. heading-family display (instead of body) with bold weight
	 *   2. uppercase + wide tracking (the brutalist militant stamp)
	 *   3. a 2px flag-red underline that snaps in on hover/focus
	 * The treatment is reversible: removing the `featured` flag from
	 * `navItems` reverts this entry to the standard link style.
	 */
	.site-header__link--featured {
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		padding: 0 var(--space-xs);
		border-left: 1px solid oklch(28% 0 0);
		color: var(--color-flag-red);
	}

	.site-header__link--featured:hover,
	.site-header__link--featured:focus-visible {
		color: var(--color-flag-white);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
		text-decoration-color: var(--color-flag-red);
	}

	/* On the scrolled (red) surface, the flag-red featured text would
	 * vanish into the background. Invert to white, and keep the red
	 * underline as the only red accent. */
	.site-header.is-scrolled .site-header__link--featured {
		color: var(--color-flag-white);
		border-left-color: var(--color-flag-red-deep);
	}

	.site-header.is-scrolled .site-header__link--featured:hover,
	.site-header.is-scrolled .site-header__link--featured:focus-visible {
		color: var(--color-flag-white);
		text-decoration-color: var(--color-flag-white);
	}

	/* ----- CTA group ----- */

	.site-header__cta {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2xs);
	}

	.site-header__cta .btn {
		min-height: 36px;
		padding: 0 var(--space-s);
		font-size: var(--text-sm);
	}

	/* ----- Social row ----- */

	.site-header__social {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2xs);
	}

	.site-header__social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		padding: 4px;
		color: var(--color-ink-on-dark);
		opacity: 0.7;
		text-decoration: none;
		border-radius: var(--radius-sharp);
		transition:
			opacity var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out);
	}

	.site-header__social-link svg {
		display: block;
		width: 20px;
		height: 20px;
	}

	.site-header__social-link:hover,
	.site-header__social-link:focus-visible {
		opacity: 1;
		color: var(--color-flag-red);
	}

	/* On the scrolled (red) surface, swap social-link hover/focus to the
	 * deep-red so the icon still has a visible accent shift. */
	.site-header.is-scrolled .site-header__social-link:hover,
	.site-header.is-scrolled .site-header__social-link:focus-visible {
		color: var(--color-flag-red-deep);
	}

	/* On the scrolled (red) surface, the .btn--primary (red bg) and
	 * .btn--ghost (red text) would be invisible. Swap the CTAs to a black
	 * on-white inversion that reads cleanly against the rouge sang. The
	 * flag-red -> black inversion is itself a brutalist gesture. */
	.site-header.is-scrolled .site-header__cta .btn--primary {
		background: var(--color-flag-black);
		color: var(--color-flag-white);
	}

	.site-header.is-scrolled .site-header__cta .btn--primary:hover {
		background: var(--color-ink-soft);
	}

	.site-header.is-scrolled .site-header__cta .btn--ghost {
		background: transparent;
		color: var(--color-flag-white);
		border-color: var(--color-flag-white);
	}

	.site-header.is-scrolled .site-header__cta .btn--ghost:hover {
		background: var(--color-flag-white);
		color: var(--color-flag-black);
	}

	/* WCAG 2.1 AA focus outline. Uses flag-red on the black surface, and
	 * switches to deep-red on the scrolled (red) surface so the outline
	 * stays visible against the shifted background. */
	.site-header__link:focus-visible,
	.site-header__wordmark:focus-visible,
	.site-header__cta .btn:focus-visible,
	.site-header__social-link:focus-visible {
		outline: 2px solid var(--color-flag-red);
		outline-offset: 2px;
	}

	.site-header.is-scrolled .site-header__link:focus-visible,
	.site-header.is-scrolled .site-header__wordmark:focus-visible,
	.site-header.is-scrolled .site-header__cta .btn:focus-visible,
	.site-header.is-scrolled .site-header__social-link:focus-visible {
		outline-color: var(--color-flag-red-deep);
	}

	@media (max-width: 40rem) {
		.site-header__inner {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-2xs);
			padding-block: var(--space-xs) var(--space-s);
		}

		.site-header__list {
			justify-content: flex-start;
		}

		.site-header__cta,
		.site-header__social {
			justify-content: flex-start;
		}
	}
</style>

<script>
	/*
	 * Scroll-triggered brutalist transformation.
	 * ------------------------------------------
	 * Once the user has scrolled past `SCROLL_THRESHOLD` px, the header
	 * receives an `is-scrolled` class that:
	 *   - shifts the surface to the flag-red (rouge sang) accent,
	 *   - snaps to a compressed height (no soft glide),
	 *   - tightens the bottom border to a deeper, dryer line.
	 *
	 * Motion is kept dry (no `ease-in-out`), and uses ONLY the duration
	 * tokens exposed in `tokens.css` (`--duration-fast` / `--duration-base`
	 * / `--duration-slow`). When the user prefers reduced motion, we do not
	 * attach the listener at all — the header stays in its static state.
	 */
	const SCROLL_THRESHOLD = 64;

	function initHeaderScroll() {
		const header = document.querySelector<HTMLElement>("[data-site-header]");
		if (!header) return;

		const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
		if (motionQuery.matches) return;

		const apply = () => {
			header.classList.toggle("is-scrolled", window.scrollY > SCROLL_THRESHOLD);
		};

		apply();
		window.addEventListener("scroll", apply, { passive: true });
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHeaderScroll);
	} else {
		initHeaderScroll();
	}
</script>
