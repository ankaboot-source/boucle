---
/*
 * Header
 * ------
 * Site chrome: a sticky top bar with the wordmark, the four primary
 * navigation links, two prominent CTAs (don / boutique), and a
 * discreet social row.
 *
 * Uses the brand black surface and the flag-red hover accent from the
 * design tokens. CTA buttons reuse the existing `.btn` / `.btn--primary`
 * / `.btn--ghost` utilities (no new button styles here).
 *
 * Social URLs are imported from `src/data/social-links.ts` so a change
 * in one place propagates to every consumer.
 */
import { socialLinks } from "../data/social-links.ts";

// TODO(#22): confirm the `Boutique solidaire` HelloAsso URL. The
// repository only ships a `forum-palestine-libre` billetterie link
// (https://www.helloasso.com/associations/jeune-palestine/evenements/forum-palestine-libre)
// which is a different event. Replace the placeholder below once the
// product owner confirms the canonical boutique URL.

const boutiqueSolidaireHref = "https://www.helloasso.com/associations/jeune-palestine";

const navItems = [
	{ label: "Prises de parole", href: "/prises-de-parole" },
	{ label: "Collectif", href: "/collectif" },
	{ label: "Faites un don", href: "/don" },
	// `featured` opts this entry into the brutalist "Right to Resist"
	// visual treatment (see `.site-header__link--featured` below).
	// Kept as the 4th nav item per the existing navItems[3] contract
	// documented in DESIGN.md and the issue #31 brief.
	{ label: "Right to Resist", href: "/right-to-resist", featured: true },
];

const ctaItems = [
	{ label: "Faire un don", href: "/don", variant: "primary" as const },
	{
		label: "Boutique solidaire",
		href: boutiqueSolidaireHref,
		variant: "ghost" as const,
		external: true,
	},
];

// Imported from src/data/social-links.ts.
---

<header class="site-header" data-site-header>
	<div class="site-header__inner container">
		<a
			href="/"
			class="site-header__wordmark"
			aria-label="Urgence Palestine — Accueil"
		>
			{/*
			  * Two logos live in the markup at all times; CSS hides the
			  * inactive one. The square is the default (extended header,
			  * two-line layout); the rectangle takes over once the
			  * header has been compressed by the scroll listener. The
			  * aria-label above provides the accessible name so the
			  * decorative alt="" is intentional on both.
			  */}
			<img
				class="site-header__logo site-header__logo--square"
				src="/logos/logo-up-carre.png"
				width="900"
				height="900"
				alt=""
				decoding="async"
			/>
			<img
				class="site-header__logo site-header__logo--rectangle"
				src="/logos/logo-up-rectangle-fond-transparent.png"
				width="900"
				height="400"
				alt=""
				decoding="async"
			/>
		</a>

		<nav class="site-header__nav" aria-label="Navigation principale">
			<ul class="site-header__list">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								class:list={[
									"site-header__link",
									item.featured && "site-header__link--featured",
								]}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<ul class="site-header__cta">
			{
				ctaItems.map((cta) => (
					<li>
						<a
							href={cta.href}
							class:list={[
								"btn",
								cta.variant === "primary"
									? "btn--primary"
									: "btn--ghost",
							]}
							{...(cta.external
								? {
									target: "_blank",
									rel: "noopener",
								}
								: {})}
						>
							{cta.label}
						</a>
					</li>
				))
			}
		</ul>

		<ul class="site-header__social" aria-label="Réseaux sociaux">
			{
				socialLinks.map((link) => (
					<li>
						<a
							href={link.href}
							class="site-header__social-link"
							target="_blank"
							rel="noopener"
							aria-label={`${link.label} — ouvre dans un nouvel onglet`}
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								width="20"
								height="20"
								aria-hidden="true"
								focusable="false"
							>
								<title>{link.label}</title>
								<path fill="currentColor" d={link.icon} />
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--color-flag-black);
		color: var(--color-ink-on-dark);
		border-bottom: 1px solid oklch(28% 0 0);
		/* Dry transition: dry, fast, no ease-in-out lissage.
		 * Durations are taken from tokens.css so prefers-reduced-motion
		 * collapses them to 0ms automatically (see tokens.css). */
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out);
	}

	/* Scrolled state — the header shifts to the flag-red (rouge sang) accent
	 * and compresses its inner block. The compressed height uses steps() so
	 * the collapse snaps rather than gliding, in line with the brutalist
	 * charter (DESIGN.md §3). */
	.site-header.is-scrolled {
		background: var(--color-flag-red);
		border-bottom-color: var(--color-flag-black);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-s);
		/* The extended layout has the square logo on its own row above
		 * the nav + CTAs + social row; 168px is enough headroom for a
		 * 120px square plus both rows of padding. The scrolled layout
		 * snaps back to a single, much shorter row (see below). */
		min-height: 168px;
		padding-block: var(--space-xs);
		transition: min-height var(--duration-base) steps(3, end);
	}

	.site-header.is-scrolled .site-header__inner {
		min-height: 44px;
		padding-block: var(--space-2xs);
		transition: min-height var(--duration-fast) steps(2, end);
	}

	.site-header__wordmark {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-basis: 100%;
		/* Negative offset compensates for the small inline gap that
		 * flex-wrap leaves around wrapped items, so the square's own
		 * row sits flush with the rest of the header padding. */
		margin-bottom: calc(-1 * var(--space-2xs));
		color: var(--color-ink-on-dark);
		text-decoration: none;
		transition: color var(--duration-base) var(--ease-out);
	}

	/* Scrolled state: the wordmark collapses to the natural size of the
	 * rectangle and rejoins the single row. */
	.site-header.is-scrolled .site-header__wordmark {
		flex-basis: auto;
		margin-bottom: 0;
	}

	.site-header__wordmark:hover {
		color: var(--color-flag-red);
	}

	/* On the scrolled (red) surface, the red hover/focus accent would be
	 * invisible — invert to the deep-red and add an underline so the hover
	 * signal stays readable. Focus stays on red because the surface itself
	 * is red, so red still reads against the white link text. */
	.site-header.is-scrolled .site-header__wordmark:hover,
	.site-header.is-scrolled .site-header__link:hover {
		color: var(--color-flag-red-deep);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	/*
	 * Wordmark — two logos, one anchor.
	 * --------------------------------
	 * The square (900×900) is the extended-state wordmark: it spans its
	 * own row inside the inner flex container, sitting on top of the nav
	 * + CTAs + social row. The rectangle (900×400) replaces it once the
	 * header collapses; it tucks back into the same row as the nav.
	 *
	 * Only one logo is rendered visible at a time — the other is `display:
	 * none` so it does not occupy a slot in the flex row. The hidden
	 * image is still fetched by the browser (it's a small, local PNG);
	 * the swap on scroll is then instantaneous.
	 *
	 * Native `width`/`height` attributes on the <img> tags above let
	 * the browser reserve the layout box before the image loads — no
	 * CLS.
	 */
	.site-header__logo {
		display: block;
	}

	/* Extended state: square on its own row, centered. The anchor
	 * expands to 100% of the row so the image can sit centered without
	 * bleeding into the nav row. The square is rendered at ~120px tall
	 * to read as a brand block without dominating the page. */
	.site-header__logo--square {
		width: 120px;
		height: 120px;
	}

	.site-header__logo--rectangle {
		display: none;
		width: 120px;
		height: auto;
		aspect-ratio: 900 / 400;
	}

	/* Scrolled state: rectangle joins the single row, square is hidden. */
	.site-header.is-scrolled .site-header__logo--square {
		display: none;
	}

	.site-header.is-scrolled .site-header__logo--rectangle {
		display: block;
		/* In the compressed row, the rectangle sits at 32px tall — the
		 * aspect-ratio declaration above keeps it proportional. */
		height: 32px;
	}

	.site-header__nav {
		display: flex;
	}

	.site-header__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-2xs) var(--space-s);
	}

	.site-header__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--space-2xs);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-ink-on-dark);
		text-decoration: none;
		letter-spacing: 0.01em;
		transition: color var(--duration-base) var(--ease-out);
	}

	.site-header__link:hover {
		color: var(--color-flag-red);
	}

	/*
	 * "Right to Resist" (navItems[3]) — brutalist signature treatment.
	 * Distinguishes the campaign-marked entry from the three standard
	 * links via four token-driven gestures:
	 *   1. heading-family display (instead of body) with bold weight
	 *   2. uppercase + wide tracking (the brutalist militant stamp)
	 *   3. a rough marker-stroke highlight behind the text on hover/focus
	 *   4. a white-on-black / red-on-white / red-on-white contrast logic
	 *      for the three possible header surfaces (default, light, scrolled)
	 *
	 * The highlight is implemented with a generated ::after pseudo-element
	 * using a double-layer linear-gradient plus a slight rotation. It does
	 * NOT use text-decoration: underline, and it must vanish when the hover
	 * or focus state ends. Surface-specific colours are controlled through
	 * the two CSS variables below.
	 *
	 * The treatment is reversible: removing the `featured` flag from
	 * `navItems` reverts this entry to the standard link style.
	 */
	.site-header__link--featured {
		--featured-highlight-bg: var(--color-flag-white);
		--featured-text-on-highlight: var(--color-flag-red);

		position: relative;
		z-index: 0;
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		padding: 0 var(--space-xs);
		border-left: 1px solid oklch(28% 0 0);
		color: var(--color-flag-red);
	}

	/* Rough marker-stroke highlight behind the text.
	 * Two stacked gradients (104deg and 183deg) create a washed, dry-brush
	 * texture with deliberately hard edges and a slight rotation.
	 * The pseudo-element is clipped to zero width by default and revealed on
	 * hover/focus via a clip-path transition; when the interaction ends the
	 * clip-path reverts and the highlight disappears. */
	.site-header__link--featured::after {
		content: "";
		position: absolute;
		left: -2px;
		right: -2px;
		bottom: 2px;
		height: 70%;
		z-index: -1;
		pointer-events: none;
		background:
			linear-gradient(
				104deg,
				color-mix(in oklch, var(--featured-highlight-bg), transparent 100%) 0.9%,
				color-mix(in oklch, var(--featured-highlight-bg), transparent 10%) 2.4%,
				color-mix(in oklch, var(--featured-highlight-bg), transparent 25%) 5.8%,
				color-mix(in oklch, var(--featured-highlight-bg), transparent 55%) 93%,
				color-mix(in oklch, var(--featured-highlight-bg), transparent 15%) 96%,
				color-mix(in oklch, var(--featured-highlight-bg), transparent 100%) 98%
			),
			linear-gradient(
				183deg,
				color-mix(in oklch, var(--featured-highlight-bg), transparent 100%) 0%,
				color-mix(in oklch, var(--featured-highlight-bg), transparent 35%) 7.9%,
				color-mix(in oklch, var(--featured-highlight-bg), transparent 100%) 15%
			);
		transform: rotate(-1deg);
		clip-path: inset(0 100% 0 0);
		transition: clip-path var(--duration-base) var(--ease-out);
	}

	.site-header__link--featured:hover,
	.site-header__link--featured:focus-visible {
		color: var(--featured-text-on-highlight);
		text-decoration: none;
	}

	.site-header__link--featured:hover::after,
	.site-header__link--featured:focus-visible::after {
		clip-path: inset(0 0 0 0);
	}

	/* On the scrolled (red) surface, the flag-red featured text would
	 * vanish into the background. Invert to white text and flip the hover
	 * text to red over the still-white highlight, keeping the contrast
	 * above 4.5:1 for small text (white-on-red at this font size is below
	 * AA, so we deliberately abandoned that combination). */
	.site-header.is-scrolled .site-header__link--featured {
		color: var(--color-flag-white);
		border-left-color: var(--color-flag-red-deep);
	}

	.site-header.is-scrolled .site-header__link--featured:hover,
	.site-header.is-scrolled .site-header__link--featured:focus-visible {
		color: var(--color-flag-red);
	}

	/* Future light-header surface: the highlight inverts to red and the
	 * hover/focus text becomes white. */
	.site-header--light .site-header__link--featured,
	.is-light .site-header__link--featured {
		--featured-highlight-bg: var(--color-flag-red);
		--featured-text-on-highlight: var(--color-flag-white);
		color: var(--color-flag-red);
	}

	.site-header--light .site-header__link--featured:hover,
	.site-header--light .site-header__link--featured:focus-visible,
	.is-light .site-header__link--featured:hover,
	.is-light .site-header__link--featured:focus-visible {
		color: var(--color-flag-white);
	}

	/* Motion must not leak for users who prefer reduced motion. The
	 * highlight simply stays hidden; the link still changes colour via
	 * the inherited instant colour transition. */
	@media (prefers-reduced-motion: reduce) {
		.site-header__link--featured::after {
			transition: none;
			clip-path: inset(0 100% 0 0);
		}
	}

	/* ----- CTA group ----- */

	.site-header__cta {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2xs);
	}

	.site-header__cta .btn {
		min-height: 36px;
		padding: 0 var(--space-s);
		font-size: var(--text-sm);
	}

	/* ----- Social row ----- */

	.site-header__social {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2xs);
	}

	.site-header__social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		padding: 4px;
		color: var(--color-ink-on-dark);
		opacity: 0.7;
		text-decoration: none;
		border-radius: var(--radius-sharp);
		transition:
			opacity var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out);
	}

	.site-header__social-link svg {
		display: block;
		width: 20px;
		height: 20px;
	}

	.site-header__social-link:hover,
	.site-header__social-link:focus-visible {
		opacity: 1;
		color: var(--color-flag-red);
	}

	/* On the scrolled (red) surface, swap social-link hover/focus to the
	 * deep-red so the icon still has a visible accent shift. */
	.site-header.is-scrolled .site-header__social-link:hover,
	.site-header.is-scrolled .site-header__social-link:focus-visible {
		color: var(--color-flag-red-deep);
	}

	/* On the scrolled (red) surface, the .btn--primary (red bg) and
	 * .btn--ghost (red text) would be invisible. Swap the CTAs to a black
	 * on-white inversion that reads cleanly against the rouge sang. The
	 * flag-red -> black inversion is itself a brutalist gesture. */
	.site-header.is-scrolled .site-header__cta .btn--primary {
		background: var(--color-flag-black);
		color: var(--color-flag-white);
	}

	.site-header.is-scrolled .site-header__cta .btn--primary:hover {
		background: var(--color-ink-soft);
	}

	.site-header.is-scrolled .site-header__cta .btn--ghost {
		background: transparent;
		color: var(--color-flag-white);
		border-color: var(--color-flag-white);
	}

	.site-header.is-scrolled .site-header__cta .btn--ghost:hover {
		background: var(--color-flag-white);
		color: var(--color-flag-black);
	}

	/* WCAG 2.1 AA focus outline. Uses flag-red on the black surface, and
	 * switches to deep-red on the scrolled (red) surface so the outline
	 * stays visible against the shifted background. */
	.site-header__link:focus-visible,
	.site-header__wordmark:focus-visible,
	.site-header__cta .btn:focus-visible,
	.site-header__social-link:focus-visible {
		outline: 2px solid var(--color-flag-red);
		outline-offset: 2px;
	}

	.site-header.is-scrolled .site-header__link:focus-visible,
	.site-header.is-scrolled .site-header__wordmark:focus-visible,
	.site-header.is-scrolled .site-header__cta .btn:focus-visible,
	.site-header.is-scrolled .site-header__social-link:focus-visible {
		outline-color: var(--color-flag-red-deep);
	}

	@media (max-width: 40rem) {
		.site-header__inner {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-2xs);
			padding-block: var(--space-xs) var(--space-s);
			/* Tighter min-height on small screens — the 120px square still
			 * fits, but the social row no longer pushes the header taller
			 * than necessary. */
			min-height: 152px;
		}

		.site-header__list {
			justify-content: flex-start;
		}

		.site-header__cta,
		.site-header__social {
			justify-content: flex-start;
		}

		/* On the scrolled state, the rectangle reverts the wordmark to
		 * its natural size and lets it sit inline with the nav row,
		 * rather than as a wrapped column item. */
		.site-header.is-scrolled .site-header__wordmark {
			flex-basis: auto;
			margin-bottom: 0;
		}

		.site-header.is-scrolled .site-header__inner {
			min-height: 44px;
		}
	}
</style>

<script>
	/*
	 * Scroll-triggered brutalist transformation.
	 * ------------------------------------------
	 * Once the user has scrolled past `SCROLL_THRESHOLD` px, the header
	 * receives an `is-scrolled` class that:
	 *   - shifts the surface to the flag-red (rouge sang) accent,
	 *   - snaps to a compressed height (no soft glide),
	 *   - tightens the bottom border to a deeper, dryer line,
	 *   - swaps the square wordmark (extended, two-line) for the
	 *     rectangle wordmark (collapsed, single-line).
	 *
	 * Motion is kept dry (no `ease-in-out`), and uses ONLY the duration
	 * tokens exposed in `tokens.css` (`--duration-fast` / `--duration-base`
	 * / `--duration-slow`). When the user prefers reduced motion, we do
	 * not attach the listener at all — the header stays in its static
	 * (extended) state, with the square logo and two-line layout intact.
	 */
	const SCROLL_THRESHOLD = 64;

	function initHeaderScroll() {
		const header = document.querySelector<HTMLElement>("[data-site-header]");
		if (!header) return;

		const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
		if (motionQuery.matches) return;

		const apply = () => {
			header.classList.toggle("is-scrolled", window.scrollY > SCROLL_THRESHOLD);
		};

		apply();
		window.addEventListener("scroll", apply, { passive: true });
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHeaderScroll);
	} else {
		initHeaderScroll();
	}
</script>
