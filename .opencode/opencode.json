{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 5000,
    "tail_turns": 1
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 25600
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".svelte-kit/**",
      "coverage/**",
      ".git/**",
      "target/**",
      "__pycache__/**",
      ".venv/**"
    ]
  },
  "provider": {
    "ollama-cloud": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": ["codebase-memory-mcp"]
    }
  }
}