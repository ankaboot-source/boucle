{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 5000,
    "tail_turns": 1
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 25600
  },
  "provider": {
    "ollama-cloud": {
      "options": {
        "setCacheKey": true
      }
    }
  }
}