# generated types
.astro/

# dependencies
node_modules/

# astro build output (configured via outDir in astro.config.mjs)
public/

# jcode runtime db (created by the jcode CLI; not part of the repo)
.jcode-*.db
.jcode-*.db-shm
.jcode-*.db-wal

# jcode prompt overlay (written at runtime by bin/jc, never tracked —
# tracking it causes the worker to commit its own system prompt)
.jcode/prompt-overlay.md

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# boucle state files (per-issue work state, not for version control)
.boucle-state/
.wrangler/

# bats test artifacts
test/report.xml
test/.bats.*

# git worktrees (local working branches, not for version control)
.worktree/

# local planning docs (superpowers plans/specs, not for version control)
docs/superpowers/
